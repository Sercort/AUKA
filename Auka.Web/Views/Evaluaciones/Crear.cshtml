@model Auka.Application.Entities.Evaluacion

@{
    ViewData["Title"] = "Programar Evaluación";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">Programar Nueva Evaluación</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post">

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Asignatura y Curso</label>
                            <select asp-for="AsignaturaId" class="form-select" asp-items="ViewBag.Asignaturas" required>
                                <option value="">-- Seleccione Asignatura --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Título de la Evaluación</label>
                            <input asp-for="Titulo" class="form-control" placeholder="Ej: Control N°1 de Ecuaciones" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Temario / Contenido Requerido</label>
                            <textarea asp-for="Contenido" class="form-control" rows="3" placeholder="Detalla los temas que se evaluarán..." required></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Fecha y Hora de la Prueba</label>
                            <input asp-for="Fecha" type="datetime-local" class="form-control" required />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Volver al Calendario</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4">Guardar Evaluación</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
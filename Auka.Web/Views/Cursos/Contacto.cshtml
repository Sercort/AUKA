@{
    ViewData["Title"] = "Directorio y Contacto";
    var compañeros = ViewBag.Compañeros as IEnumerable<Auka.Application.Entities.Usuario>;
    var profesores = ViewBag.Profesores as IEnumerable<Auka.Application.Entities.Usuario>;
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold text-primary mb-1">📇 Directorio de Contacto del Curso</h2>
        <p class="text-muted mb-0">Consulta correos institucionales de tus docentes y compañeros.</p>
    </div>

    <!-- Sección de Profesores -->
    <h4 class="fw-bold text-dark mb-3">👨‍🏫 Mis Docentes</h4>
    <div class="row g-3 mb-4">
        @if (profesores != null)
        {
            foreach (var prof in profesores)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-body d-flex align-items-center gap-3">
                            <div class="bg-primary text-white rounded-circle p-3 fs-4">👨‍🏫</div>
                            <div>
                                <h6 class="fw-bold mb-1">@prof.Nombre @prof.Apellido</h6>
                                <a href="mailto:@prof.Email" class="small text-decoration-none">✉️ @prof.Email</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Sección de Compañeros -->
    <h4 class="fw-bold text-dark mb-3">👥 Compañeros de Curso</h4>
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Nombre Alumno</th>
                            <th>Correo Institucional</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (compañeros != null)
                        {
                            foreach (var comp in compañeros)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">👤 @comp.Nombre @comp.Apellido</td>
                                    <td><a href="mailto:@comp.Email" class="text-decoration-none">✉️ @comp.Email</a></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
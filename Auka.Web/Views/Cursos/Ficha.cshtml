@* Auka.Web/Views/Cursos/Ficha.cshtml — ficha del alumno/a: todo en una página, cada bloque lleva a su detalle *@
@using Auka.Application.Entities
@using Auka.Web.Controllers
@model Estudiante
@{
    var u = Model.Usuario!;
    ViewData["Title"] = $"{u.Nombre} {u.Apellido}";
    int asisP = ViewBag.AsisP ?? 0, asisT = ViewBag.AsisT ?? 0;
    var anot = ViewBag.Anotaciones as List<Anotacion> ?? new();
    var clubes = ViewBag.Clubes as List<OpcionVm> ?? new();
    var historial = ViewBag.Historial as List<MatriculaAnual> ?? new();
    var puedeClave = ViewBag.PuedeClave == true;
    var pos = anot.Count(a => a.Tipo == TipoAnotacion.Positiva);
    var neg = anot.Count(a => a.Tipo == TipoAnotacion.Negativa);
    var pctAsis = asisT == 0 ? (int?)null : (int)Math.Round(asisP * 100.0 / asisT);
    var docs = (Model.DocumentosPendientes ?? "").Split('|', StringSplitOptions.RemoveEmptyEntries);
    var curso = Model.Curso != null ? $"{Model.Curso.Nombre} {Model.Curso.Letra}".Trim() : "Sin curso";
    var ini = (u.Nombre.Length > 0 ? u.Nombre[..1] : "") + (u.Apellido.Length > 0 ? u.Apellido[..1] : "");
    bool Interno(string? c) => string.IsNullOrEmpty(c) || c.EndsWith("auka.cl", StringComparison.OrdinalIgnoreCase);
    int? edad = Model.FechaNacimiento == null ? null : (int)((DateTime.Today - Model.FechaNacimiento.Value.ToDateTime(TimeOnly.MinValue)).TotalDays / 365.25);
}
<style>
    .fi-top { display: flex; gap: 1.2rem; align-items: center; flex-wrap: wrap; }
    .fi-av { width: 84px; height: 84px; border-radius: 26px; background: rgba(255,255,255,.22); display: grid; place-items: center; font-size: 2rem; font-weight: 900; color: #fff; box-shadow: inset 0 0 0 2px rgba(255,255,255,.35); position: relative; z-index: 1; }
    .fi-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 16px; }
    .fi-kpi { padding: 14px 18px; text-decoration: none; color: var(--a-ink); transition: transform .2s, box-shadow .2s; display: block; }
    .fi-kpi:hover { transform: translateY(-2px); box-shadow: var(--a-sombra-hover); color: var(--a-ink); }
    .fi-kpi small { display: block; font-size: .7rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; color: var(--a-mut); }
    .fi-kpi b { font-size: 1.5rem; font-weight: 900; }
    .fi-kpi span { display: block; font-size: .78rem; color: var(--a-blue); font-weight: 800; margin-top: .2rem; }
    .fi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .fi-sec { padding: 18px 20px; }
    .fi-sec h3 { font-size: 1rem; font-weight: 900; color: var(--a-navy); margin: 0 0 .8rem; display: flex; align-items: center; gap: .5rem; }
    .fi-sec h3 a { margin-left: auto; font-size: .8rem; font-weight: 800; text-decoration: none; }
    .fi-dato { display: flex; justify-content: space-between; gap: 1rem; padding: .45rem 0; border-bottom: 1px solid #eef2f8; font-size: .9rem; }
    .fi-dato:last-child { border-bottom: 0; }
    .fi-dato span:first-child { color: var(--a-mut); }
    .fi-dato span:last-child { font-weight: 700; text-align: right; }
    .fi-apo { padding: .7rem .8rem; border-radius: 14px; background: #f6f9fd; margin-bottom: 8px; display: flex; gap: .8rem; align-items: center; flex-wrap: wrap; }
    .fi-apo .d { flex: 1; min-width: 160px; }
    .fi-apo small { color: var(--a-mut); }
    .fi-an { display: flex; gap: .6rem; padding: .55rem 0; border-bottom: 1px solid #eef2f8; font-size: .88rem; }
    .fi-an:last-child { border-bottom: 0; }
    .fi-an small { color: var(--a-mut); white-space: nowrap; }
    .fi-hist { display: flex; gap: .5rem; flex-wrap: wrap; }
    .fi-hist a { text-decoration: none; }
    @@media (max-width: 900px) { .fi-grid { grid-template-columns: 1fr; } .fi-kpis { grid-template-columns: repeat(2, 1fr); } }
</style>

@if (TempData["ClaveProvisoria"] != null)
{
    <div class="alert alert-warning mb-3" style="font-size:1.02rem">🔑 <b>@TempData["ClaveProvisoria"]</b><br /><small>Anótala o entrégala impresa ahora: no se volverá a mostrar.</small></div>
}

<div class="au-head">
    <div class="fi-av">@ini.ToUpper()</div>
    <div class="txt">
        <h2>@u.Nombre @u.Apellido</h2>
        <p>@(curso + " · RUT " + u.Rut + (edad != null ? $" · {edad} años" : ""))</p>
    </div>
    <div class="acc">
        @if (Model.Curso != null)
        {
            <a href="/Cursos/Alumnos/@Model.CursoId">Volver al curso</a>
            <a href="/Horarios/Curso/@Model.CursoId">🗓️ Horario</a>
        }
        <a href="/Anotaciones?estudianteId=@Model.Id" class="blanco">📒 Hoja de vida</a>
    </div>
</div>

<div class="fi-kpis">
    <a class="au-card fi-kpi" href="/Cursos/Alumnos/@Model.CursoId">
        <small>Asistencia @(Model.Curso?.AnioAcademico)</small>
        <b style="color:@(pctAsis == null ? "var(--a-mut)" : pctAsis < 85 ? "#a12d2a" : "#12744a")">@(pctAsis == null ? "—" : pctAsis + "%")</b>
        <span>@(asisT == 0 ? "Aún sin registros" : $"{asisP} de {asisT} clases")</span>
    </a>
    <a class="au-card fi-kpi" href="/Anotaciones?estudianteId=@Model.Id"><small>Positivas del año</small><b style="color:#12744a">👍 @pos</b><span>Ver hoja de vida</span></a>
    <a class="au-card fi-kpi" href="/Anotaciones?estudianteId=@Model.Id"><small>Negativas del año</small><b style="color:#a12d2a">⚠️ @neg</b><span>Ver hoja de vida</span></a>
    <a class="au-card fi-kpi" href="/Talleres"><small>Clubes</small><b>🌟 @clubes.Count</b><span>@(clubes.Count == 0 ? "Ver clubes del colegio" : string.Join(", ", clubes.Select(c => c.Nombre)))</span></a>
</div>

<div class="fi-grid">
    <!-- Datos -->
    <div class="au-card fi-sec">
        <h3>👤 Datos del alumno/a</h3>
        <div class="fi-dato"><span>RUT</span><span>@u.Rut</span></div>
        <div class="fi-dato"><span>Curso</span><span>@curso</span></div>
        @if (Model.Curso?.ProfesorJefe != null)
        {
            <div class="fi-dato"><span>Profesor/a jefe</span><span>@Model.Curso.ProfesorJefe.Nombre @Model.Curso.ProfesorJefe.Apellido</span></div>
        }
        <div class="fi-dato"><span>Ingresa a AUKA con</span><span>@(Interno(u.Email) ? "su RUT" : u.Email)</span></div>
        <div class="fi-dato"><span>Acceso</span><span>@(Model.AccesoPropio ? "Usa AUKA con su cuenta" : "Lo acompaña su apoderado/a")</span></div>
        @if (Model.FechaNacimiento != null)
        {
            <div class="fi-dato"><span>Fecha de nacimiento</span><span>@Model.FechaNacimiento.Value.ToString("dd-MM-yyyy")</span></div>
        }
        @if (!string.IsNullOrEmpty(Model.Direccion))
        {
            <div class="fi-dato"><span>Dirección</span><span>@Model.Direccion</span></div>
        }
        @if (!string.IsNullOrEmpty(Model.Telefono))
        {
            <div class="fi-dato"><span>Teléfono</span><span><a href="tel:@Model.Telefono">@Model.Telefono</a></span></div>
        }
        @if (puedeClave && Model.AccesoPropio)
        {
            <form asp-action="ClaveProvisoria" method="post" class="mt-3" data-c="¿Generar una clave provisoria para @u.Nombre? La clave anterior dejará de funcionar." onsubmit="return confirm(this.dataset.c);">
                @Html.AntiForgeryToken()
                <input type="hidden" name="estudianteId" value="@Model.Id" />
                <input type="hidden" name="usuarioId" value="@u.Id" />
                <button class="btn btn-outline-warning btn-sm px-3">🔑 Clave provisoria del alumno/a</button>
            </form>
        }
    </div>

    <!-- Apoderados -->
    <div class="au-card fi-sec">
        <h3>👨‍👩‍👧 Apoderados/as</h3>
        @if (!Model.Apoderados.Any(a => a.Apoderado?.Usuario != null))
        {
            <p class="text-muted mb-0">Sin apoderado/a registrado.</p>
        }
        @foreach (var a in Model.Apoderados.Where(a => a.Apoderado?.Usuario != null).OrderByDescending(a => a.EsSostenedorPrincipal))
        {
            var au = a.Apoderado!.Usuario!;
            <div class="fi-apo">
                <div class="d">
                    <b>@au.Nombre @au.Apellido</b> @if (a.EsSostenedorPrincipal) { <span class="au-chip ms-1">Titular</span> }
                    <br /><small>@a.Parentesco · @au.Rut</small>
                    <br /><small>
                        @if (!string.IsNullOrEmpty(a.Apoderado.TelefonoContacto)) { <a href="tel:@a.Apoderado.TelefonoContacto">📞 @a.Apoderado.TelefonoContacto</a> }
                        @if (!Interno(au.Email)) { <a href="mailto:@au.Email" class="ms-2">✉️ @au.Email</a> }
                    </small>
                </div>
                @if (puedeClave)
                {
                    <form asp-action="ClaveProvisoria" method="post" class="m-0" data-c="¿Generar una clave provisoria para @au.Nombre? La clave anterior dejará de funcionar." onsubmit="return confirm(this.dataset.c);">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="estudianteId" value="@Model.Id" />
                        <input type="hidden" name="usuarioId" value="@au.Id" />
                        <button class="btn btn-outline-warning btn-sm px-3">🔑 Clave provisoria</button>
                    </form>
                }
            </div>
        }
    </div>

    <!-- Anotaciones -->
    <div class="au-card fi-sec">
        <h3>📒 Últimas anotaciones <a href="/Anotaciones?estudianteId=@Model.Id">Ver todas</a></h3>
        @if (anot.Count == 0)
        {
            <p class="text-muted mb-0">Sin anotaciones este año.</p>
        }
        @foreach (var a in anot.Take(5))
        {
            <div class="fi-an">
                <span>@(a.Tipo == TipoAnotacion.Positiva ? "👍" : "⚠️")</span>
                <span class="flex-grow-1">@a.Detalle</span>
                <small>@a.Fecha.ToLocalTime().ToString("dd-MM")</small>
            </div>
        }
    </div>

    <!-- Matrícula -->
    <div class="au-card fi-sec">
        <h3>📝 Matrícula @if (docs.Length > 0) { <a href="/Cursos/Pendientes?cursoId=@Model.CursoId">Gestionar documentos</a> }</h3>
        <div class="fi-dato"><span>Tipo</span><span>@(Model.TipoMatricula == TipoMatricula.Nuevo ? "🆕 Nuevo/a" : Model.TipoMatricula == TipoMatricula.Renovacion ? "🔄 Renovación" : "🚚 Traslado")</span></div>
        <div class="fi-dato"><span>Fecha</span><span>@Model.FechaMatricula.ToLocalTime().ToString("dd-MM-yyyy")</span></div>
        @if (!string.IsNullOrEmpty(Model.Especialidad))
        {
            <div class="fi-dato"><span>Especialidad</span><span>🛠️ @Model.Especialidad</span></div>
        }
        @if (Model.NecesidadesEducativas)
        {
            <div class="fi-dato"><span>Apoyo</span><span>🧩 PIE / necesidades educativas especiales</span></div>
        }
        @if (!string.IsNullOrEmpty(Model.ColegioOrigen))
        {
            <div class="fi-dato"><span>Viene de</span><span>@(Model.ColegioOrigen + (string.IsNullOrEmpty(Model.RbdOrigen) ? "" : " (RBD " + Model.RbdOrigen + ")") + (string.IsNullOrEmpty(Model.ComunaOrigen) ? "" : ", " + Model.ComunaOrigen))</span></div>
            <div class="fi-dato"><span>Motivo del traslado</span><span>@(Model.MotivoTraslado ?? "—")</span></div>
        }
        <div class="fi-dato"><span>Documentos</span><span style="color:@(docs.Length > 0 ? "#a12d2a" : "#12744a")">@(docs.Length == 0 ? "✅ Al día" : "Faltan: " + string.Join(", ", docs))</span></div>
        @if (historial.Count > 0)
        {
            <div class="mt-3">
                <small class="text-muted fw-bold">HISTORIAL POR AÑO</small>
                <div class="fi-hist mt-1">
                    @foreach (var h in historial)
                    {
                        <a href="/Cursos/Alumnos/@h.CursoId" class="au-chip">@h.Anio · @h.Curso?.Nombre @h.Curso?.Letra</a>
                    }
                </div>
            </div>
        }
    </div>
</div>

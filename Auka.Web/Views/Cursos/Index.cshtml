@model IEnumerable<Auka.Application.Entities.Curso>

@{
    ViewData["Title"] = "Gestión de Cursos y Matrícula";
    var esUTPOAdmin = User.IsInRole("UTP") || User.IsInRole("Director") || User.IsInRole("SuperAdmin");
}

<div class="container py-4">
    <!-- Encabezado Principal con Botón de Matrícula General -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">🏫 Cursos y Niveles Académicos</h2>
            <p class="text-muted mb-0">Selecciona un curso para ver la nómina de estudiantes matriculados o registra una nueva matrícula.</p>
        </div>

        <div>
            @if (esUTPOAdmin)
            {
                <a asp-action="Matricular" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                    ➕ Matricular Nuevo Alumno
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            ✅ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Grilla de Tarjetas de Cursos -->
    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">No hay cursos registrados para este año académico.</p>
            </div>
        }
        else
        {
            @foreach (var curso in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                            <h5 class="mb-0 fw-bold">@curso.Nombre "@curso.Letra"</h5>
                            <span class="badge bg-light text-primary fw-bold">@curso.AnioAcademico</span>
                        </div>
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <p class="text-muted mb-2">
                                    👨‍🏫 <strong>Profesor Jefe:</strong>
                                    @(curso.ProfesorJefe != null ? $"{curso.ProfesorJefe.Nombre} {curso.ProfesorJefe.Apellido}" : "Sin asignar")
                                </p>
                                <p class="text-muted mb-3">
                                    👥 <strong>Total Alumnos:</strong> @curso.Estudiantes.Count / @curso.CapacidadMaxima
                                </p>
                            </div>
                            <div class="text-end mt-3">
                                <a asp-action="Alumnos" asp-route-id="@curso.Id" class="btn btn-outline-primary rounded-pill btn-sm px-3 fw-bold">
                                    Ver Nómina ➔
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
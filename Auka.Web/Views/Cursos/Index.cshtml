@* Auka.Web/Views/Cursos/Index.cshtml — cursos en carpetas por nivel, con archivador de años escolares *@
@model IEnumerable<Auka.Application.Entities.Curso>
@{
    ViewData["Title"] = "Cursos";
    var esGestion = User.IsInRole("UTP") || User.IsInRole("Director") || User.IsInRole("SuperAdmin");
    int anio = ViewBag.Anio ?? DateTime.Now.Year;
    int actual = ViewBag.AnioActual ?? DateTime.Now.Year;
    var anios = ViewBag.Anios as List<int> ?? new List<int> { anio };
    var conteo = ViewBag.Conteo as Dictionary<int, int> ?? new Dictionary<int, int>();
    var esArchivo = anio < actual;
    int N(Auka.Application.Entities.Curso c) => conteo.TryGetValue(c.Id, out var n) ? n : 0;
    var total = Model.Sum(N);
    var sinJefe = Model.Count(c => c.ProfesorJefeId == null);
}
<style>
    .cu-res { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
    .cu-res .au-card { padding: 14px 18px; display: flex; align-items: center; gap: .8rem; flex: 1; min-width: 180px; }
    .cu-res .n { font-size: 1.6rem; font-weight: 900; color: var(--a-navy); line-height: 1; }
    .cu-res small { color: var(--a-mut); font-weight: 700; }
    .cu-res .ic { width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; font-size: 1.3rem; background: #eef3ff; }
    /* Archivador de años: pestañas tipo carpeta */
    .ar { display: flex; align-items: end; gap: 4px; flex-wrap: wrap; margin-bottom: -1px; position: relative; z-index: 1; }
    .ar a { text-decoration: none; padding: .55rem 1.1rem; border-radius: 14px 14px 0 0; font-weight: 800; font-size: .9rem; color: var(--a-mut); background: #e9eef6; border: 1px solid var(--a-line); border-bottom: 0; }
    .ar a:hover { background: #f3f6fb; color: var(--a-navy); }
    .ar a.on { background: #fff; color: var(--a-navy); padding-top: .75rem; box-shadow: 0 -4px 12px rgba(20,35,58,.05); }
    .ar a small { display: block; font-size: .66rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; opacity: .75; }
    .ar-caja { background: #fff; border: 1px solid var(--a-line); border-radius: 0 22px 22px 22px; padding: 18px 20px 22px; box-shadow: var(--a-sombra); }
    .ar-aviso { display: flex; gap: .7rem; align-items: center; background: #fff6e0; color: #8a5a00; border-radius: 14px; padding: .7rem 1rem; font-weight: 700; margin-bottom: 14px; }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="au-head">
    <div class="ico">🏫</div>
    <div class="txt">
        <h2>Cursos</h2>
        <p>Abre un año escolar y luego un nivel para ver sus cursos (A, B, C…).</p>
    </div>
    @if (esGestion && !esArchivo)
    {
        <div class="acc">
            <a asp-action="Pendientes">📄 Documentos pendientes</a>
            <a asp-action="Matricular" class="blanco">📝 Matricular alumno/a</a>
        </div>
    }
</div>

<!-- Archivador: un año escolar por pestaña -->
<nav class="ar" aria-label="Años escolares">
    @foreach (var a in anios)
    {
        <a class="@(a == anio ? "on" : "")" asp-action="Index" asp-route-anio="@a">
            <small>@(a == actual ? "Año actual" : a > actual ? "Próximo año" : "Archivo")</small>
            @(a > actual || a == actual ? "📂" : "🗄️") Año escolar @a
        </a>
    }
</nav>
<div class="ar-caja">
    @if (esArchivo)
    {
        <div class="ar-aviso"><span style="font-size:1.3rem">🗄️</span> Estás viendo el archivo del año escolar @anio: cursos y alumnos/as tal como quedaron ese año.</div>
    }
    else if (anio > actual)
    {
        <div class="ar-aviso" style="background:#e6f7fa;color:#0c6f7a"><span style="font-size:1.3rem">🌱</span> Matrículas para el año escolar @anio. Pasa a ser el año actual el 1 de enero.</div>
    }

    <div class="cu-res">
        <div class="au-card"><span class="ic">🎒</span><div><div class="n">@total</div><small>alumnos/as matriculados</small></div></div>
        <div class="au-card"><span class="ic" style="background:#dff6f8">🏫</span><div><div class="n">@Model.Count()</div><small>cursos en @anio</small></div></div>
        <div class="au-card"><span class="ic" style="background:#fff3d6">👩‍🏫</span><div><div class="n">@sinJefe</div><small>@(sinJefe == 1 ? "curso sin profesor jefe" : "cursos sin profesor jefe")</small></div></div>
    </div>

    @if (!Model.Any())
    {
        <div class="au-vacio">
            <span class="e">🏫</span>
            <b>Aún no hay cursos en @anio.</b>
            <p class="mb-3">Se crean solos al matricular el primer alumno/a de cada nivel.</p>
            @if (esGestion && !esArchivo)
            {
                <a asp-action="Matricular" class="btn btn-primary px-4">📝 Matricular</a>
            }
        </div>
    }
    else
    {
        var carpetas = new Auka.Web.Models.CarpetasVm
        {
            Clave = "cursos-" + anio,
            PuedeAgregar = esGestion && anio == actual,
            Cursos = Model.Select(c => new Auka.Web.Models.CarpetaCurso(c.Id, c.Nombre, c.Letra, Url.Action("Alumnos", new { id = c.Id })!,
                N(c), c.CapacidadMaxima,
                c.ProfesorJefe != null ? $"{c.ProfesorJefe.Nombre} {c.ProfesorJefe.Apellido}" : "sin prof. jefe")).ToList()
        };
        @await Html.PartialAsync("_CursosCarpetas", carpetas)
    }
</div>

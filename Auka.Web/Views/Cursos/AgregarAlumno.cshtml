@{
    ViewData["Title"] = "Matricular Alumno";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">🎓 Matricular Nuevo Estudiante</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="AgregarAlumno" method="post">
                        <input type="hidden" name="cursoId" value="@ViewBag.CursoId" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">RUT del Estudiante</label>
                            <input type="text" name="rut" class="form-control" placeholder="Ej: 20123456-7" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre</label>
                            <input type="text" name="nombre" class="form-control" placeholder="Ej: Juan" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Apellido</label>
                            <input type="text" name="apellido" class="form-control" placeholder="Ej: Pérez" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Correo Electrónico</label>
                            <input type="email" name="email" class="form-control" placeholder="ejemplo@Auka.cl" required />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Alumnos" asp-route-id="@ViewBag.CursoId" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Guardar Matrícula</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@model Auka.Application.Entities.Curso

@{
    ViewData["Title"] = $"Alumnos - {Model.Nombre} {Model.Letra}";
    var esUTPOAdmin = User.IsInRole("UTP") || User.IsInRole("Director") || User.IsInRole("SuperAdmin");
}

<div class="container py-4">
    <!-- Mensajes de Alerta y Confirmación de Matrícula -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            ℹ️ @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">📋 Nómina: @Model.Nombre "@Model.Letra"</h2>
            <p class="text-muted mb-0">Lista oficial de estudiantes matriculados en este nivel.</p>
        </div>

        <div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill me-2">Volver a Cursos</a>
            @if (esUTPOAdmin)
            {
                <a asp-action="Matricular" class="btn btn-primary rounded-pill px-4 fw-bold">
                    + Matricular Nuevo Alumno
                </a>
            }
        </div>
    </div>

    <!-- Buscador Rápido en Vivo -->
    <div class="mb-3">
        <input type="text" id="filtroAlumno" class="form-control rounded-pill px-3 shadow-sm" placeholder="🔎 Filtrar alumno por nombre, apellido o RUT en este curso..." onkeyup="filtrarTabla()" />
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tablaAlumnos">
                    <thead class="table-light">
                        <tr>
                            <th>RUT</th>
                            <th>Nombre Completo</th>
                            <th>Correo Electrónico</th>
                            <th>Tipo Matrícula</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Estudiantes.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No hay estudiantes matriculados en este curso.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var est in Model.Estudiantes)
                            {
                                <tr>
                                    <td><code>@est.Usuario?.Rut</code></td>
                                    <td>
                                        <strong>@est.Usuario?.Nombre @est.Usuario?.Apellido</strong>
                                        @if (est.FueCambiadoPorExcepcion)
                                        {
                                            <br />
                                            <small class="badge bg-warning text-dark mt-1" title="@est.MotivoCambioExcepcion">
                                                ⚠️ Cambiado por Excepción
                                            </small>
                                        }
                                    </td>
                                    <td>@est.Usuario?.Email</td>
                                    <td>
                                        @if (est.TipoMatricula == Auka.Application.Entities.TipoMatricula.Nuevo)
                                        {
                                            <span class="badge bg-success rounded-pill px-3">🆕 Alumno Nuevo</span>
                                        }
                                        else if (est.TipoMatricula == Auka.Application.Entities.TipoMatricula.Renovacion)
                                        {
                                            <span class="badge bg-primary rounded-pill px-3">🔄 Renovación</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3">🚚 Traslado</span>
                                        }
                                    </td>
                                    <td>
                                        @if (esUTPOAdmin)
                                        {
                                            <button class="btn btn-outline-warning btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#modalCambio-@est.Id">
                                                🔄 Cambiar Curso
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Script del Filtro en Vivo -->
<script>
    function filtrarTabla() {
        var input = document.getElementById("filtroAlumno").value.toLowerCase();
        var filas = document.querySelectorAll("#tablaAlumnos tbody tr");

        filas.forEach(function(fila) {
            var texto = fila.innerText.toLowerCase();
            if (texto.includes(input)) {
                fila.style.display = "";
            } else {
                fila.style.display = "none";
            }
        });
    }
</script>
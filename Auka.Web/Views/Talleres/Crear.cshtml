@model Auka.Application.Entities.Taller

@{
    ViewData["Title"] = "Crear Club / Taller";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-warning text-dark py-3">
                    <h4 class="mb-0 fw-bold">🏆 Crear Nuevo Club o Taller</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post">

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre del Club / Taller</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Selección de Fútbol Sub-17" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Descripción u Objetivo</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="2" placeholder="Ej: Entrenamiento enfocado en torneos interescolares..." required></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Profesor o Entrenador a Cargo</label>
                            <select asp-for="DocenteCargoId" class="form-select" asp-items="ViewBag.Docentes" required>
                                <option value="">-- Seleccionar Profesor --</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Horarios y Días de Entrenamiento</label>
                            <input asp-for="Horario" class="form-control" placeholder="Ej: Martes y Jueves de 16:00 a 17:30 hrs" required />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                            <button type="submit" class="btn btn-warning text-dark rounded-pill px-4 fw-bold">Crear Taller</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@* Auka.Web/Views/Talleres/Crear.cshtml — crear club o taller: tipo, profesor, días y horario, cupo *@
@model Auka.Application.Entities.Taller
@using Auka.Web.Controllers
@{
    ViewData["Title"] = "Crear club o taller";
    var dias = new[] { ("Lu", "Lunes"), ("Ma", "Martes"), ("Mi", "Miércoles"), ("Ju", "Jueves"), ("Vi", "Viernes"), ("Sá", "Sábado") };
}
<style>
    .cc-wrap { max-width: 880px; margin: 0 auto; }
    .cc-sec { padding: 22px 24px; margin-bottom: 16px; }
    .cc-sec h3 { font-size: 1.02rem; font-weight: 900; color: var(--a-navy); margin: 0 0 .2rem; }
    .cc-sec .ay { color: var(--a-mut); font-size: .86rem; margin-bottom: 14px; }
    .cc-cats { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 10px; }
    .cc-cats label { cursor: pointer; margin: 0; }
    .cc-cats input { position: absolute; opacity: 0; pointer-events: none; }
    .cc-cats .op { border: 2px solid var(--a-line); border-radius: 18px; padding: 14px 10px; text-align: center; font-weight: 800; transition: all .2s; background: #fff; display: block; }
    .cc-cats .op span { display: block; font-size: 1.8rem; margin-bottom: .2rem; transition: transform .2s; }
    .cc-cats label:hover .op { border-color: #ffd98a; }
    .cc-cats input:checked + .op { border-color: transparent; background: var(--a-grad-sun); color: #fff; box-shadow: 0 10px 22px rgba(251,133,0,.3); }
    .cc-cats input:checked + .op span { transform: scale(1.15); }
    .cc-cats input:focus-visible + .op { outline: 3px solid rgba(31,181,197,.5); }
    .cc-dias { display: flex; gap: .45rem; flex-wrap: wrap; }
    .cc-dias button { width: 52px; height: 52px; border-radius: 16px; border: 2px solid var(--a-line); background: #fff; font-weight: 900; color: var(--a-mut); transition: all .2s; }
    .cc-dias button.on { background: var(--a-grad); color: #fff; border-color: transparent; box-shadow: 0 8px 16px rgba(36,89,176,.28); }
    .cc-horas { display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; margin-top: 12px; }
    .cc-horas input[type=time] { max-width: 140px; }
    .cc-prev { margin-top: 12px; padding: .7rem 1rem; border-radius: 14px; background: #f3f7ff; color: var(--a-navy); font-weight: 700; }
    .cc-acc { display: flex; justify-content: space-between; gap: .6rem; flex-wrap: wrap; }
</style>

<div class="cc-wrap">
    <div class="au-head sol">
        <div class="ico">✨</div>
        <div class="txt"><h2>Nuevo club o taller</h2><p>Completa los datos y luego suma a los integrantes.</p></div>
        <div class="acc"><a asp-action="Index">Volver a clubes</a></div>
    </div>

    <form asp-action="Crear" method="post" id="fClub">
        <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-2"></div>

        <div class="au-card cc-sec">
            <h3>1. ¿Qué tipo de actividad es?</h3>
            <div class="ay">Sirve para ordenar y filtrar los clubes.</div>
            <div class="cc-cats">
                @foreach (var c in TalleresController.Categorias)
                {
                    <label>
                        <input type="radio" name="Categoria" value="@c.Clave" checked="@(Model.Categoria == c.Clave)" />
                        <span class="op"><span>@c.Icono</span>@c.Clave</span>
                    </label>
                }
            </div>
        </div>

        <div class="au-card cc-sec">
            <h3>2. Nombre y profesor/a</h3>
            <div class="ay">El profesor/a a cargo verá el club en su inicio y podrá sumar integrantes si el administrador lo permite.</div>
            <div class="row g-3">
                <div class="col-md-7">
                    <label asp-for="Nombre" class="form-label">Nombre del club o taller</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Robótica, Coro, Selección de vóleibol" required maxlength="120" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="DocenteId" class="form-label">Profesor/a a cargo</label>
                    <select asp-for="DocenteId" asp-items="(SelectList)ViewBag.Docentes" class="form-select" required>
                        <option value="">Elige un profesor/a</option>
                    </select>
                    <span asp-validation-for="DocenteId" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Descripcion" class="form-label">¿De qué se trata?</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="2" maxlength="500" placeholder="Ej: armamos y programamos robots para competir en la feria científica"></textarea>
                </div>
            </div>
        </div>

        <div class="au-card cc-sec">
            <h3>3. Días, horario y cupo</h3>
            <div class="ay">Marca los días y la hora; el texto se arma solo (también puedes escribirlo a mano).</div>
            <div class="cc-dias" id="ccDias">
                @foreach (var d in dias)
                {
                    <button type="button" data-d="@d.Item2" title="@d.Item2">@d.Item1</button>
                }
            </div>
            <div class="cc-horas">
                <span class="fw-bold">De</span><input type="time" id="ccDe" class="form-control" value="16:00" />
                <span class="fw-bold">a</span><input type="time" id="ccA" class="form-control" value="17:30" />
                <span class="fw-bold ms-md-3">Cupo</span>
                <input asp-for="Cupo" type="number" min="1" max="500" class="form-control" style="max-width:110px" placeholder="Sin límite" />
            </div>
            <label asp-for="Horario" class="form-label mt-3">Horario que verán todos</label>
            <input asp-for="Horario" id="ccHor" class="form-control" placeholder="Ej: Martes y jueves de 16:00 a 17:30" maxlength="160" />
        </div>

        <div class="cc-acc">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-warning px-5">Crear club</button>
        </div>
    </form>
</div>

<script>
    (function () {
        var dias = document.getElementById('ccDias'), de = document.getElementById('ccDe'), a = document.getElementById('ccA'), hor = document.getElementById('ccHor');
        var manual = !!hor.value;
        var armar = function () {
            if (manual) return;
            var sel = Array.prototype.map.call(dias.querySelectorAll('button.on'), function (b) { return b.getAttribute('data-d'); });
            if (!sel.length) { hor.value = ''; return; }
            var txt = sel.length === 1 ? sel[0] : sel.slice(0, -1).join(', ') + ' y ' + sel[sel.length - 1].toLowerCase();
            txt = txt.charAt(0) + txt.slice(1).toLowerCase();
            hor.value = txt + ' de ' + de.value + ' a ' + a.value;
        };
        dias.addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; b.classList.toggle('on'); manual = false; armar(); });
        de.addEventListener('change', function () { manual = false; armar(); });
        a.addEventListener('change', function () { manual = false; armar(); });
        hor.addEventListener('input', function () { manual = true; });
        // Si ninguna categoría viene marcada, marca la primera
        if (!document.querySelector('input[name="Categoria"]:checked')) document.querySelector('input[name="Categoria"]').checked = true;
    })();
</script>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

@model IEnumerable<Auka.Application.Entities.Taller>

@{
    ViewData["Title"] = "Clubes y Talleres Extraprogramáticos";
    var esAdmin = User.IsInRole("SuperAdmin") || User.IsInRole("Director");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-warning text-dark mb-1">⚽ Clubes y Talleres Extraprogramáticos (ACLE)</h2>
            <p class="text-muted">Gestión de actividades deportivas, culturales y científicas del establecimiento.</p>
        </div>

        @if (esAdmin)
        {
            <a asp-action="Crear" class="btn btn-warning text-dark rounded-pill px-4 fw-bold">
                + Crear Nuevo Club / Taller
            </a>
        }
    </div>

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-light text-center py-4 border shadow-sm">
                    No hay talleres o clubes registrados actualmente.
                </div>
            </div>
        }
        else
        {
            @foreach (var taller in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 border-top border-4 border-warning">
                        <div class="card-body">
                            <h5 class="fw-bold text-dark mb-2">🏆 @taller.Nombre</h5>
                            <p class="text-muted small mb-3">@taller.Descripcion</p>

                            <div class="bg-light p-3 rounded-3 mb-3">
                                <small class="d-block text-secondary">
                                    👨‍🏫 <strong>Profesor a Cargo:</strong><br />
                                    @(taller.DocenteCargo != null ? $"{taller.DocenteCargo.Nombre} {taller.DocenteCargo.Apellido}" : "Sin Asignar")
                                </small>
                                <hr class="my-2" />
                                <small class="d-block text-secondary">
                                    ⏰ <strong>Horario:</strong> @taller.Horario
                                </small>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-secondary">@taller.Estudiantes.Count Alumnos Inscritos</span>
                                <button class="btn btn-outline-dark btn-sm rounded-pill px-3">Ver Integrantes</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
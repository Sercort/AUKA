@* Auka.Web/Views/Talleres/Index.cshtml — clubes y talleres del colegio (ACLE) *@
@model IEnumerable<Auka.Application.Entities.Taller>
@using Auka.Web.Controllers
@{
    ViewData["Title"] = "Clubes y talleres";
    var puedeCrear = ViewBag.PuedeCrear == true;
    int userId = ViewBag.UserId ?? 0;
    var misClubes = ViewBag.MisClubes as HashSet<int> ?? new HashSet<int>();
    var lista = Model.ToList();
    var categoriasUsadas = lista.Select(t => TalleresController.Cat(t.Categoria)).DistinctBy(c => c.Clave).ToList();
    var totalInscritos = lista.Sum(t => t.Inscripciones.Count);
    var logrosDe = ViewBag.Logros as Dictionary<int, List<Auka.Application.Entities.LogroTaller>> ?? new();
    int interesados = ViewBag.Interesados ?? 0;
    var misAlumnos = ViewBag.MisAlumnos as List<Auka.Web.Controllers.OpcionVm> ?? new();
    var verInteres = User.IsInRole("Estudiante") || User.IsInRole("Apoderado");
}
<style>
    .cl-res { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
    .cl-res .au-card { padding: 12px 18px; display: flex; align-items: center; gap: .7rem; }
    .cl-res b { font-size: 1.4rem; font-weight: 900; color: var(--a-navy); }
    .cl-res small { color: var(--a-mut); font-weight: 700; }
    .cl-filtros { display: flex; gap: .45rem; flex-wrap: wrap; margin-bottom: 16px; }
    .cl-filtros button { border: 1.5px solid var(--a-line); background: #fff; border-radius: 999px; padding: .4rem .95rem; font-weight: 800; font-size: .85rem; color: var(--a-mut); transition: all .2s; }
    .cl-filtros button.on, .cl-filtros button:hover { background: var(--a-grad-sun); color: #fff; border-color: transparent; box-shadow: 0 6px 14px rgba(251,133,0,.25); }
    .cl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 16px; }
    .cl { background: #fff; border: 1px solid var(--a-line); border-radius: 22px; box-shadow: var(--a-sombra); text-decoration: none; color: var(--a-ink); display: flex; flex-direction: column; overflow: hidden; transition: transform .2s, box-shadow .2s; position: relative; }
    .cl:hover { transform: translateY(-4px); box-shadow: var(--a-sombra-hover); color: var(--a-ink); }
    .cl-top { padding: 18px 18px 14px; display: flex; gap: .85rem; align-items: flex-start; background: linear-gradient(160deg, #fff6e0 0%, #fff 70%); }
    .cl-ico { width: 54px; height: 54px; border-radius: 16px; display: grid; place-items: center; font-size: 1.7rem; background: var(--a-grad-sun); box-shadow: 0 8px 16px rgba(251,133,0,.28); flex-shrink: 0; }
    .cl h4 { font-size: 1.08rem; font-weight: 900; margin: 0 0 .3rem; }
    .cl-desc { padding: 0 18px; color: var(--a-mut); font-size: .88rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.6em; }
    .cl-info { padding: 12px 18px; display: grid; gap: .35rem; font-size: .86rem; }
    .cl-info span { display: flex; gap: .45rem; align-items: center; }
    .cl-pie { margin-top: auto; border-top: 1px solid #eef2f8; padding: 12px 18px; display: flex; align-items: center; gap: .6rem; }
    .cl-pie .ver { margin-left: auto; font-weight: 800; color: #c26a00; font-size: .86rem; }
    .cl-cupo { flex: 1; max-width: 120px; height: 7px; border-radius: 9px; background: #f1e7d2; overflow: hidden; }
    .cl-cupo i { display: block; height: 100%; background: var(--a-grad-sun); border-radius: 9px; }
    .cl-mio { position: absolute; top: 12px; right: 12px; }
</style>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="au-head sol">
    <div class="ico">🌟</div>
    <div class="txt">
        <h2>Clubes y talleres</h2>
        <p>Actividades deportivas, artísticas, científicas y culturales del colegio.</p>
    </div>
    @if (verInteres && misAlumnos.Count > 0)
    {
        <div class="acc"><button type="button" class="blanco" data-bs-toggle="modal" data-bs-target="#mInteres">🙋 Me interesa un club</button></div>
    }
    @if (puedeCrear)
    {
        <div class="acc">
            <a asp-action="Interesados">🙋 Interesados@(interesados > 0 ? " (" + interesados + ")" : "")</a>
            <button type="button" data-bs-toggle="modal" data-bs-target="#mImpClub">📥 Importar planillas</button>
            <a asp-action="Crear" class="blanco">➕ Crear club o taller</a>
        </div>
    }
</div>

@if (lista.Count == 0)
{
    <div class="au-card au-vacio">
        <span class="e">🌟</span>
        <b>Aún no hay clubes ni talleres.</b>
        <p class="mb-3">Fútbol, robótica, teatro, coro, ajedrez, huerto... lo que el colegio ofrezca.</p>
        @if (puedeCrear)
        {
            <a asp-action="Crear" class="btn btn-warning px-4">➕ Crear el primero</a>
        }
    </div>
}
else
{
    <div class="cl-res">
        <div class="au-card"><span style="font-size:1.4rem">🏆</span><b>@lista.Count</b><small>@(lista.Count == 1 ? "club activo" : "clubes activos")</small></div>
        <div class="au-card"><span style="font-size:1.4rem">🙋</span><b>@totalInscritos</b><small>inscripciones</small></div>
    </div>

    @if (categoriasUsadas.Count > 1)
    {
        <div class="cl-filtros" id="clF">
            <button type="button" class="on" data-cat="">Todos</button>
            @foreach (var c in categoriasUsadas)
            {
                <button type="button" data-cat="@c.Clave">@c.Icono @c.Clave</button>
            }
        </div>
    }

    <div class="cl-grid">
        @foreach (var t in lista)
        {
            var cat = TalleresController.Cat(t.Categoria);
            var n = t.Inscripciones.Count;
            var profe = t.Docente != null ? $"{t.Docente.Nombre} {t.Docente.Apellido}" : (string.IsNullOrWhiteSpace(t.DocenteCargo) ? "Sin profesor/a asignado" : t.DocenteCargo);
            var pct = t.Cupo is > 0 ? Math.Min(100, n * 100 / t.Cupo.Value) : 0;
            <a class="cl" asp-action="Detalle" asp-route-id="@t.Id" data-cat="@cat.Clave">
                @if (t.DocenteId == userId && User.IsInRole("Docente"))
                {
                    <span class="au-chip cl-mio">⭐ A tu cargo</span>
                }
                else if (misClubes.Contains(t.Id))
                {
                    <span class="au-chip verde cl-mio">✅ Estás inscrito/a</span>
                }
                <div class="cl-top">
                    <span class="cl-ico">@cat.Icono</span>
                    <div>
                        <h4>@t.Nombre</h4>
                        <span class="au-chip @cat.Chip">@cat.Clave</span>
                    </div>
                </div>
                <div class="cl-desc">@(string.IsNullOrWhiteSpace(t.Descripcion) ? "Sin descripción." : t.Descripcion)</div>
                <div class="cl-info">
                    <span>👩‍🏫 <b>@profe</b></span>
                    <span>🗓️ @(string.IsNullOrWhiteSpace(t.Horario) ? "Horario por definir" : t.Horario)</span>
                    @if (!string.IsNullOrEmpty(t.Lugar)) { <span>📍 @t.Lugar</span> }
                    @{ var nv = Auka.Web.Services.Clubes.LeerNiveles(t.Niveles); }
                    @if (nv.Count > 0) { <span>🎯 @string.Join(" · ", nv.Select(Auka.Web.Services.Clubes.NombreTramo))</span> }
                    @if (logrosDe.TryGetValue(t.Id, out var lg))
                    {
                        var gan = lg.Where(x => Auka.Web.Services.Clubes.Resultado(x.Resultado).Gana).ToList();
                        if (gan.Count > 0) { <span>@string.Join("  ", gan.GroupBy(x => x.Resultado).Select(g => Auka.Web.Services.Clubes.Resultado(g.Key).Icono + " " + g.Count()))</span> }
                    }
                </div>
                <div class="cl-pie">
                    <span class="au-chip sol">🙋 @n @(t.Cupo is > 0 ? "de " + t.Cupo : (n == 1 ? "integrante" : "integrantes"))</span>
                    @if (t.Cupo is > 0)
                    {
                        <span class="cl-cupo"><i style="width:@pct%"></i></span>
                    }
                    <span class="ver">Ver integrantes</span>
                </div>
            </a>
        }
    </div>
}

<script>
    (function () {
        var f = document.getElementById('clF'); if (!f) return;
        f.addEventListener('click', function (e) {
            var b = e.target.closest('button[data-cat]'); if (!b) return;
            f.querySelectorAll('button').forEach(function (x) { x.classList.toggle('on', x === b); });
            var c = b.getAttribute('data-cat');
            document.querySelectorAll('.cl[data-cat]').forEach(function (el) { el.style.display = !c || el.getAttribute('data-cat') === c ? '' : 'none'; });
        });
    })();
</script>

@if (puedeCrear)
{
    <div class="modal fade" id="mImpClub" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title fw-bold">📥 Importar clubes e inscripciones</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
                <div class="modal-body">
                    <p class="small text-muted">Guarda cada planilla de Excel como <b>CSV</b> (punto y coma). Primero los clubes y después las inscripciones. AUKA revisa los choques: si un club topa con las clases del profesor/a, con otro club en el mismo lugar, o un alumno/a con sus clases, no se carga esa fila y te dice por qué.</p>
                    <form asp-action="ImportarClubes" method="post" enctype="multipart/form-data" class="au-card p-3 mb-3" onsubmit="var b=this.querySelector('button.btn-primary'); if(b.disabled) return false; b.disabled=true; b.textContent='Importando…'; return true;">
                        @Html.AntiForgeryToken()
                        <b class="d-block mb-1">1. Clubes y sus horarios</b>
                        <small class="text-muted d-block mb-2">Una fila por cada día del club (ej. fútbol lunes y miércoles = 2 filas). Si el club ya existe, se actualiza su horario.</small>
                        <div class="d-flex gap-2 flex-wrap align-items-center">
                            <button type="button" class="btn btn-outline-primary btn-sm px-3" data-plantilla="clubes">📄 Plantilla</button>
                            <input type="file" name="archivo" accept=".csv" class="form-control" style="flex:1;min-width:220px" required />
                            <button class="btn btn-primary px-4">Importar clubes</button>
                        </div>
                    </form>
                    <form asp-action="ImportarInscripciones" method="post" enctype="multipart/form-data" class="au-card p-3" onsubmit="var b=this.querySelector('button.btn-primary'); if(b.disabled) return false; b.disabled=true; b.textContent='Importando…'; return true;">
                        @Html.AntiForgeryToken()
                        <b class="d-block mb-1">2. Inscripciones (quién va a cada club)</b>
                        <small class="text-muted d-block mb-2">Una fila por alumno/a y club. Se revisa el nivel, el cupo y que no choque con sus clases ni con sus otros clubes.</small>
                        <div class="d-flex gap-2 flex-wrap align-items-center">
                            <button type="button" class="btn btn-outline-primary btn-sm px-3" data-plantilla="inscripciones">📄 Plantilla</button>
                            <input type="file" name="archivo" accept=".csv" class="form-control" style="flex:1;min-width:220px" required />
                            <button class="btn btn-primary px-4">Importar inscripciones</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <script>
        document.querySelectorAll('[data-plantilla]').forEach(function (b) {
            b.addEventListener('click', function () {
                var clubes = b.dataset.plantilla === 'clubes';
                var csv = clubes
                    ? '\ufeffClub;Categoría;RUT profesor;Día;Hora inicio;Hora fin;Lugar;Cupo;Niveles;Fecha inicio;Fecha fin;Descripción\r\n' +
                      'Fútbol infantil;Deportivo;12.345.678-5;Lunes;16:00;17:30;Cancha;25;1º a 4º básico;02-03-2026;27-11-2026;Fútbol para los más chicos\r\n' +
                      'Fútbol infantil;Deportivo;12.345.678-5;Miércoles;16:00;17:30;Cancha;25;1º a 4º básico;02-03-2026;27-11-2026;\r\n'
                    : '\ufeffRUT alumno;Club\r\n24.123.456-8;Fútbol infantil\r\n';
                var a = document.createElement('a');
                a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
                a.download = clubes ? 'plantilla_clubes_auka.csv' : 'plantilla_inscripciones_auka.csv';
                document.body.appendChild(a); a.click(); a.remove();
            });
        });
    </script>
}

@if (verInteres && misAlumnos.Count > 0)
{
    <div class="modal fade" id="mInteres" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" asp-action="MeInteresa" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header"><h5 class="modal-title fw-bold">🙋 Me interesa un club</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
                <div class="modal-body">
                    <p class="small text-muted">¿No hay cupo, no es para tu curso o el club que quieres no existe? Déjalo aquí: le llega a la UTP y, si se juntan suficientes interesados/as, se puede abrir un grupo nuevo.</p>
                    @if (misAlumnos.Count > 1)
                    {
                        <label class="form-label">¿Para quién?</label>
                        <select class="form-select mb-3" name="estudianteId">
                            @foreach (var a in misAlumnos)
                            {
                                <option value="@a.Id">@a.Nombre</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input type="hidden" name="estudianteId" value="@misAlumnos[0].Id" />
                    }
                    <label class="form-label">Club</label>
                    <select class="form-select mb-3" name="tallerId" id="miClub">
                        @foreach (var t in lista)
                        {
                            <option value="@t.Id">@TalleresController.Cat(t.Categoria).Icono @t.Nombre</option>
                        }
                        <option value="">✨ Otro club que todavía no existe</option>
                    </select>
                    <div id="miNuevo" style="display:none">
                        <label class="form-label">¿De qué tipo?</label>
                        <select class="form-select mb-3" name="categoria">
                            @foreach (var c in TalleresController.Categorias)
                            {
                                <option value="@c.Clave">@c.Icono @c.Clave</option>
                            }
                        </select>
                    </div>
                    <label class="form-label">Comentario <span class="text-muted fw-normal">(opcional)</span></label>
                    <input class="form-control" name="comentario" maxlength="300" placeholder="Ej: me gustaría un taller de cómic / quiero entrar a vóleibol" />
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-warning px-4">Enviar a la UTP</button></div>
            </form>
        </div>
    </div>
    <script>
        document.getElementById('miClub').addEventListener('change', function () { document.getElementById('miNuevo').style.display = this.value ? 'none' : ''; });
    </script>
}

@* Auka.Web/Views/Talleres/Detalle.cshtml — ficha del club: datos, integrantes e inscripción *@
@model Auka.Application.Entities.Taller
@using Auka.Web.Controllers
@{
    var cat = TalleresController.Cat(Model.Categoria);
    ViewData["Title"] = Model.Nombre;
    var puede = ViewBag.PuedeInscribir == true;
    var ve = ViewBag.VeIntegrantes == true;
    var integrantes = ViewBag.Integrantes as List<IntegranteVm> ?? new();
    var cursos = ViewBag.Cursos as List<OpcionVm> ?? new();
    var porCurso = integrantes.GroupBy(i => string.IsNullOrEmpty(i.Curso) ? "Sin curso" : i.Curso).OrderBy(g => g.Key).ToList();
    var profe = Model.Docente != null ? $"{Model.Docente.Nombre} {Model.Docente.Apellido}" : (Model.DocenteCargo ?? "Sin profesor/a asignado");
    var lleno = Model.Cupo is > 0 && integrantes.Count >= Model.Cupo;
    var colores = new[] { "#fb8500", "#ffb703", "#2bb673", "#1fb5c5", "#2459b0", "#6c5ce7", "#ef6f6c" };
    bool puedeEditar = ViewBag.PuedeEditarClub == true;
    var niveles = Auka.Web.Services.Clubes.LeerNiveles(Model.Niveles);
    var horario = Model.Sesiones.Count > 0 ? Auka.Web.Services.Clubes.Texto(Model.Sesiones) : Model.Horario;
    var terminado = Auka.Web.Services.Clubes.Terminado(Model);
    var logros = ViewBag.Logros as List<Auka.Application.Entities.LogroTaller> ?? new();
    bool puedeLogros = ViewBag.PuedeLogros == true;
    bool puedeRend = ViewBag.PuedeRendimiento == true;
    var promedios = ViewBag.Promedios as Dictionary<int, decimal> ?? new();
    var ganados = logros.Where(l => Auka.Web.Services.Clubes.Resultado(l.Resultado).Gana).ToList();
    var animo = Auka.Web.Services.Clubes.Animo(logros);
}
<style>
    .ta-grid { display: grid; grid-template-columns: 320px 1fr; gap: 18px; align-items: start; }
    .ta-datos { padding: 20px; }
    .ta-datos .fila { display: flex; gap: .7rem; padding: .65rem 0; border-bottom: 1px solid #eef2f8; }
    .ta-datos .fila:last-child { border-bottom: 0; }
    .ta-datos .fila span:first-child { font-size: 1.2rem; }
    .ta-datos small { display: block; font-size: .7rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--a-mut); }
    .ta-int { padding: 20px; }
    .ta-int h3 { font-size: 1.1rem; font-weight: 900; color: var(--a-navy); margin: 0; }
    .ta-buscar { position: relative; flex: 1; min-width: 220px; }
    .ta-inscribir { display: flex; gap: .6rem; flex-wrap: wrap; margin: 14px 0 6px; }
    .ta-inscribir select { max-width: 220px; border-radius: 999px !important; font-weight: 700; }
    .ta-curso { display: flex; align-items: center; gap: .5rem; margin: 16px 0 4px; }
    .ta-curso h4 { font-size: .9rem; font-weight: 900; color: var(--a-navy); margin: 0; }
    .ta-curso::after { content: ""; flex: 1; height: 1px; background: var(--a-line); }
    .ta-todos { display: flex; justify-content: space-between; align-items: center; padding: .55rem .85rem; background: #fff8e8; font-size: .86rem; font-weight: 700; }
    .ta-buscar input { border-radius: 999px !important; padding-left: 2.3rem !important; }
    .ta-buscar .lupa { position: absolute; left: .9rem; top: 50%; transform: translateY(-50%); opacity: .55; }
    .ta-res { border: 1px solid var(--a-line); border-radius: 16px; overflow: hidden; display: none; margin-bottom: 12px; }
    .ta-res.on { display: block; }
    .ta-op { display: flex; align-items: center; gap: .7rem; padding: .6rem .85rem; border-bottom: 1px solid #eef2f8; }
    .ta-op:last-child { border-bottom: 0; }
    .ta-op .d { flex: 1; min-width: 0; }
    .ta-op small { color: var(--a-mut); }
    .ta-al { display: flex; align-items: center; gap: .8rem; padding: .7rem .4rem; border-bottom: 1px solid #eef2f8; }
    .ta-al:last-child { border-bottom: 0; }
    .ta-av { width: 40px; height: 40px; border-radius: 13px; display: grid; place-items: center; color: #fff; font-weight: 900; flex-shrink: 0; }
    .ta-al .d { flex: 1; min-width: 0; }
    .ta-al small { color: var(--a-mut); }
    @@media (max-width: 900px) { .ta-grid { grid-template-columns: 1fr; } }
</style>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="au-head sol">
    <div class="ico">@cat.Icono</div>
    <div class="txt">
        <h2>@Model.Nombre</h2>
        <p>@cat.Clave · @profe</p>
    </div>
    <div class="acc"><a asp-action="Index">Volver a clubes</a></div>
</div>

<div class="ta-grid">
    <div class="au-card ta-datos">
        <div class="fila"><span>📝</span><div><small>De qué se trata</small>@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción." : Model.Descripcion)</div></div>
        <div class="fila"><span>👩‍🏫</span><div><small>Profesor/a a cargo</small><b>@profe</b></div></div>
        <div class="fila"><span>🗓️</span><div><small>Días y horario</small>@(string.IsNullOrWhiteSpace(horario) ? "Por definir" : horario)</div></div>
        <div class="fila"><span>📍</span><div><small>Lugar</small>@(Model.Lugar ?? "Por definir")</div></div>
        <div class="fila"><span>🎯</span><div><small>Para quiénes</small>@(niveles.Count == 0 ? "Todos los cursos" : string.Join(" · ", niveles.Select(Auka.Web.Services.Clubes.NombreTramo)))</div></div>
        @if (Model.FechaInicio != null || Model.FechaFin != null)
        {
            <div class="fila"><span>📆</span><div><small>Temporada</small>@(Model.FechaInicio?.ToString("dd-MM-yyyy") ?? "inicio de año") al @(Model.FechaFin?.ToString("dd-MM-yyyy") ?? "fin de año") @if (terminado) { <span class="au-chip coral">Terminó</span> }</div></div>
        }
        <div class="fila"><span>🙋</span><div><small>Integrantes</small><b>@integrantes.Count</b>@(Model.Cupo is > 0 ? $" de {Model.Cupo} cupos" : " · sin límite de cupo")</div></div>
        @if (puedeEditar)
        {
            <button type="button" class="btn btn-outline-primary btn-sm w-100 mt-2" data-bs-toggle="modal" data-bs-target="#mHorClub">✏️ Editar horario, lugar y para quiénes</button>
        }
    </div>

    <div class="au-card ta-int">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h3>🙋 Integrantes</h3>
            <span class="au-chip sol">@integrantes.Count</span>
            @if (lleno)
            {
                <span class="au-chip coral">Cupo completo</span>
            }
        </div>

        @if (puede && !lleno)
        {
            <div class="ta-inscribir">
                <select id="taCurso" class="form-select" aria-label="Elegir curso">
                    <option value="">Todos los cursos</option>
                    @foreach (var c in cursos)
                    {
                        <option value="@c.Id">@c.Nombre</option>
                    }
                </select>
                <div class="ta-buscar">
                    <span class="lupa">🔍</span>
                    <input type="search" id="taQ" class="form-control" placeholder="Elige un curso o escribe nombre o RUT" autocomplete="off" />
                </div>
            </div>
            <div class="ta-res" id="taRes"></div>
            <div id="taMsg"></div>
            @Html.AntiForgeryToken()
        }
        else if (!puede && ve)
        {
            <p class="small text-muted mt-2 mb-2">Para sumar integrantes, pídeselo a quien el administrador autorizó (por ejemplo, el profesor/a a cargo o la UTP).</p>
        }

        @if (!ve)
        {
            <div class="au-vacio"><span class="e">🔒</span>La lista de integrantes la ve el equipo del colegio.</div>
        }
        else if (integrantes.Count == 0)
        {
            <div class="au-vacio"><span class="e">🙋</span>Aún no hay integrantes.@(puede ? " Búscalos arriba para inscribirlos." : "")</div>
        }
        else
        {
            var k = 0;
            <div class="mt-1">
                @foreach (var g in porCurso)
                {
                <div class="ta-curso"><h4>🏫 @g.Key</h4><span class="au-chip sol">@g.Count()</span></div>
                @foreach (var a in g)
                {
                    var ini = string.Concat(a.Nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
                    <div class="ta-al">
                        <span class="ta-av" style="background:@colores[k % colores.Length]">@ini</span>
                        <div class="d"><b>@a.Nombre</b>
                            @if (promedios.TryGetValue(a.EstudianteId, out var pr))
                            {
                                <span class="au-chip @(pr < 4.0m ? "coral" : "verde")" title="Promedio general del año">📊 @Auka.Web.Services.Csv.Nota1(pr)</span>
                            }
                            <br /><small>@a.Curso · @a.Rut · desde @a.FechaUtc.ToLocalTime().ToString("dd-MM-yyyy")</small></div>
                        @if (puedeRend && promedios.TryGetValue(a.EstudianteId, out var pr2) && pr2 < 4.0m)
                        {
                            <form asp-action="QuitarPorRendimiento" method="post" data-c="¿Sacar a @a.Nombre del club por rendimiento? Se avisa a la UTP o al profesor/a (no a sus compañeros/as ni al apoderado/a)." onsubmit="return confirm(this.dataset.c);">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.Id" />
                                <button class="btn btn-outline-warning btn-sm px-2" title="Las notas tienen prioridad">📉 Por notas</button>
                            </form>
                        }
                        @if (puede)
                        {
                            <form asp-action="Quitar" method="post" data-c="¿Quitar a @a.Nombre del club?" onsubmit="return confirm(this.dataset.c);">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.Id" />
                                <button class="btn btn-outline-danger btn-sm px-3">Quitar</button>
                            </form>
                        }
                    </div>
                    k++;
                }
                }
            </div>
        }
    </div>
</div>

<div class="au-card p-3 mt-3">
    <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
        <h3 class="m-0" style="font-size:1.1rem;font-weight:900;color:var(--a-navy)">🏆 Logros del club</h3>
        @foreach (var r in Auka.Web.Services.Clubes.Resultados.Where(x => x.Gana))
        {
            var n = ganados.Count(l => l.Resultado == r.Clave);
            if (n > 0) { <span class="au-chip sol" title="@r.Nombre">@r.Icono @n</span> }
        }
        @if (puedeLogros)
        {
            <button type="button" class="btn btn-warning btn-sm px-3 ms-auto" data-bs-toggle="collapse" data-bs-target="#lgForm">➕ Registrar resultado</button>
        }
    </div>
    @if (animo != null)
    {
        <div class="alert @(animo.StartsWith("🎉") ? "alert-success" : "alert-info") py-2">@animo</div>
    }
    @if (puedeLogros)
    {
        <form asp-action="AgregarLogro" method="post" class="collapse mb-3" id="lgForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tallerId" value="@Model.Id" />
            <div class="row g-2">
                <div class="col-md-5"><input class="form-control" name="evento" maxlength="120" required placeholder="Ej: Campeonato comunal sub-12" aria-label="Evento" /></div>
                <div class="col-md-3">
                    <select class="form-select" name="resultado" aria-label="Resultado">
                        @foreach (var r in Auka.Web.Services.Clubes.Resultados)
                        {
                            <option value="@r.Clave">@r.Icono @r.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-2"><input class="form-control" type="date" name="fecha" value="@DateTime.Today.ToString("yyyy-MM-dd")" aria-label="Fecha" /></div>
                <div class="col-md-2"><button class="btn btn-primary w-100">Guardar</button></div>
                <div class="col-12"><input class="form-control" name="detalle" maxlength="300" placeholder="Detalle (opcional): ej. 2º lugar entre 8 colegios" aria-label="Detalle" /></div>
            </div>
            <small class="text-muted">Si ganan algo, AUKA felicita a los integrantes. Las derrotas no se muestran: solo sirven para darles ánimo.</small>
        </form>
    }
    @if (ganados.Count == 0)
    {
        <p class="text-muted small mb-0">Aún no hay trofeos ni medallas. ¡A entrenar!</p>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var l in ganados)
            {
                var r = Auka.Web.Services.Clubes.Resultado(l.Resultado);
                <div class="d-flex align-items-center gap-2 p-2" style="border-radius:14px;background:#fff8e6">
                    <span style="font-size:1.4rem">@r.Icono</span>
                    <div class="flex-grow-1"><b>@l.Evento</b><br /><small class="text-muted">@r.Nombre · @l.Fecha.ToString("dd-MM-yyyy")@(l.Detalle != null ? " · " + l.Detalle : "")</small></div>
                    @if (puedeLogros)
                    {
                        <form asp-action="QuitarLogro" method="post" class="m-0" data-c="¿Quitar este logro?" onsubmit="return confirm(this.dataset.c);">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@l.Id" />
                            <button class="btn btn-sm btn-link text-danger" aria-label="Quitar">✕</button>
                        </form>
                    }
                </div>
            }
        </div>
    }
</div>

@if (puede && !lleno)
{
    <script>
        (function () {
            var q = document.getElementById('taQ'), res = document.getElementById('taRes'), msg = document.getElementById('taMsg'), t = null;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
            var cur = document.getElementById('taCurso');
            var buscar = function () {
                var v = q.value.trim(), c = cur.value;
                if (v.length < 2 && !c) { res.classList.remove('on'); return; }
                fetch('/Talleres/BuscarAlumnos?tallerId=@Model.Id&q=' + encodeURIComponent(v) + (c ? '&cursoId=' + c : ''), { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (l) {
                        res.classList.add('on');
                        if (!l.length) { res.innerHTML = '<div class="ta-op text-muted">No encontramos alumnos/as con ese nombre o RUT.</div>'; return; }
                        var libres = l.filter(function (a) { return !a.inscrito; }).length;
                        res.innerHTML = (c ? '<div class="ta-todos"><span>' + l.length + ' alumnos/as del curso · ' + libres + ' sin inscribir</span></div>' : '') + l.map(function (a) {
                            return '<div class="ta-op"><div class="d"><b>' + esc(a.nombre) + '</b><br><small>' + esc(a.curso) + ' · ' + esc(a.rut) + '</small></div>' +
                                (a.inscrito ? '<span class="au-chip verde">Ya inscrito/a</span>' : '<button type="button" class="btn btn-warning btn-sm px-3" data-ins="' + a.id + '">Inscribir</button>') + '</div>';
                        }).join('');
                    });
            };
            q.addEventListener('input', function () { clearTimeout(t); t = setTimeout(buscar, 250); });
            cur.addEventListener('change', buscar);
            res.addEventListener('click', function (e) {
                var b = e.target.closest('[data-ins]'); if (!b) return;
                b.disabled = true; b.textContent = 'Inscribiendo…';
                var fd = new FormData(); fd.append('tallerId', '@Model.Id'); fd.append('estudianteId', b.getAttribute('data-ins')); fd.append('__RequestVerificationToken', token);
                fetch('/Talleres/Inscribir', { method: 'POST', body: fd, credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (d.ok) { location.reload(); }
                        else { msg.innerHTML = '<div class="alert alert-danger py-2">' + esc(d.error) + '</div>'; b.disabled = false; b.textContent = 'Inscribir'; }
                    });
            });
        })();
    </script>
}

@if (puedeEditar)
{
    <div class="modal fade" id="mHorClub" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <form class="modal-content" asp-action="GuardarHorarioClub" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header"><h5 class="modal-title fw-bold">🗓️ Horario de «@Model.Nombre»</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
                <div class="modal-body">
                    @await Html.PartialAsync("_HorarioClub", Model)
                    <div class="alert alert-info small mt-3 mb-0">Si el nuevo horario choca con las clases de algún integrante (las clases mandan), con otro club en el mismo lugar o con el profesor/a, no se guarda y te dice quién. Al guardar, se avisa al profesor/a y a los integrantes.</div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary px-4">💾 Guardar</button></div>
            </form>
        </div>
    </div>
}

@* Auka.Web/Views/Contacto/Gracias.cshtml *@
@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gracias - AUKA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root{--a-navy:#1a319b;--a-blue:#2459b0;--a-teal:#1fb5c5;--a-ink:#14233a;--a-mut:#5d6f86;--a-line:#e3eaf4}
        body{background:linear-gradient(135deg,#f3f7fc 0%,#e4f8fa 100%);color:var(--a-ink);min-height:100vh;padding:1.2rem}
        .box{background:#fff;border:1px solid var(--a-line);border-radius:22px;max-width:640px;margin:1rem auto;overflow:hidden;box-shadow:0 10px 30px rgba(20,35,58,.08)}
        .top{background:linear-gradient(120deg,#1a319b,#2459b0 55%,#1fb5c5);color:#fff;padding:1.4rem 1.6rem;display:flex;align-items:center;gap:.8rem}
        .top img{height:38px}.top b{font-size:1.4rem;letter-spacing:.04em}
        .au-btn{background:linear-gradient(120deg,var(--a-navy),var(--a-blue));color:#fff;border:0;border-radius:999px;font-weight:700;padding:.6rem 1.6rem;text-decoration:none;display:inline-block}
        .au-btn:hover{color:#fff;filter:brightness(1.08)}
        .form-control,.form-select{border-radius:12px}label{font-size:.78rem;font-weight:700;color:var(--a-mut)}
    </style>
</head>
<body>
    <div class="box">
        <div class="top"><img src="~/img/auka-icono.png" alt="AUKA" /><b>AUKA</b></div>
        <div class="p-4">
            <h4 class="fw-bold mb-2">¡Gracias! 💙</h4>
            <p class="text-secondary mb-3">Recibimos tu mensaje y te responderemos al correo que dejaste.</p>
            <a class="au-btn" href="~/Contacto">Enviar otro mensaje</a>
        </div>
    </div>
</body>
</html>

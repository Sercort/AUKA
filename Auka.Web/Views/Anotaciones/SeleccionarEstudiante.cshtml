@* Auka.Web/Views/Anotaciones/SeleccionarEstudiante.cshtml — alumnos/as del curso con sus anotaciones del año *@
@model List<Auka.Web.Controllers.AlumnoAnotVm>
@{
    var curso = ViewBag.Curso as Auka.Application.Entities.Curso;
    ViewData["Title"] = $"Anotaciones · {curso?.Nombre} {curso?.Letra}";
    var colores = new[] { "#1a319b", "#2459b0", "#1fb5c5", "#2bb673", "#6c5ce7", "#fb8500", "#ef6f6c" };
    var pos = Model.Sum(a => a.Positivas);
    var neg = Model.Sum(a => a.Negativas);
    var conNeg = Model.Count(a => a.Negativas > 0);
}
<style>
    .ae-res { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 14px; }
    .ae-res .au-card { padding: 14px 18px; }
    .ae-res small { display: block; font-size: .7rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; color: var(--a-mut); }
    .ae-res b { font-size: 1.6rem; font-weight: 900; }
    .ae-fil { display: flex; gap: .45rem; flex-wrap: wrap; margin-bottom: 12px; }
    .ae-fil button { border: 1.5px solid var(--a-line); background: #fff; border-radius: 999px; padding: .4rem .95rem; font-weight: 800; font-size: .85rem; color: var(--a-mut); }
    .ae-fil button.on { background: var(--a-grad-violet); color: #fff; border-color: transparent; }
    .aa { display: flex; align-items: center; gap: .9rem; padding: .75rem .9rem; border-radius: 16px; text-decoration: none; color: var(--a-ink); transition: background .2s; border-left: 4px solid transparent; }
    .aa:hover { background: #f5f9ff; color: var(--a-ink); }
    .aa.neg { border-left-color: var(--a-coral); }
    .aa + .aa { margin-top: 2px; }
    .aa .n { width: 26px; text-align: right; color: var(--a-mut); font-weight: 800; font-size: .8rem; }
    .aa .av { width: 42px; height: 42px; border-radius: 13px; display: grid; place-items: center; color: #fff; font-weight: 900; flex-shrink: 0; }
    .aa .d { flex: 1; min-width: 0; }
    .aa small { color: var(--a-mut); }
    .aa .cero { opacity: .45; }
    @@media (max-width: 640px) { .ae-res { grid-template-columns: 1fr 1fr; } }
</style>

<div class="au-head violeta">
    <div class="ico">📒</div>
    <div class="txt">
        <h2>Anotaciones · @curso?.Nombre @curso?.Letra</h2>
        <p>Toca a un alumno/a para ver su hoja de vida o registrar una anotación.</p>
    </div>
    <div class="acc"><a asp-action="Index">Volver a cursos</a></div>
</div>

<div class="ae-res">
    <div class="au-card"><small>Positivas del curso</small><b style="color:#12744a">👍 @pos</b></div>
    <div class="au-card"><small>Negativas del curso</small><b style="color:#a12d2a">⚠️ @neg</b></div>
    <div class="au-card"><small>Alumnos/as con negativas</small><b style="color:var(--a-navy)">@conNeg <span style="font-size:.9rem;color:var(--a-mut)">de @Model.Count</span></b></div>
</div>

<div class="ae-fil" id="aeF">
    <button type="button" class="on" data-f="">Todos</button>
    <button type="button" data-f="neg">⚠️ Con negativas</button>
    <button type="button" data-f="pos">👍 Con positivas</button>
</div>

<div class="au-card p-2">
    @if (Model.Count == 0)
    {
        <div class="au-vacio"><span class="e">🎒</span>Este curso aún no tiene alumnos/as.</div>
    }
    @for (var k = 0; k < Model.Count; k++)
    {
        var a = Model[k];
        var ini = (a.Nombre.Length > 0 ? a.Nombre[..1] : "") + (a.Apellido.Length > 0 ? a.Apellido[..1] : "");
        <a class="aa @(a.Negativas > 0 ? "neg" : "")" asp-action="Index" asp-route-estudianteId="@a.Id" data-neg="@a.Negativas" data-pos="@a.Positivas">
            <span class="n">@(k + 1)</span>
            <span class="av" style="background:@colores[k % colores.Length]">@ini.ToUpper()</span>
            <div class="d"><b>@a.Apellido, @a.Nombre</b><br /><small>@a.Rut</small></div>
            <span class="au-chip verde @(a.Positivas == 0 ? "cero" : "")">👍 @a.Positivas</span>
            <span class="au-chip coral @(a.Negativas == 0 ? "cero" : "")">⚠️ @a.Negativas</span>
        </a>
    }
</div>

<script>
    (function () {
        var f = document.getElementById('aeF');
        f.addEventListener('click', function (e) {
            var b = e.target.closest('button[data-f]'); if (!b) return;
            f.querySelectorAll('button').forEach(function (x) { x.classList.toggle('on', x === b); });
            var k = b.getAttribute('data-f');
            document.querySelectorAll('.aa').forEach(function (r) {
                r.style.display = !k || +r.getAttribute('data-' + k) > 0 ? '' : 'none';
            });
        });
    })();
</script>

@model IEnumerable<Auka.Application.Entities.Anotacion>

@{
    ViewData["Title"] = "Mi Libro de Anotaciones";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">📝 Mi Libro de Anotaciones</h2>
            <p class="text-muted mb-0">Registro personal e confidencial de observaciones de conducta y méritos.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Volver al Panel</a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-primary text-center">
                        <tr>
                            <th style="width: 130px;">Fecha</th>
                            <th style="width: 120px;">Tipo</th>
                            <th class="text-start">Detalle / Observación</th>
                            <th style="width: 220px;">Registrado por</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    🌟 ¡Excelente! No tienes anotaciones registradas en tu hoja de vida.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                var esPositiva = item.Tipo.ToString().ToLower().Contains("positiva");
                                <tr>
                                    <td class="text-center"><small class="fw-bold">@item.Fecha.ToString("dd/MM/yyyy")</small></td>
                                    <td class="text-center">
                                        <span class="badge @(esPositiva ? "bg-success" : "bg-danger") rounded-pill px-3">
                                            @(esPositiva ? "👍 Positiva" : "⚠️ Negativa")
                                        </span>
                                    </td>
                                    <td class="text-start">@item.Detalle</td>
                                    <td class="text-center"><small class="text-muted">👨‍🏫 @item.Docente?.Nombre @item.Docente?.Apellido</small></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@* Auka.Web/Views/Anotaciones/SeleccionarCurso.cshtml — libro de anotaciones: primero se elige el curso *@
@model List<Auka.Web.Controllers.CursoAnotVm>
@{
    ViewData["Title"] = "Anotaciones";
    var estados = ViewBag.Estados as Dictionary<int, Auka.Web.Services.Alertas.EstadoCurso> ?? new();
    string? Est(int id) => estados.TryGetValue(id, out var e) ? e.Nivel switch
    {
        Auka.Web.Services.Alertas.Nivel.Alerta => "alerta", Auka.Web.Services.Alertas.Nivel.Atencion => "atencion",
        Auka.Web.Services.Alertas.Nivel.Destacado => "destacado", _ => null
    } : null;
    var enAlerta = estados.Values.Where(e => e.Nivel == Auka.Web.Services.Alertas.Nivel.Alerta).ToList();
    var destacados = estados.Values.Where(e => e.Nivel == Auka.Web.Services.Alertas.Nivel.Destacado).ToList();
    var tonos = new[] { "t1", "t2", "t3", "t4", "t5", "t6" };
}
<style>
    .an-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; }
    .an { border-radius: 20px; padding: 18px; color: #fff; text-decoration: none; position: relative; overflow: hidden; min-height: 140px; display: flex; flex-direction: column; transition: transform .2s, box-shadow .2s; box-shadow: 0 8px 20px rgba(20,35,58,.12); }
    .an:hover { transform: translateY(-4px); box-shadow: 0 18px 34px rgba(20,35,58,.2); color: #fff; }
    .an::after { content: ""; position: absolute; right: -35px; bottom: -45px; width: 130px; height: 130px; border-radius: 50%; background: rgba(255,255,255,.14); }
    .an h4 { font-size: 1.2rem; font-weight: 900; margin: 0; }
    .an .al { font-size: .82rem; opacity: .92; }
    .an .pie { margin-top: auto; display: flex; gap: .45rem; flex-wrap: wrap; position: relative; z-index: 1; }
    .an .pie span { background: rgba(255,255,255,.95); border-radius: 999px; padding: .25rem .7rem; font-size: .78rem; font-weight: 800; }
    .an .pos { color: #12744a; } .an .neg { color: #a12d2a; }
    .t1 { background: linear-gradient(135deg, #1a319b, #2459b0); } .t2 { background: linear-gradient(135deg, #2459b0, #1fb5c5); }
    .t3 { background: linear-gradient(135deg, #0f8a99, #2bb673); } .t4 { background: linear-gradient(135deg, #4b3fb8, #7c6cf0); }
    .t5 { background: linear-gradient(135deg, #e08a00, #fb8500); } .t6 { background: linear-gradient(135deg, #d9534f, #ef8f6c); }
</style>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="au-head violeta">
    <div class="ico">📒</div>
    <div class="txt">
        <h2>Libro de anotaciones</h2>
        <p>Abre un nivel, elige el curso y verás las anotaciones de cada alumno/a.</p>
    </div>
    @if (User.IsInRole("UTP") || User.IsInRole("Director") || User.IsInRole("SuperAdmin"))
    {
        <div class="acc">
            <button type="button" data-bs-toggle="modal" data-bs-target="#mImpAnot">📥 Importar anotaciones</button>
        </div>
    }
</div>

@if (enAlerta.Count > 0)
{
    <div class="alert alert-danger mb-2"><b>🔴 @enAlerta.Count @(enAlerta.Count == 1 ? "curso en alerta" : "cursos en alerta"):</b> @string.Join(" · ", enAlerta.Select(e => e.Curso + " (" + e.Negativas + " negativas)"))</div>
}
@if (destacados.Count > 0)
{
    <div class="alert alert-success mb-2"><b>⭐ @(destacados.Count == 1 ? "Curso destacado" : "Cursos destacados"):</b> @string.Join(" · ", destacados.Select(e => e.Curso))</div>
}
<div class="d-flex gap-2 flex-wrap mb-3">
    <span class="au-chip verde">👍 @Model.Sum(c => c.Positivas30) positivas</span>
    <span class="au-chip coral">⚠️ @Model.Sum(c => c.Negativas30) negativas</span>
    <span class="au-chip">este año</span>
</div>

@if (Model.Count == 0)
{
    <div class="au-card au-vacio"><span class="e">📒</span><b>Aún no hay cursos este año.</b></div>
}
else
{
    var carpetas = new Auka.Web.Models.CarpetasVm
    {
        Clave = "anotaciones",
        Cursos = Model.Select(c => new Auka.Web.Models.CarpetaCurso(c.Id, c.Nombre, c.Letra, Url.Action("Index", new { cursoId = c.Id })!,
            c.Alumnos, 0, null, "👍 " + c.Positivas30, "⚠️ " + c.Negativas30, c.Positivas30, c.Negativas30,
            Est(c.Id), estados.TryGetValue(c.Id, out var es) ? es.Motivo : null)).ToList()
    };
    @await Html.PartialAsync("_CursosCarpetas", carpetas)
}

@if (User.IsInRole("UTP") || User.IsInRole("Director") || User.IsInRole("SuperAdmin"))
{
    <div class="modal fade" id="mImpAnot" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <form class="modal-content" asp-action="Importar" method="post" enctype="multipart/form-data" onsubmit="var b=this.querySelector('button.btn-primary'); if(b.disabled) return false; b.disabled=true; b.textContent='Importando… no cierres'; return true;">
                @Html.AntiForgeryToken()
                <div class="modal-header"><h5 class="modal-title fw-bold">📥 Importar anotaciones desde Excel</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
                <div class="modal-body">
                    <ol class="mb-3">
                        <li>Descarga la plantilla y llénala en Excel: <b>una fila por anotación</b>.</li>
                        <li>Tipo: <b>Positiva</b> o <b>Negativa</b>. El RUT del profesor/a es opcional (si no va, queda a tu nombre).</li>
                        <li>Guárdala como <b>CSV</b> (punto y coma) y súbela aquí.</li>
                    </ol>
                    <button type="button" class="btn btn-outline-primary btn-sm px-3 mb-3" id="anPlantilla">📄 Descargar plantilla</button>
                    <input type="file" name="archivo" accept=".csv" class="form-control" required />
                    <small class="text-muted d-block mt-2">Se cruza por RUT y no duplica: si la misma anotación (alumno/a, tipo, detalle y día) ya existe, se salta. No se envían avisos a los apoderados/as porque es historial.</small>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary px-4">Importar</button></div>
            </form>
        </div>
    </div>
    <script>
        document.getElementById('anPlantilla').addEventListener('click', function () {
            var csv = '\ufeffRUT alumno;Tipo;Detalle;Fecha;RUT profesor\r\n' +
                '24.123.456-8;Positiva;Ayuda a sus compañeros en clases;12-03-2026;\r\n' +
                '24.123.456-8;Negativa;No trae materiales;20-03-2026;\r\n';
            var a = document.createElement('a');
            a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
            a.download = 'plantilla_anotaciones_auka.csv'; document.body.appendChild(a); a.click(); a.remove();
        });
    </script>
}

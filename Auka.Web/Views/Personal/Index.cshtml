@using Auka.Application.Entities
@model IEnumerable<Usuario>

@{
    ViewData["Title"] = "Personal y Equipo Docente";
    string tabActual = ViewBag.TabActual ?? "activos";
}

<div class="container py-4">
    <!-- ENCABEZADO Y BOTÓN DE REGISTRO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1">👥 Personal y Equipo Docente - AUKA</h3>
            <p class="text-muted small mb-0">Administración de Directivos, UTP, Docentes, Inspectores y Dupla Psicosocial.</p>
        </div>
        <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#modalAgregarPersonal">
            ➕ Agregar Funcionario
        </button>
    </div>

    <!-- ALERTAS Y NOTIFICACIONES -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- FILTROS Y BÚSQUEDA -->
    <div class="card border-0 shadow-sm mb-4 rounded-4">
        <div class="card-body p-3">
            <div class="row align-items-center g-3">
                <div class="col-md-6">
                    <ul class="nav nav-pills">
                        <li class="nav-item">
                            <a class="nav-link @(tabActual == "activos" ? "active" : "") fw-bold" asp-action="Index" asp-route-tab="activos">
                                🟢 Personal Activo (@Model.Count(u => u.Activo))
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(tabActual == "inactivos" ? "active text-danger" : "") fw-bold" asp-action="Index" asp-route-tab="inactivos">
                                🔴 Inactivos / Ex-funcionarios (@Model.Count(u => !u.Activo))
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <form method="get" asp-action="Index">
                        <input type="hidden" name="tab" value="@tabActual" />
                        <div class="input-group">
                            <input type="text" name="search" class="form-control" placeholder="Buscar por RUT, Nombre, Apellido, Email, Teléfono..." value="@ViewBag.SearchTerm" />
                            <button class="btn btn-outline-primary fw-bold" type="submit">🔍 Buscar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLA PRINCIPAL DE PERSONAL -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">RUT</th>
                            <th>Nombre Completo</th>
                            <th>Rol / Cargo</th>
                            <th>Asignaturas Impartidas</th>
                            <th>Correo de Acceso (AUKA)</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <em>No se encontraron funcionarios registrados en esta sección.</em>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-primary fw-bold">@item.Rut</td>
                                    <td>
                                        <div class="fw-bold text-dark">
                                            @item.Nombre @item.Apellido
                                            @if (item.EsInspectorGeneral)
                                            {
                                                <span class="badge bg-primary ms-1">⭐ Inspector General</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@item.Rol</span>
                                        @if (!string.IsNullOrEmpty(item.CargoInstitucional))
                                        {
                                            <div class="small text-muted fw-semibold mt-1">@item.CargoInstitucional</div>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Asignaturas))
                                        {
                                            <span class="badge bg-info text-dark">📖 @item.Asignaturas</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><em>Sin asignar</em></span>
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark"><code>@item.Email</code></span>
                                        @if (!string.IsNullOrEmpty(item.EmailPersonal))
                                        {
                                            <div class="small text-muted">Respaldo: @item.EmailPersonal</div>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Activo)
                                        {
                                            <span class="badge bg-success rounded-pill px-3">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger rounded-pill px-3">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <!-- BOTÓN EDITAR AGREGADO -->
                                            <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold">
                                                ✏️ Editar
                                            </a>

                                            @if (item.Activo)
                                            {
                                                @if (item.Rol == RolUsuario.Inspector && !item.EsInspectorGeneral)
                                                {
                                                    <form asp-action="AsignarInspectorGeneral" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-2">
                                                            ⭐ Hacer General
                                                        </button>
                                                    </form>
                                                }
                                                <form asp-action="Desactivar" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Está seguro de pasar a Inactivos a este funcionario?');" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                                        🚫 Dar de Baja
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Reactivar" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-success btn-sm rounded-pill px-3">
                                                        🔄 Reactivar
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: REGISTRAR NUEVO FUNCIONARIO -->
<div class="modal fade" id="modalAgregarPersonal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">➕ Agregar Funcionario al Establecimiento</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">RUT (Formato: 12345678-9)*</label>
                            <input type="text" name="rut" class="form-control" placeholder="12345678-9" pattern="^[0-9]+-[0-9kK]{1}$" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Rol / Cargo Institucional*</label>
                            <select name="rol" id="selectRolModal" class="form-select" onchange="actualizarFormularioModal()" required>
                                <option value="">-- Seleccionar Rol --</option>
                                <option value="Docente">Docente / Profesor</option>
                                <option value="Director">Director / Directora</option>
                                <option value="UTP">Jefe / Coordinador UTP</option>
                                <option value="Inspector">Inspector / Convivencia</option>
                                <option value="Psicologo">Psicólogo/a Escolar</option>
                                <option value="Psicopedagogo">Psicopedagogo/a (PIE)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Nombres*</label>
                            <input type="text" name="nombre" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Apellidos*</label>
                            <input type="text" name="apellido" class="form-control" required />
                        </div>

                        <!-- CORREO INSTITUCIONAL DE INGRESO -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-primary">Correo Institucional (Acceso AUKA)*</label>
                            <input type="email" name="emailInstitucional" class="form-control border-primary" placeholder="nombre.apellido@colegio.cl" required />
                            <small class="text-muted">Este correo será el usuario para iniciar sesión.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Correo Personal (Respaldo)</label>
                            <input type="email" name="emailPersonal" class="form-control" placeholder="personal@gmail.com" />
                            <small class="text-muted">Para recuperación de clave en caso de olvido.</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Teléfono de Contacto</label>
                            <input type="tel" name="telefono" class="form-control" placeholder="+56912345678" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Dirección</label>
                            <input type="text" name="direccion" class="form-control" placeholder="Av. Principal #123" />
                        </div>

                        <!-- ASIGNATURA O TALLER DENTRO DE LA BD -->
                        <div class="col-md-12" id="divAsignaturasModal" style="display:none;">
                            <label class="form-label fw-bold text-success">Asignaturas o Clubes/Talleres que Impartirá</label>
                            <input type="text" name="asignaturasImpartidas" class="form-control border-success" placeholder="Ej: Matemática, Física, Taller de Robótica" />
                            <small class="text-muted">Se registrarán automáticamente en el catálogo general si son asignaturas nuevas.</small>
                        </div>

                        <!-- INSPECTOR GENERAL -->
                        <div class="col-md-6" id="divInspectorGeneralModal" style="display:none;">
                            <div class="form-check mt-4">
                                <input class="form-check-input" type="checkbox" name="esInspectorGeneral" value="true" id="chkInspectorGen">
                                <label class="form-check-label fw-bold text-primary" for="chkInspectorGen">
                                    ⭐ Designar como Inspector General
                                </label>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="alert alert-info py-2 mb-0" role="alert">
                                <small>🔒 <strong>Clave Inicial:</strong> La contraseña asignada por defecto será <code>123456</code>. El sistema solicitará un cambio obligatorio al iniciar sesión.</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-bold">Guardar Funcionario</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function actualizarFormularioModal() {
        var rol = document.getElementById("selectRolModal").value;
        var divAsig = document.getElementById("divAsignaturasModal");
        var divInsp = document.getElementById("divInspectorGeneralModal");

        if (rol === "Docente") {
            divAsig.style.display = "block";
            divInsp.style.display = "none";
        } else if (rol === "Inspector") {
            divAsig.style.display = "none";
            divInsp.style.display = "block";
        } else {
            divAsig.style.display = "none";
            divInsp.style.display = "none";
        }
    }
</script>
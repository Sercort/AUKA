@model Auka.Application.Entities.Usuario
@{
    ViewData["Title"] = "Editar Funcionario";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white py-3 rounded-top-4">
                    <h4 class="mb-0 fw-bold">✏️ Editar Funcionario / Docente</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }
                    @* Acciones rápidas: clave provisoria y horario (también se llega aquí desde el buscador de arriba) *@
                    <div class="d-flex gap-2 flex-wrap mb-4 p-3 rounded-4" style="background:#f4f7fc">
                        <form asp-action="RestablecerClave" asp-route-id="@Model.Id" method="post" class="m-0" onsubmit="return confirm('Se generará una clave provisoria nueva y la anterior dejará de servir. ¿Continuar?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="volver" value="editar" />
                            <button class="btn btn-warning rounded-pill px-4 fw-bold">🔑 Crear clave provisoria</button>
                        </form>
                        @if (Model.Rol == Auka.Application.Entities.RolUsuario.Docente || Model.Rol == Auka.Application.Entities.RolUsuario.UTP || Model.Rol == Auka.Application.Entities.RolUsuario.Director)
                        {
                            <a href="/Horarios/Profesor/@Model.Id" class="btn btn-outline-primary rounded-pill px-4">🗓️ Ver su horario</a>
                        }
                        <a href="/Personal?ver=@Uri.EscapeDataString(Model.Rut)" class="btn btn-outline-secondary rounded-pill px-4">👥 Ir al listado del personal</a>
                        <small class="text-muted w-100">La clave provisoria se muestra una sola vez: anótala y entrégasela. Al entrar, AUKA le pide cambiarla.</small>
                    </div>
                    <form asp-action="Editar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <!-- DATOS DE ACCESO DE SOLO LECTURA -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">RUT (Solo Lectura)</label>
                                <input type="text" class="form-control bg-light" value="@Model.Rut" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Correo Institucional (Acceso Auka)</label>
                                <input type="text" class="form-control bg-light" value="@Model.Email" readonly />
                            </div>
                        </div>

                        <!-- NOMBRES Y APELLIDOS -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Nombre*</label>
                                <input type="text" name="nombre" class="form-control" value="@Model.Nombre" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Apellido*</label>
                                <input type="text" name="apellido" class="form-control" value="@Model.Apellido" required />
                            </div>
                        </div>

                        <hr />

                        <!-- ROL, CARGO Y ASIGNATURAS -->
                        <h5 class="fw-bold text-primary mb-3">📚 Perfil, Cargo y Asignaturas</h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Rol en el Sistema</label>
                                <select name="rol" class="form-select" asp-for="Rol" asp-items="Html.GetEnumSelectList<Auka.Application.Entities.RolUsuario>()"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Cargo Institucional Específico</label>
                                <input type="text" name="cargoEspecifico" class="form-control" value="@Model.CargoInstitucional" placeholder="Ej: Inspector General, Coordinador PIE, Docente Titular" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Asignaturas o Talleres que Imparte</label>
                            <input type="text" name="asignaturasImpartidas" class="form-control" value="@Model.Asignaturas" placeholder="Ej: Matemática, Lenguaje, Física, Taller de Teatro" />
                            <small class="text-muted d-block mt-1">Escribe las asignaturas o talleres separados por comas.</small>
                        </div>

                        <hr />

                        <!-- CONTACTO Y UBICACIÓN -->
                        <h5 class="fw-bold text-primary mb-3">📞 Teléfono y Datos de Contacto</h5>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Teléfono / Celular de Contacto</label>
                                <input type="tel" name="telefono" class="form-control" value="@Model.Telefono" placeholder="+56 9 1234 5678" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Correo Personal (Recuperación)</label>
                                <input type="email" name="emailPersonal" class="form-control" value="@Model.EmailPersonal" placeholder="usuario@gmail.com" />
                            </div>
                            <div class="col-md-12 mt-3">
                                <label class="form-label fw-semibold">Dirección de Domicilio</label>
                                <input type="text" name="direccion" class="form-control" value="@Model.Direccion" placeholder="Av. Principal #123, Antofagasta" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
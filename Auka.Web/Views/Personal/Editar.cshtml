@model Auka.Application.Entities.Usuario

@{
    ViewData["Title"] = "Editar Funcionario";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-danger text-white py-3 rounded-top-4">
                    <h4 class="mb-0 fw-bold">✏️ Editar Funcionario / Docente</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Editar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">RUT (Solo lectura)</label>
                                <input type="text" class="form-control bg-light" value="@Model.Rut" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Correo Institucional (Login)</label>
                                <input type="text" class="form-control bg-light" value="@Model.Email" readonly />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Nombre</label>
                                <input type="text" name="nombre" class="form-control" value="@Model.Nombre" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Apellido</label>
                                <input type="text" name="apellido" class="form-control" value="@Model.Apellido" required />
                            </div>
                        </div>

                        <hr />

                        <h5 class="fw-bold text-danger mb-3">📚 Cargo y Asignaturas</h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Rol del Sistema</label>
                                <select name="rol" class="form-select" asp-for="Rol" asp-items="Html.GetEnumSelectList<Auka.Application.Entities.RolUsuario>()"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Cargo Institucional Libre</label>
                                <input type="text" name="cargoInstitucional" class="form-control" value="@Model.CargoInstitucional" placeholder="Ej: Inspector General, Jefe UTP" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Asignaturas que Imparte</label>
                            <input type="text" name="asignaturas" class="form-control" value="@Model.Asignaturas" placeholder="Ej: Matemáticas, Programación C#, Física" />
                            <small class="text-muted d-block mt-1">Escribe las asignaturas separadas por coma.</small>
                        </div>

                        <hr />

                        <h5 class="fw-bold text-danger mb-3">📞 Contacto y Respaldo</h5>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Correo Personal (Recuperación)</label>
                                <input type="email" name="emailPersonal" class="form-control" value="@Model.EmailPersonal" placeholder="docente@gmail.com" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Teléfono de Contacto</label>
                                <input type="tel" name="telefono" class="form-control" value="@Model.Telefono" placeholder="+56 9 1234 5678" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
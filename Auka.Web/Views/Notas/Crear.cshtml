@model Auka.Application.Entities.Calificacion

@{
    ViewData["Title"] = "Ingresar Nota";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-info text-white py-3">
                    <h4 class="mb-0 fw-bold">📝 Registrar Calificación</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post">

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Estudiante</label>
                            <select asp-for="EstudianteId" class="form-select" asp-items="ViewBag.Estudiantes" required>
                                <option value="">-- Seleccione Estudiante --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Asignatura</label>
                            <select asp-for="AsignaturaId" class="form-select" asp-items="ViewBag.Asignaturas" required>
                                <option value="">-- Seleccione Asignatura --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Descripción / Nombre de Evaluacion</label>
                            <input asp-for="Descripcion" class="form-control" placeholder="Ej: Prueba Coeficiente 1 - Álgebra" required />
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Nota (Format 1.0 a 7.0)</label>
                                <input asp-for="Nota" type="number" step="0.1" min="1.0" max="7.0" class="form-control" placeholder="6.5" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Ponderación (%)</label>
                                <input asp-for="Ponderacion" type="number" step="1" min="1" max="100" class="form-control" placeholder="20" required />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Volver al Libro de Notas</a>
                            <button type="submit" class="btn btn-info text-white rounded-pill px-4 fw-bold">Guardar Nota</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
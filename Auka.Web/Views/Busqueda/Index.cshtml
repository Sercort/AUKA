@model Auka.Web.Controllers.BusquedaResultadoViewModel

@{
    ViewData["Title"] = "Resultados de Búsqueda";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold text-primary">🔍 Resultados de Búsqueda</h2>
        @if (!string.IsNullOrEmpty(Model.Query))
        {
            <p class="text-muted">Mostrando resultados para: <strong class="text-dark">"@Model.Query"</strong></p>
        }
    </div>

    @if (!Model.TieneResultados)
    {
        <div class="card shadow-sm border-0 rounded-3 text-center py-5">
            <div class="card-body">
                <div class="fs-1 text-muted mb-3">🔍❌</div>
                <h4 class="fw-bold text-secondary mb-2">Campo o registro no encontrado</h4>
                <p class="text-muted">No encontramos coincidencias para "<strong>@Model.Query</strong>". Verifica el nombre, RUT o término e intenta de nuevo.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 mt-2">Volver al Inicio</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- 1. Estudiantes Encontrados -->
            @if (Model.Estudiantes.Any())
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-primary text-white font-semibold py-2">
                            🎓 Estudiantes Encontrados (@Model.Estudiantes.Count)
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>RUT</th>
                                        <th>Estudiante</th>
                                        <th>Curso Actual</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var est in Model.Estudiantes)
                                    {
                                        <tr>
                                            <td><code>@est.Usuario?.Rut</code></td>
                                            <td><strong>@est.Usuario?.Nombre @est.Usuario?.Apellido</strong></td>
                                            <td><span class="badge bg-info text-white">@est.Curso?.Nombre "@est.Curso?.Letra"</span></td>
                                            <td>
                                                <a asp-controller="Cursos" asp-action="Alumnos" asp-route-id="@est.CursoId" class="btn btn-sm btn-outline-primary rounded-pill">
                                                    Ver en Curso
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- 2. Cursos Encontrados -->
            @if (Model.Cursos.Any())
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-success text-white font-semibold py-2">
                            🏫 Cursos Encontrados (@Model.Cursos.Count)
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Curso</th>
                                        <th>Año</th>
                                        <th>Profesor Jefe</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var curso in Model.Cursos)
                                    {
                                        <tr>
                                            <td><strong>@curso.Nombre "@curso.Letra"</strong></td>
                                            <td>@curso.AnioAcademico</td>
                                            <td>@(curso.ProfesorJefe != null ? $"{curso.ProfesorJefe.Nombre} {curso.ProfesorJefe.Apellido}" : "Sin Asignar")</td>
                                            <td>
                                                <a asp-controller="Cursos" asp-action="Alumnos" asp-route-id="@curso.Id" class="btn btn-sm btn-outline-success rounded-pill">
                                                    Ver Nómina
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- 3. Personal / Docentes Encontrados -->
            @if (Model.Personal.Any())
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-danger text-white font-semibold py-2">
                            👥 Personal / Docentes (@Model.Personal.Count)
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>RUT</th>
                                        <th>Nombre</th>
                                        <th>Cargo / Rol</th>
                                        <th>Correo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.Personal)
                                    {
                                        <tr>
                                            <td><code>@p.Rut</code></td>
                                            <td><strong>@p.Nombre @p.Apellido</strong></td>
                                            <td><span class="badge bg-secondary">@p.Rol</span></td>
                                            <td>@p.Email</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
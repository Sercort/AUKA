@{
    ViewData["Title"] = "Panel Principal";
    var esAdminODirector = User.IsInRole("SuperAdmin") || User.IsInRole("Director") || User.IsInRole("Administrador");
    var esUTP = User.IsInRole("UTP") || esAdminODirector;
    var esDocente = User.IsInRole("Docente");
    var esEstudianteOApoderado = User.IsInRole("Estudiante") || User.IsInRole("Apoderado") || User.IsInRole("Alumno");
}

<div class="container-fluid py-4">
    <!-- Encabezado de Bienvenida -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-primary text-white shadow-sm rounded-3 border-0">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="fw-bold mb-1">¡Hola, @User.Identity?.Name! 👋</h2>
                        <p class="mb-0 text-light">Plataforma de Gestión Escolar AUKA</p>
                    </div>
                    <div>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-light btn-sm rounded-pill px-3">
                            Cerrar Sesión
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Módulos Principales -->
    <div class="row g-4">

        <!-- Módulo 1: Gestión de Personal (SuperAdmin, Director, Administrador) -->
        @if (esAdminODirector)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 border-start border-4 border-danger rounded-3">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title fw-bold text-danger mb-2">👥 Gestión de Personal</h5>
                            <p class="card-text text-muted small">Administración y registro de Docentes, Inspectores, UTP y Directivos.</p>
                        </div>
                        <div class="mt-3">
                            <a asp-controller="Personal" asp-action="Index" class="btn btn-danger btn-sm rounded-pill px-3 fw-semibold w-100">
                                Gestionar Personal
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Módulo 2: Clubes y Talleres (ACLE) -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 border-warning rounded-3">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title fw-bold text-dark mb-2">🏆 Clubes y Talleres (ACLE)</h5>
                        <p class="card-text text-muted small">
                            @if (esAdminODirector)
                            {
                                <span>Creación de talleres y asignación de profesores.</span>
                            }
                            else if (esDocente)
                            {
                                <span>Gestión de tus talleres asignados y nómina de alumnos.</span>
                            }
                            else
                            {
                                <span>Consulta e inscripción de talleres extraprogramáticos.</span>
                            }
                        </p>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Talleres" asp-action="Index" class="btn btn-warning text-dark btn-sm rounded-pill px-3 fw-semibold w-100">
                            Ver Clubes y Talleres
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Módulo 3: Matrícula y Cursos (UTP, Director, SuperAdmin) -->
        @if (esUTP)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 border-start border-4 border-primary rounded-3">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title fw-bold text-primary mb-2">🏫 Matrícula y Cursos</h5>
                            <p class="card-text text-muted small">Ingreso de alumnos, asignación de cursos y listas por nivel.</p>
                        </div>
                        <div class="mt-3">
                            <a asp-controller="Cursos" asp-action="Index" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold w-100">
                                Ver Cursos y Alumnos
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Módulo 4: Calendario de Evaluaciones -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 border-success rounded-3">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title fw-bold text-success mb-2">📝 Calendario de Evaluaciones</h5>
                        <p class="card-text text-muted small">Fechas de pruebas y temarios organizados por curso y asignatura.</p>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Evaluaciones" asp-action="Index" class="btn btn-success btn-sm rounded-pill px-3 fw-semibold w-100">
                            Ver Evaluaciones
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Módulo 5: Libro de Notas -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 border-info rounded-3">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title fw-bold text-info mb-2">📊 Libro de Notas</h5>
                        <p class="card-text text-muted small">
                            @if (esDocente)
                            {
                                <span>Ingreso y edición de calificaciones por asignatura.</span>
                            }
                            else if (esUTP)
                            {
                                <span>Revisión y rectificación de notas por curso.</span>
                            }
                            else if (esEstudianteOApoderado)
                            {
                                <span>Consulta de calificaciones personales.</span>
                            }
                            else
                            {
                                <span>Consulta general de notas.</span>
                            }
                        </p>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Notas" asp-action="Index" class="btn btn-info text-white btn-sm rounded-pill px-3 fw-semibold w-100">
                            Ver Libro de Notas
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Módulo 6: Libro de Anotaciones -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 border-warning rounded-3">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title fw-bold text-dark mb-2">📋 Libro de Anotaciones</h5>
                        <p class="card-text text-muted small">
                            @if (esEstudianteOApoderado)
                            {
                                <span>Consulta confidencial de hoja de vida y observaciones.</span>
                            }
                            else
                            {
                                <span>Registro y consulta de conducta u observaciones institucionales.</span>
                            }
                        </p>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Anotaciones" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-semibold w-100">
                            Ver Anotaciones
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Módulo 7: Horario de Clases -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 border-secondary rounded-3">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold text-dark mb-2">⏰ Horario de Clases</h5>
                        <p class="text-muted small">Distribución semanal de asignaturas por sala y curso.</p>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Horarios" asp-action="Index" class="btn btn-secondary btn-sm rounded-pill px-3 fw-bold text-white w-100">
                            Gestionar Horarios
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
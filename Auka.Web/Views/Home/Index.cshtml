@{
    ViewData["Title"] = "Panel Principal - Dashboard AUKA";
    var esAdminODirector = User.IsInRole("SuperAdmin") || User.IsInRole("Director") || User.IsInRole("Administrador") || User.IsInRole("UTP");
    var esDocente = User.IsInRole("Docente");
    var esEstudianteOApoderado = User.IsInRole("Estudiante") || User.IsInRole("Apoderado") || User.IsInRole("Alumno");
}

<div class="container-fluid py-4">
    <!-- ENCABEZADO PRINCIPAL DE BIENVENIDA -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-primary text-white shadow-sm rounded-4 border-0 p-3">
                <div class="card-body p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="fw-bold mb-1">¡Hola, @User.Identity?.Name! 👋</h2>
                        <p class="mb-0 text-light opacity-75">Plataforma de Gestión Escolar AUKA - Control Ejecutivo Institucional</p>
                    </div>
                    <div>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-light btn-sm rounded-pill px-3">
                            Cerrar Sesión
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (esAdminODirector)
    {
        <!-- 📊 TARJETAS SUPERIORES CON DATOS REALES DE POSTGRESQL -->
        <div class="row g-3 mb-4">
            <!-- 1. Alumnos Matriculados -->
            <div class="col-md-3">
                <a asp-controller="Cursos" asp-action="Index" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-4 border-primary h-100 card-hover">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small fw-bold">ALUMNOS MATRICULADOS</span>
                                <h3 class="fw-bold text-primary mb-0 mt-1">@(ViewBag.TotalAlumnos ?? 0)</h3>
                            </div>
                            <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary fs-3">👨‍🎓</div>
                        </div>
                    </div>
                </a>
            </div>

            <!-- 2. Docentes Activos -->
            <div class="col-md-3">
                <a asp-controller="Personal" asp-action="Index" asp-route-tab="activos" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-4 border-warning h-100 card-hover">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small fw-bold">DOCENTES ACTIVOS</span>
                                <h3 class="fw-bold text-warning mb-0 mt-1">@(ViewBag.TotalDocentes ?? 0)</h3>
                            </div>
                            <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning fs-3">👨‍🏫</div>
                        </div>
                    </div>
                </a>
            </div>

            <!-- 3. Asistencia Global Interactiva -->
            <div class="col-md-3">
                <a asp-controller="Asistencia" asp-action="Index" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-4 border-success h-100 card-hover">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small fw-bold">ASISTENCIA GLOBAL</span>
                                <h3 class="fw-bold text-success mb-0 mt-1">@(ViewBag.AsistenciaPromedioGlobal ?? 0)%</h3>
                            </div>
                            <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success fs-3">📊</div>
                        </div>
                    </div>
                </a>
            </div>

            <!-- 4. Ausentismo Personal -->
            <div class="col-md-3">
                <a asp-controller="Personal" asp-action="Index" asp-route-tab="inactivos" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-4 border-danger h-100 card-hover">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small fw-bold">AUSENTISMO PERSONAL</span>
                                <h3 class="fw-bold text-danger mb-0 mt-1">@(ViewBag.AusenciasPersonalHoy ?? 0)</h3>
                            </div>
                            <div class="bg-danger bg-opacity-10 p-3 rounded-circle text-danger fs-3">⚠️</div>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <!-- 🏫 LISTADO REAL E INTERACTIVO DE CURSOS REGISTRADOS EN POSTGRESQL -->
        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold text-primary mb-0">🏫 Cursos Registrados en la Institución</h5>
                        <a asp-controller="Cursos" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill fw-bold">Ver Todos</a>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <div class="row g-3">
                            @if (ViewBag.CursosLista != null && ((IEnumerable<dynamic>)ViewBag.CursosLista).Any())
                            {
                                @foreach (var curso in ViewBag.CursosLista)
                                {
                                    <div class="col-md-6">
                                        <a asp-controller="Cursos" asp-action="Alumnos" asp-route-id="@curso.Id" class="text-decoration-none">
                                            <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center border-start border-4 border-primary shadow-sm card-hover">
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-1">🏫 @curso.Nombre @curso.Letra</h6>
                                                    <small class="text-muted">Total Matriculados: <strong>@curso.TotalEstudiantes alumnos</strong></small>
                                                </div>
                                                <span class="badge bg-primary rounded-pill px-3 py-2">Ingresar al Curso ➔</span>
                                            </div>
                                        </a>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-12 text-center py-4 text-muted">
                                    <em>No se han registrado cursos en este establecimiento.</em>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- 📂 MÓDULOS DE OPERACIÓN INSTITUCIONAL -->
    <h5 class="fw-bold text-dark mb-3">📂 Módulos de Operación Institucional</h5>
    <div class="row g-4">
        @if (esAdminODirector)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 border-start border-4 border-danger rounded-4">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title fw-bold text-danger mb-2">👥 Gestión de Personal</h5>
                            <p class="card-text text-muted small">Administración y registro de Docentes, Inspectores, UTP, Directivos y Dupla Psicosocial.</p>
                        </div>
                        <div class="mt-3">
                            <a asp-controller="Personal" asp-action="Index" class="btn btn-danger btn-sm rounded-pill px-3 fw-semibold w-100">
                                Gestionar Personal
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 border-warning rounded-4">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title fw-bold text-dark mb-2">🏆 Clubes y Talleres (ACLE)</h5>
                        <p class="card-text text-muted small">Gestión e inscripción de talleres extraprogramáticos.</p>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Talleres" asp-action="Index" class="btn btn-warning text-dark btn-sm rounded-pill px-3 fw-semibold w-100">
                            Ver Clubes y Talleres
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @if (esAdminODirector)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 border-start border-4 border-primary rounded-4">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title fw-bold text-primary mb-2">🏫 Matrícula y Cursos</h5>
                            <p class="card-text text-muted small">Ingreso de alumnos, asignación de cursos y listas por nivel.</p>
                        </div>
                        <div class="mt-3">
                            <a asp-controller="Cursos" asp-action="Index" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold w-100">
                                Ver Cursos y Alumnos
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 border-success rounded-4">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title fw-bold text-success mb-2">📝 Calendario de Evaluaciones</h5>
                        <p class="card-text text-muted small">Fechas de pruebas y temarios organizados por curso y asignatura.</p>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Evaluaciones" asp-action="Index" class="btn btn-success btn-sm rounded-pill px-3 fw-semibold w-100">
                            Ver Evaluaciones
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 border-info rounded-4">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title fw-bold text-info mb-2">📊 Libro de Notas</h5>
                        <p class="card-text text-muted small">Revisión y rectificación de notas por curso y alumno.</p>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Notas" asp-action="Index" class="btn btn-info text-white btn-sm rounded-pill px-3 fw-semibold w-100">
                            Ver Libro de Notas
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 border-secondary rounded-4">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold text-dark mb-2">⏰ Horario de Clases</h5>
                        <p class="text-muted small">Distribución semanal de asignaturas por sala y curso.</p>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Horarios" asp-action="Index" class="btn btn-secondary btn-sm rounded-pill px-3 fw-bold text-white w-100">
                            Gestionar Horarios
                        </a>
                    </div>
                </div>
            </div>
        </div>

       
    </div>
</div>

<style>
    .card-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.1) !important;
        }
</style>
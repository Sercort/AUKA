@* Auka.Web/Views/Shared/_LayoutPsicosocial.cshtml
   Layout del Módulo Psicosocial (equipo): mismos colores del logo que el resto de AUKA.
   No muestra la navegación institucional (Clubes, Evaluaciones, Libro de Notas, Horarios). *@
@{
    var equipo = User.IsInRole("Psicologo") || User.IsInRole("Psicopedagogo") || User.IsInRole("TrabajadorSocial") || User.IsInRole("Orientadora");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AUKA Psicosocial</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Auka.Web.styles.css" asp-append-version="true" />
    @await Html.PartialAsync("_TemaAuka")
</head>
<body>
    <header class="ad-nav">
        <div class="wrap">
            <a class="ad-brand" asp-controller="Psychosocial" asp-action="Index">
                <img src="~/img/auka-icono.png" alt="AUKA" />
                <span><b>AUKA</b><small>PSICOSOCIAL</small></span>
            </a>
            <nav class="ad-links">
                <a class="on" asp-controller="Psychosocial" asp-action="Index">Panel</a>
                <a href="~/Psychosocial#psx">Planilla</a>
                @if (!equipo)
                {
                    <a asp-controller="Home" asp-action="Index">Modo institucional</a>
                }
            </nav>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <form id="psxTopForm" class="ad-search ad-grow" role="search">
                    <input type="text" id="psxTopQ" placeholder="🔍 Buscar alumno/a: nombre, RUT o curso..." autocomplete="off" />
                    <button type="submit">Buscar</button>
                </form>
                <div class="ad-user">
                    @await Html.PartialAsync("_Campana")
                    <div class="dropdown">
                        <button class="btn dropdown-toggle px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">@User.Identity.Name</button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
                            <li class="px-3 py-2 border-bottom">
                                <small class="text-muted d-block">Sesión activa como</small>
                                <div class="small fw-bold" style="color:var(--a-navy)">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                                <div class="small text-secondary">@User.FindFirst("ColegioNombre")?.Value</div>
                            </li>
                            <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="CambiarPassword">🔑 Cambiar contraseña</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item py-2 text-danger fw-bold">🚪 Cerrar sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            }
        </div>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="ad-foot">&copy; 2026 AUKA · Módulo Psicosocial</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // El buscador de la barra alimenta el buscador del panel psicosocial
        (function () {
            var form = document.getElementById('psxTopForm');
            if (!form) return;
            var box = document.getElementById('psxTopQ');
            var sync = function (scroll) {
                var t = document.getElementById('sTxt');
                if (!t) return false;
                t.value = box.value.trim();
                t.dispatchEvent(new Event('input'));
                if (scroll) t.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return true;
            };
            box.addEventListener('input', function () { sync(false); });
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (!sync(true)) {
                    window.location.href = '@Url.Action("Index", "Psychosocial")' + '?q=' + encodeURIComponent(box.value.trim());
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

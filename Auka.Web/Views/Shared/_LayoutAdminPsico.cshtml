@* Auka.Web/Views/Shared/_LayoutAdminPsico.cshtml
   Diseño del administrador de un colegio con Plan Psicosocial. Colores tomados del logo de AUKA. *@
@{
    var ruta = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "") + "/" + (ViewContext.RouteData.Values["action"]?.ToString() ?? "");
    Func<string, string> act = p => ruta.StartsWith(p, StringComparison.OrdinalIgnoreCase) ? " on" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AUKA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root{--a-navy:#1a319b;--a-indigo:#292a9e;--a-blue:#2459b0;--a-teal:#1fb5c5;--a-aqua:#3fdada;--a-ink:#14233a;--a-mut:#5d6f86;--a-bg:#f3f7fc;--a-line:#e3eaf4}
        body{background:var(--a-bg);color:var(--a-ink)}
        .ad-nav{background:#fff;border-bottom:1px solid var(--a-line);position:sticky;top:0;z-index:100}
        .ad-nav .wrap{max-width:1240px;margin:0 auto;padding:.55rem 1rem;display:flex;align-items:center;gap:1.2rem;flex-wrap:wrap}
        .ad-brand{display:flex;align-items:center;gap:.55rem;text-decoration:none}
        .ad-brand img{height:34px;width:auto}
        .ad-brand b{font-size:1.35rem;letter-spacing:.04em;color:var(--a-navy);font-weight:800;line-height:1}
        .ad-brand small{display:block;font-size:.58rem;letter-spacing:.14em;color:var(--a-mut);font-weight:700;margin-top:2px}
        .ad-links{display:flex;gap:.25rem;flex:1;flex-wrap:wrap}
        .ad-links a{padding:.45rem .9rem;border-radius:999px;font-weight:600;font-size:.9rem;color:var(--a-mut);text-decoration:none}
        .ad-links a:hover{background:var(--a-bg);color:var(--a-navy)}
        .ad-links a.on{background:linear-gradient(120deg,var(--a-navy),var(--a-blue));color:#fff}
        .ad-user{display:flex;align-items:center;gap:.6rem}
        .ad-user .btn{border-radius:999px;border:1px solid var(--a-line);background:#fff;font-weight:700;color:var(--a-ink);font-size:.85rem}
        .ad-plan{font-size:.68rem;font-weight:800;letter-spacing:.06em;padding:.25rem .7rem;border-radius:999px;background:#e4f8fa;color:#0c7f8c}
        .ad-main{max-width:1240px;margin:0 auto;padding:1.4rem 1rem 2rem}
        .ad-foot{border-top:1px solid var(--a-line);color:var(--a-mut);font-size:.8rem;text-align:center;padding:1rem}
        .ad-card{background:#fff;border:1px solid var(--a-line);border-radius:16px;box-shadow:0 1px 3px rgba(20,35,58,.05)}
    </style>
</head>
<body>
    <header class="ad-nav">
        <div class="wrap">
            <a class="ad-brand" asp-controller="Administracion" asp-action="Index">
                <img src="~/img/auka-icono.png" alt="AUKA" />
                <span><b>AUKA</b><small>PSICOSOCIAL</small></span>
            </a>
            <nav class="ad-links">
                <a class="@(act("Administracion/Index").Trim())" asp-controller="Administracion" asp-action="Index">Inicio</a>
                <a class="@(act("Personal").Trim())" asp-controller="Personal" asp-action="Index">Equipo</a>
                <a class="@(act("Administracion/Alumnos").Trim())" asp-controller="Administracion" asp-action="Alumnos">Alumnos/as</a>
            </nav>
            <div class="ad-user">
                <span class="ad-plan">PLAN PSICOSOCIAL</span>
                <div class="dropdown">
                    <button class="btn dropdown-toggle px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">@User.Identity?.Name</button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
                        <li class="px-3 py-2 border-bottom">
                            <small class="text-muted d-block">Administrador/a</small>
                            <div class="small fw-bold">@User.FindFirst("ColegioNombre")?.Value</div>
                        </li>
                        <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="CambiarPassword">🔑 Cambiar contraseña</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item py-2 text-danger fw-bold">🚪 Cerrar sesión</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <main class="ad-main" role="main">
        @RenderBody()
    </main>

    <footer class="ad-foot">&copy; 2026 AUKA · Plataforma de gestión educativa</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

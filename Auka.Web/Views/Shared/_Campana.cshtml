@* Auka.Web/Views/Shared/_Campana.cshtml
   Campana de avisos. El correo es el canal principal; esto avisa a quien tiene AUKA abierto (consulta cada 30 s). *@
<div class="dropdown" id="campana">
    <button class="btn btn-light rounded-circle border shadow-sm position-relative" type="button" id="campBtn"
            data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" style="width:42px;height:42px;" title="Avisos">
        🔔
        <span id="campN" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none;">0</span>
    </button>
    <div class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2 p-0" style="width:340px;max-width:92vw;">
        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
            <strong>Avisos</strong>
            <button type="button" class="btn btn-sm btn-link text-decoration-none" id="campLeer">Marcar como leídos</button>
        </div>
        <div id="campLista" style="max-height:340px;overflow:auto;"><div class="p-3 small text-secondary">Cargando...</div></div>
    </div>
</div>
<script>
(function () {
  var $ = function (i) { return document.getElementById(i); };
  var esc = function (t) { return String(t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
  var cuando = function (iso) {
    var d = new Date(iso); if (isNaN(d)) return '';
    return d.toLocaleDateString('es-CL') + ' ' + d.toLocaleTimeString('es-CL', { hour: '2-digit', minute: '2-digit' });
  };
  var ultimo = -1;
  var cargar = function () {
    fetch('/Notificaciones/Lista', { credentials: 'same-origin' }).then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function (j) {
        var n = $('campN'); n.textContent = j.sinLeer > 9 ? '9+' : j.sinLeer; n.style.display = j.sinLeer ? '' : 'none';
        $('campLista').innerHTML = j.items.length ? j.items.map(function (x) {
          return '<a class="d-block px-3 py-2 border-bottom text-decoration-none text-dark" style="' + (x.l ? '' : 'background:#eef5ff;') + '" href="' + esc(x.e || '#') + '">' +
            '<div class="fw-semibold small">' + esc(x.t) + '</div><div class="small text-secondary" style="white-space:pre-line">' + esc(x.m) + '</div>' +
            '<div class="text-muted" style="font-size:.7rem">' + cuando(x.f) + '</div></a>';
        }).join('') : '<div class="p-3 small text-secondary">No tienes avisos todavía.</div>';
        if (ultimo >= 0 && j.sinLeer > ultimo) { $('campBtn').classList.add('border-primary'); setTimeout(function () { $('campBtn').classList.remove('border-primary'); }, 4000); }
        ultimo = j.sinLeer;
      }).catch(function () { });
  };
  $('campLeer').onclick = function () {
    var tk = document.querySelector('input[name="__RequestVerificationToken"]');
    var b = new URLSearchParams(); if (tk) b.append('__RequestVerificationToken', tk.value);
    fetch('/Notificaciones/MarcarLeidas', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: b }).then(cargar);
  };
  cargar();
  setInterval(function () { if (!document.hidden) cargar(); }, 30000);
})();
</script>

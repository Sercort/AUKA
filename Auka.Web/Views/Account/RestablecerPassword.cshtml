@* Auka.Web/Views/Account/RestablecerPassword.cshtml : pantalla a la que llega el enlace del correo *@
@{
    Layout = null;
    var invalido = ViewBag.Invalido == true;
    var error = ViewBag.Error as string;
    var token = ViewBag.Token as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nueva contraseña - AUKA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root{--a-navy:#1a319b;--a-blue:#2459b0;--a-teal:#1fb5c5;--a-ink:#14233a;--a-mut:#5d6f86;--a-bg:#f3f7fc;--a-line:#e3eaf4}
        body{background:linear-gradient(135deg,#f3f7fc 0%,#e4f8fa 100%);color:var(--a-ink);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1rem}
        .box{background:#fff;border:1px solid var(--a-line);border-radius:22px;max-width:480px;width:100%;overflow:hidden;box-shadow:0 10px 30px rgba(20,35,58,.08)}
        .top{background:linear-gradient(120deg,#1a319b,#2459b0 55%,#1fb5c5);color:#fff;padding:1.4rem 1.6rem;display:flex;align-items:center;gap:.8rem}
        .top img{height:38px}.top b{font-size:1.4rem;letter-spacing:.04em}
        .au-btn{background:linear-gradient(120deg,var(--a-navy),var(--a-blue));color:#fff;border:0;border-radius:999px;font-weight:700;padding:.6rem 1.4rem;text-decoration:none;display:inline-block}
        .au-btn:hover{color:#fff;filter:brightness(1.08)}
        .form-control{border-radius:12px;border-color:var(--a-line);padding:.6rem .85rem}
        .form-control:focus{border-color:var(--a-teal);box-shadow:0 0 0 .2rem rgba(31,181,197,.18)}
    </style>
</head>
<body>
    <div class="box">
        <div class="top"><img src="~/img/auka-icono.png" alt="AUKA" /><b>AUKA</b></div>
        <div class="p-4">
            @if (invalido)
            {
                <h4 class="fw-bold mb-2">⏳ Enlace no válido</h4>
                <p class="text-secondary">Este enlace ya se usó o venció (dura 60 minutos). Pide uno nuevo para continuar.</p>
                <a class="au-btn" href="~/Account/OlvidoPassword">Pedir un enlace nuevo</a>
            }
            else
            {
                <h4 class="fw-bold mb-1">🔑 Crea tu nueva contraseña</h4>
                <p class="text-secondary small">Elige una contraseña de al menos 6 caracteres.</p>
                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger py-2 small">@error</div>
                }
                <form method="post" action="~/Account/RestablecerPassword" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="token" value="@token" />
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nueva contraseña</label>
                        <input type="password" name="nuevaPassword" class="form-control" minlength="6" required autofocus />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Repite la contraseña</label>
                        <input type="password" name="confirmarPassword" class="form-control" minlength="6" required />
                    </div>
                    <button type="submit" class="au-btn w-100">Guardar contraseña</button>
                </form>
            }
        </div>
    </div>
</body>
</html>

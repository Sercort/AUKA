@{
    ViewData["Title"] = "Cambio Obligatorio de Contraseña";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark text-center py-3 rounded-top-4">
                    <h4 class="fw-bold mb-0">🔑 Actualizar Contraseña Preventiva</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small">Por motivos de seguridad, debes cambiar la contraseña temporal asignada antes de continuar.</p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
                    }

                    <form asp-action="CambiarPasswordObligatorio" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nueva Contraseña</label>
                            <input type="password" name="nuevaPassword" class="form-control rounded-3" required minlength="6" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Confirmar Nueva Contraseña</label>
                            <input type="password" name="confirmarPassword" class="form-control rounded-3" required minlength="6" />
                        </div>

                        <button type="submit" class="btn btn-warning w-100 rounded-pill fw-bold py-2">Guardar Nueva Contraseña</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
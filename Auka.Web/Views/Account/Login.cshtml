@{
    Layout = null; // Pantalla limpia sin barra superior
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - AUKA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            body {
                background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                padding: 20px 0;
            }

            .card-login {
                background: #ffffff;
                border-radius: 15px;
                box-shadow: 0 10px 25px rgba(0,0,0,0.2);
                padding: 40px;
                width: 100%;
                max-width: 420px;
            }

            .btn-primary-custom {
                background-color: #2a5298;
                border: none;
                padding: 12px;
                font-weight: 600;
            }

                .btn-primary-custom:hover {
                    background-color: #1e3c72;
                }
    </style>
</head>
<body>

    <div class="card-login text-center">
        <h2 class="fw-bold text-primary mb-2" style="color: #1e3c72 !important;">AUKA</h2>
        <p class="text-muted mb-4">Plataforma de Gestión Escolar Integral</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success py-2 mb-3 text-start" role="alert">
                <small>@TempData["SuccessMessage"]</small>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-warning py-2 mb-3 text-start" role="alert">
                <small>⚠️ @TempData["Error"]</small>
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 mb-3 text-start" role="alert">
                <small>@ViewBag.Error</small>
            </div>
        }

        <!-- FORMULARIO DE ACCESO CON CORREO INSTITUCIONAL DE AUKA -->
        <form method="post" asp-action="Login" asp-controller="Account">
            <div class="form-floating mb-3 text-start">
                <input type="email" class="form-control" id="email" name="email" placeholder="nombre@colegio.cl" required />
                <label for="email">Correo Electrónico</label>
            </div>

            <div class="form-floating mb-2 text-start">
                <input type="password" class="form-control" id="password" name="password" placeholder="Contraseña" required />
                <label for="password">Contraseña</label>
            </div>

            <div class="text-end mb-3">
                <a asp-action="OlvidoPassword" asp-controller="Account" class="text-decoration-none small text-muted">¿Olvidaste tu contraseña?</a>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 text-white rounded-pill mb-3">
                Ingresar a la Plataforma
            </button>
        </form>

        <!-- SECCIÓN REGISTRO DE NUEVO COLEGIO -->
        <div class="border-top pt-3 mt-3">
            <p class="small text-muted mb-1">¿Tu establecimiento aún no usa AUKA?</p>
            <a asp-controller="Account" asp-action="Registrar" class="fw-bold text-primary text-decoration-none small">
                🏫 Registrar un nuevo Colegio / Institución
            </a>
        </div>

        <!-- CUENTAS DEMO PARA PRUEBAS -->
        <div class="mt-3 text-muted small pt-2 border-top">
            <p class="mb-0 fw-semibold">Cuentas Demo para Probar:</p>
            <code>admin@auka.cl</code> | <code>director@auka.cl</code>
            <br />
            <small>Claves: <code>Admin123*</code> / <code>Director123*</code></small>
        </div>
    </div>

</body>
</html>
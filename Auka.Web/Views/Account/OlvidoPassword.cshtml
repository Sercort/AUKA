@{
    ViewData["Title"] = "Recuperar Contraseña";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-3 rounded-top-4">
                    <h4 class="fw-bold mb-0">🔓 Recuperar Contraseña</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small mb-3">Ingresa tu Correo Institucional o RUT. Enviaremos las instrucciones a tu correo personal de respaldo.</p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
                    }
                    @if (ViewBag.Info != null)
                    {
                        <div class="alert alert-info" role="alert">@ViewBag.Info</div>
                    }

                    <form asp-action="OlvidoPassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Correo Institucional o RUT</label>
                            <input type="text" name="emailOusuario" class="form-control rounded-3" placeholder="nombre.apellido@colegiolosandes.cl o 12345678-9" required />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill fw-bold py-2">Enviar Instrucciones</button>
                            <a asp-action="Login" class="btn btn-outline-secondary rounded-pill py-2">Volver al Login</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@* Auka.Web/Views/Horarios/Profesores.cshtml — horarios del personal, agrupados por departamento y luego directivos *@
@model List<Auka.Application.Entities.Usuario>
@using Auka.Application.Entities
@using Auka.Web.Controllers
@{
    ViewData["Title"] = "Horarios del personal";
    var horas = ViewBag.Horas as Dictionary<int, int> ?? new();
    var puede = ViewBag.PuedeEditar == true;
    var docentes = Model.Where(u => u.Rol == RolUsuario.Docente).ToList();
    var porDepto = docentes.GroupBy(u => string.IsNullOrWhiteSpace(u.Departamento) ? "Sin departamento asignado" : u.Departamento!)
        .OrderBy(g => g.Key == "Sin departamento asignado" ? 1 : 0).ThenBy(g => g.Key).ToList();
    var otros = Model.Where(u => u.Rol != RolUsuario.Docente).GroupBy(u => HorariosController.NombreRol(u.Rol))
        .OrderBy(g => g.Key).ToList();
    var colores = new[] { "#1a319b", "#2459b0", "#1fb5c5", "#2bb673", "#6c5ce7", "#fb8500", "#ef6f6c" };
    var k = 0;
    var cursosDe = ViewBag.Cursos as Dictionary<int, List<string>> ?? new();
    var ciclosDe = ViewBag.Ciclos as Dictionary<int, List<string>> ?? new();
    var cambioDe = ViewBag.UltimoCambio as Dictionary<int, DateTime> ?? new();
    bool Confirmado(Usuario u) => u.HorarioConfirmadoUtc != null && (!cambioDe.TryGetValue(u.Id, out var c) || u.HorarioConfirmadoUtc >= c);
    var excedidos = docentes.Where(u => u.HorasContrato is > 0 && horas.GetValueOrDefault(u.Id) > u.HorasContrato).ToList();
    var sinConfirmar = docentes.Count(u => horas.GetValueOrDefault(u.Id) > 0 && !Confirmado(u) && u.HorarioObservacion == null);
    var noAcuerdo = docentes.Where(u => u.HorarioObservacion != null).ToList();
    var porAprobar = docentes.Where(u => !u.HorarioBloqueado && horas.GetValueOrDefault(u.Id) > 0 && Confirmado(u)).ToList();
    var aprobados = docentes.Count(u => u.HorarioBloqueado);
    var solicitudes = ViewBag.Solicitudes as List<SolicitudCambioHorario> ?? new();
    var nombres = ViewBag.Nombres as Dictionary<int, string> ?? new();
    string EstadoHorario(Usuario u, int h) => h == 0 ? "sin clases" : u.HorarioBloqueado ? (u.HorarioObservacion != null ? "📝 pidió un cambio" : "🔒 aprobado")
        : u.HorarioObservacion != null ? "✋ no está de acuerdo" : Confirmado(u) ? "✅ confirmó · falta aprobar" : "⏳ por confirmar";
}
<style>
    .hp-grupo { display: flex; align-items: center; gap: .6rem; margin: 20px 0 10px; }
    .hp-grupo h3 { font-size: 1rem; font-weight: 900; color: var(--a-navy); margin: 0; }
    .hp-grupo::after { content: ""; flex: 1; height: 1px; background: var(--a-line); }
    .hp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 12px; }
    .hp { display: flex; align-items: center; gap: .8rem; padding: 14px; text-decoration: none; color: var(--a-ink); transition: transform .2s, box-shadow .2s; }
    .hp:hover { transform: translateY(-2px); box-shadow: var(--a-sombra-hover); color: var(--a-ink); }
    .hp .av { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; color: #fff; font-weight: 900; flex-shrink: 0; }
    .hp .d { flex: 1; min-width: 0; }
    .hp small { color: var(--a-mut); display: block; }
    .hp select { font-size: .78rem; padding: .2rem 1.8rem .2rem .6rem; border-radius: 999px; margin-top: .3rem; max-width: 100%; }
    .hp .ed { display: flex; gap: .35rem; flex-wrap: wrap; align-items: center; margin-top: .3rem; }
    .hp .ed input { width: 76px; font-size: .78rem; padding: .2rem .5rem; border-radius: 999px; }
    .hp .carga { height: 6px; border-radius: 9px; background: #edf1f7; margin-top: .4rem; overflow: hidden; }
    .hp .carga i { display: block; height: 100%; border-radius: 9px; background: var(--a-grad); }
    .hp .carga i.exc { background: var(--a-grad-coral); }
    .hp .cs { display: flex; gap: .25rem; flex-wrap: wrap; margin-top: .35rem; }
    .hp .cs span { font-size: .68rem; font-weight: 800; background: #eef3ff; color: var(--a-navy); border-radius: 6px; padding: .05rem .4rem; }
    .hp-res { display: grid; grid-template-columns: 1.4fr 1fr; gap: 14px; margin-bottom: 8px; }
    .hp-tab { width: 100%; font-size: .86rem; }
    .hp-tab th { font-size: .7rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: var(--a-mut); padding: .3rem .4rem; text-align: center; }
    .hp-tab th:first-child, .hp-tab td:first-child { text-align: left; }
    .hp-tab td { padding: .35rem .4rem; border-top: 1px solid #eef2f8; text-align: center; font-weight: 700; }
    @@media (max-width: 860px) { .hp-res { grid-template-columns: 1fr; } }
</style>

<div class="au-head violeta">
    <div class="ico">👩‍🏫</div>
    <div class="txt"><h2>Horarios del personal</h2><p>Docentes por departamento y luego el equipo directivo. Toca a una persona para ver su horario.</p></div>
    <div class="acc"><a asp-action="Index">Horarios por curso</a></div>
</div>
@{
    var deptos = docentes.GroupBy(u => string.IsNullOrWhiteSpace(u.Departamento) ? "Sin departamento" : u.Departamento!).OrderBy(g => g.Key).ToList();
    int N(IEnumerable<Usuario> l, string ciclo) => l.Count(u => ciclosDe.TryGetValue(u.Id, out var c) && c.Contains(ciclo));
}
<div class="hp-res">
    <div class="au-card p-3">
        <b class="d-block mb-2">📊 Docentes por departamento y ciclo</b>
        <table class="hp-tab">
            <thead><tr><th>Departamento</th><th>Total</th><th>Parvularia</th><th>Básica</th><th>Media</th><th>Horas asignadas</th></tr></thead>
            <tbody>
                @foreach (var g in deptos)
                {
                    <tr>
                        <td>@g.Key</td><td>@g.Count()</td>
                        <td>@N(g, "Educación parvularia")</td><td>@N(g, "Educación básica")</td><td>@N(g, "Educación media")</td>
                        <td>@g.Sum(u => horas.GetValueOrDefault(u.Id))</td>
                    </tr>
                }
            </tbody>
        </table>
        <small class="text-muted d-block mt-2">Se cuenta según los cursos en que cada docente tiene clases en el horario.</small>
    </div>
    <div class="au-card p-3">
        <b class="d-block mb-2">🔔 Avisos</b>
        <div class="d-flex gap-2 flex-wrap mb-2">
            <span class="au-chip verde">🔒 @aprobados aprobados</span>
            <span class="au-chip teal">✅ @porAprobar.Count por aprobar</span>
            <span class="au-chip sol">⏳ @sinConfirmar por confirmar</span>
            @if (noAcuerdo.Count > 0) { <span class="au-chip coral">✋ @noAcuerdo.Count con comentarios o solicitudes</span> }
        </div>
        @foreach (var u in noAcuerdo)
        {
            <div class="alert @(u.HorarioBloqueado ? "alert-info" : "alert-danger") py-2 mb-2">@(u.HorarioBloqueado ? "📝" : "✋") <a href="/Horarios/Profesor/@u.Id">@u.Nombre @u.Apellido</a>: «@u.HorarioObservacion»</div>
        }
        @if (puede && porAprobar.Count > 0)
        {
            <div class="alert alert-info py-2 mb-2">✅ Ya confirmaron y esperan tu aprobación: @foreach (var u in porAprobar.Take(8)) { <a href="/Horarios/Profesor/@u.Id" class="me-2">@u.Nombre @u.Apellido</a> }@(porAprobar.Count > 8 ? "…" : "")</div>
        }
        @if (excedidos.Count == 0 && sinConfirmar == 0 && noAcuerdo.Count == 0)
        {
            <div class="text-success fw-bold">✅ Todo en orden: nadie pasa sus horas y los horarios están confirmados.</div>
        }
        @foreach (var u in excedidos)
        {
            <div class="alert alert-danger py-2 mb-2">⚠️ <a href="/Horarios/Profesor/@u.Id">@u.Nombre @u.Apellido</a> tiene @horas.GetValueOrDefault(u.Id) horas y su contrato es de @u.HorasContrato.</div>
        }
        @if (sinConfirmar > 0)
        {
            <div class="alert alert-warning py-2 mb-0">⏳ @sinConfirmar @(sinConfirmar == 1 ? "docente aún no confirma" : "docentes aún no confirman") su horario. Les llega un aviso en la campana cuando cambia.</div>
        }
    </div>
</div>
@if (puede && solicitudes.Count > 0)
{
    <div class="au-card p-3 mb-3">
        <b class="d-block mb-2">🔁 Solicitudes de cambio de horario</b>
        @foreach (var so in solicitudes)
        {
            var est = so.Estado == EstadoSolicitudHorario.Pendiente ? ("sol", "⏳ esperando respuesta")
                : so.Estado == EstadoSolicitudHorario.Aceptada ? ("verde", "✅ aceptó")
                : so.Estado == EstadoSolicitudHorario.Rechazada ? ("coral", "❌ no puede") : ("", "anulada");
            <div class="d-flex gap-2 align-items-center flex-wrap py-2" style="border-top:1px solid #eef2f8">
                <span class="au-chip @est.Item1">@est.Item2</span>
                <span><b>@nombres.GetValueOrDefault(so.ProfesorConsultadoId, "Docente")</b> · @so.Resumen</span>
                @if (!string.IsNullOrEmpty(so.MotivoInterno)) { <small class="text-muted">Motivo (interno): @so.MotivoInterno</small> }
                @if (!string.IsNullOrEmpty(so.Respuesta)) { <small>Respuesta: «@so.Respuesta»</small> }
                @if (so.Estado == EstadoSolicitudHorario.Pendiente)
                {
                    <form method="post" action="/Horarios/CancelarSolicitud" class="m-0 ms-auto">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@so.Id" />
                        <button class="btn btn-outline-secondary btn-sm px-3">Cancelar</button>
                    </form>
                }
            </div>
        }
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
}
@if (puede)
{
    <p class="small text-muted">La asignatura de cada docente se toma de lo que escribiste en <a href="/Personal">Personal</a> (el departamento se completa solo). Aquí puedes ajustar el departamento y las horas de contrato; se guardan solos.</p>
}

@foreach (var g in porDepto)
{
    <div class="hp-grupo"><h3>📚 @g.Key</h3><span class="au-chip">@g.Count()</span></div>
    <div class="hp-grid">
        @foreach (var u in g)
        {
            var h = horas.TryGetValue(u.Id, out var n) ? n : 0;
            <div class="au-card hp">
                <a asp-action="Profesor" asp-route-id="@u.Id" class="av" style="background:@colores[k++ % colores.Length];text-decoration:none">@(u.Nombre.Length > 0 ? u.Nombre[..1] : "")@(u.Apellido.Length > 0 ? u.Apellido[..1] : "")</a>
                <div class="d">
                    <a asp-action="Profesor" asp-route-id="@u.Id" style="text-decoration:none;color:inherit"><b>@u.Nombre @u.Apellido</b></a>
                    @if (!string.IsNullOrWhiteSpace(u.Asignaturas))
                    {
                        <small>📖 @u.Asignaturas</small>
                    }
                    @{
                        var exc = u.HorasContrato is > 0 && h > u.HorasContrato;
                        var pctC = u.HorasContrato is > 0 ? Math.Min(100, h * 100 / u.HorasContrato.Value) : 0;
                    }
                    <small>🗓️ @h @(u.HorasContrato is > 0 ? "de " + u.HorasContrato : "") horas @(exc ? "· ⚠️ se pasa" : "") · @EstadoHorario(u, h)</small>
                    @if (u.HorasContrato is > 0)
                    {
                        <div class="carga"><i class="@(exc ? "exc" : "")" style="width:@pctC%"></i></div>
                    }
                    @if (cursosDe.TryGetValue(u.Id, out var cs))
                    {
                        <div class="cs">@foreach (var c in cs) { <span>@c</span> }</div>
                    }
                    @if (puede)
                    {
                        <div class="ed">
                            <select class="form-select hp-depto" data-id="@u.Id" aria-label="Departamento" style="flex:1;min-width:130px">
                                <option value="">Sin departamento</option>
                                @foreach (var d in HorariosController.Departamentos.Union(string.IsNullOrEmpty(u.Departamento) ? Array.Empty<string>() : new[] { u.Departamento! }))
                                {
                                    <option value="@d" selected="@(u.Departamento == d)">@d</option>
                                }
                            </select>
                            <input type="number" min="1" max="60" class="form-control hp-horas" data-id="@u.Id" value="@u.HorasContrato" placeholder="Horas" title="Horas de contrato a la semana" />
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@foreach (var g in otros)
{
    <div class="hp-grupo"><h3>🏛️ @g.Key</h3><span class="au-chip">@g.Count()</span></div>
    <div class="hp-grid">
        @foreach (var u in g)
        {
            var h = horas.TryGetValue(u.Id, out var n) ? n : 0;
            <a class="au-card hp" asp-action="Profesor" asp-route-id="@u.Id">
                <span class="av" style="background:@colores[k++ % colores.Length]">@(u.Nombre.Length > 0 ? u.Nombre[..1] : "")@(u.Apellido.Length > 0 ? u.Apellido[..1] : "")</span>
                <div class="d"><b>@u.Nombre @u.Apellido</b><small>@(h > 0 ? $"🗓️ {h} bloques de clase" : "Sin clases asignadas")</small></div>
            </a>
        }
    </div>
}

@if (puede)
{
    @Html.AntiForgeryToken()
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            document.querySelectorAll('.hp-horas').forEach(function (s) {
                s.addEventListener('change', function () {
                    var fd = new FormData(); fd.append('usuarioId', s.dataset.id); fd.append('horas', s.value); fd.append('__RequestVerificationToken', token);
                    fetch('/Horarios/AsignarHoras', { method: 'POST', body: fd, credentials: 'same-origin' })
                        .then(function (r) { return r.json(); }).then(function (d) { if (d.ok) location.reload(); });
                });
            });
            document.querySelectorAll('.hp-depto').forEach(function (s) {
                s.addEventListener('change', function () {
                    var fd = new FormData(); fd.append('usuarioId', s.dataset.id); fd.append('departamento', s.value); fd.append('__RequestVerificationToken', token);
                    fetch('/Horarios/AsignarDepartamento', { method: 'POST', body: fd, credentials: 'same-origin' })
                        .then(function (r) { return r.json(); })
                        .then(function (d) { if (d.ok) location.reload(); else alert(d.error); });
                });
            });
        })();
    </script>
}

@model Auka.Web.Models.PsychosocialDashboardViewModel
@{
    ViewData["Title"] = "Panel Psicosocial";
    Layout = "_LayoutPsicosocial";
}

<style>
    .ps-card { background:#fff; border-radius:16px; box-shadow:0 1px 3px rgba(18,38,58,.08); }
    .ps-label { font-size:.75rem; font-weight:700; color:#4A5D73; letter-spacing:.04em; }
    .ps-kpi { font-size:1.8rem; font-weight:800; line-height:1.1; }
    .ps-pill { border-radius:999px; padding:4px 12px; font-size:.75rem; font-weight:700; display:inline-block; }
    .ps-hero { background:#12263A; color:#fff; border-radius:16px; }
    .ps-agenda { background:#F3F5F9; border-radius:12px; }
    .ps-bitacora { border:1px dashed #9AA9BB; border-radius:12px; background:#FAFBFD; }

    /* Calendario tipo pizarra */
    .cal-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:6px; }
    .cal-dow { font-size:.7rem; font-weight:700; color:#4A5D73; text-align:center; }
    .cal-day { min-height:108px; background:#F7F9FC; border:1px solid #EEF1F6; border-radius:10px; padding:5px; cursor:pointer; overflow:hidden; }
    .cal-day.off { background:#fff; border-style:dashed; cursor:default; }
    .cal-day.hoy { border-color:#0d6efd; box-shadow:0 0 0 1px #0d6efd; }
    .cal-day.fer { background:#FDECEA; }
    .cal-n { font-size:.72rem; font-weight:700; color:#4A5D73; }
    .cal-ev { display:flex; gap:4px; align-items:flex-start; font-size:.7rem; line-height:1.2; border-radius:6px; padding:2px 4px; margin-top:3px; border-left:3px solid var(--c); background:#fff; cursor:pointer; }
    .cal-ev.done .t { text-decoration:line-through; opacity:.5; }
    .cal-ev input { margin-top:1px; flex:none; }
    .cal-leg span { font-size:.7rem; color:#4A5D73; margin-right:10px; white-space:nowrap; }
    .cal-leg i { display:inline-block; width:9px; height:9px; border-radius:3px; margin-right:4px; }
    .cal-tab { border:1px solid #E5EAF1; background:#fff; border-radius:999px; padding:3px 12px; font-size:.78rem; font-weight:700; color:#4A5D73; }
    .cal-tab.on { background:#12263A; color:#fff; border-color:#12263A; }

    /* Panel de alertas compacto */
    .al-sec { font-size:.7rem; font-weight:700; color:#4A5D73; letter-spacing:.04em; margin:.8rem 0 .3rem; display:flex; justify-content:space-between; }
    .al-row { display:flex; align-items:center; gap:8px; padding:6px 8px; border-radius:8px; font-size:.8rem; cursor:pointer; }
    .al-row:hover { background:#F3F7FB; }
    .al-row span { color:#64748b; font-size:.74rem; margin-left:auto; }
    .al-bad { color:#B4402F; font-weight:800; }
    .kpi-go { cursor:pointer; transition:box-shadow .15s; }
    .kpi-go:hover { box-shadow:0 4px 14px rgba(18,38,58,.16); }

    @@media (max-width:767px) {
        .cal-grid { grid-template-columns:1fr; }
        .cal-dow { display:none; }
        .cal-day { min-height:auto; }
    }
</style>

<div class="container py-4" style="max-width:1240px;">

    <!-- ENCABEZADO -->
    <div class="ps-hero p-4 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h3 class="fw-bold mb-1">Panel Psicosocial</h3>
            <p class="mb-0 small" style="color:#C9D6E6;">
                Bienvenida/o, @Model.NombreProfesional · Gestión clínica y seguimiento estudiantil
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-light fw-bold rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#modalCitacion">Solicitar citación</button>
            <button type="button" class="btn btn-outline-light rounded-pill px-4" onclick="document.getElementById('bImp').click()">Importar planilla</button>
        </div>
    </div>

    <!-- NÚMEROS CLAVE (arriba) -->
    <div class="row g-3 mb-4" id="kpis"></div>

    <div class="row g-4 mb-4">
        <!-- CALENDARIO -->
        <div class="col-lg-8">
            <div class="ps-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <button class="cal-tab" id="cPrev">&lsaquo;</button>
                        <h5 class="fw-bold mb-0" id="cTitulo" style="min-width:150px;text-align:center;"></h5>
                        <button class="cal-tab" id="cNext">&rsaquo;</button>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <button class="cal-tab on" id="vMes">Mes</button>
                        <button class="cal-tab" id="vHoy">Hoy</button>
                        <button class="btn btn-primary btn-sm rounded-pill px-3" id="cNueva">+ Nueva nota</button>
                    </div>
                </div>
                <div class="cal-leg mb-2" id="cLeg"></div>
                <div id="cBody"></div>
                <div class="small text-secondary mt-2">Marca la casilla cuando una tarea esté realizada. Los cambios se guardan y los ve todo el equipo psicosocial del colegio (se actualiza cada 30 segundos).</div>
            </div>
        </div>

        <!-- ALERTAS (compactas) -->
        <div class="col-lg-4">
            <div class="ps-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Alertas</h5>
                    <span class="ps-pill" style="background:#FBE4E0;color:#8E2C1F;" id="alTot"></span>
                </div>
                <div class="al-sec"><span>ASISTENCIA BAJO 85%</span></div><div id="alAs"></div>
                <div class="al-sec"><span>DERIVACIONES SIN GESTIONAR</span></div><div id="alDer"></div>
                <div class="al-sec"><span>CITAS SIN CONFIRMAR</span></div><div id="alCit"></div>
            </div>
        </div>
    </div>

    <!-- PLANILLA PSICOSOCIAL 2026 -->
    @await Html.PartialAsync("_PlanillaPsicosocial")

</div>

<!-- MODAL: FICHA DE LA ALUMNA -->
<div class="modal fade" id="modalFicha" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px;">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Ficha de la alumno/a</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body d-flex flex-column gap-3">
                <div><div class="fs-5 fw-bold" id="fNom"></div><div class="small text-secondary" id="fCur"></div></div>
                <div class="row g-2">
                    <div class="col-6"><div class="ps-agenda p-2 text-center"><div class="ps-label">ASISTENCIA</div><div class="fw-bold al-bad" id="fAs"></div></div></div>
                    <div class="col-6"><div class="ps-agenda p-2 text-center"><div class="ps-label">ANOTACIONES (-)</div><div class="fw-bold" id="fAn"></div></div></div>
                </div>
                <div class="ps-bitacora p-3">
                    <div class="ps-label mb-1">BITÁCORA CONFIDENCIAL</div>
                    <div id="fLock">
                        <div class="small text-secondary mb-2">Ingresa tu segunda clave para ver y editar.</div>
                        <div class="input-group input-group-sm"><input type="password" class="form-control" id="fClave" placeholder="Segunda clave"><button class="btn btn-dark" id="fUnlock">Desbloquear</button></div>
                    </div>
                    <div id="fOpen" class="small text-secondary" style="display:none;">Sin entradas de ejemplo. Visible solo para el equipo psicosocial.</div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-dark rounded-pill px-4" id="fNuevo" data-bs-dismiss="modal">Nuevo registro</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: NOTA DEL CALENDARIO -->
<div class="modal fade" id="modalNota" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px;">
            <div class="modal-header border-0"><h5 class="modal-title fw-bold" id="nTit">Nota</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
            <div class="modal-body">
                <label class="ps-label mb-1">TÍTULO</label>
                <input class="form-control mb-3" id="nX" placeholder="Ej: Citación apoderada, Consejo, Taller...">
                <div class="row g-2 mb-3">
                    <div class="col-6"><label class="ps-label mb-1">FECHA</label><input type="date" class="form-control" id="nF"></div>
                    <div class="col-6"><label class="ps-label mb-1">HORA</label><input type="time" class="form-control" id="nH"></div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6"><label class="ps-label mb-1">TIPO</label><select class="form-select" id="nT"></select></div>
                    <div class="col-6"><label class="ps-label mb-1">RESPONSABLE</label>
                        <select class="form-select" id="nR"><option>Psicóloga</option><option>Trabajador social</option><option>Orientadora</option><option>Equipo psicosocial</option></select></div>
                </div>
                <div class="form-check"><input class="form-check-input" type="checkbox" id="nOk"><label class="form-check-label" for="nOk">Realizada</label></div>
            </div>
            <div class="modal-footer border-0 justify-content-between">
                <button class="btn btn-outline-danger rounded-pill px-3" id="nDel">Eliminar</button>
                <div><button class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-primary rounded-pill px-4" id="nSave">Guardar</button></div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: SOLICITAR CITACIÓN (se guarda, aparece en el calendario y avisa por correo y por AUKA) -->
<div class="modal fade" id="modalCitacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px;">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Solicitar citación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <label class="ps-label mb-1">CITAR A</label>
                <select class="form-select mb-3" id="ciA"><option>Alumno</option><option>Apoderado</option><option>Alumno + apoderado</option><option>Profesor jefe</option></select>
                <label class="ps-label mb-1">ESTUDIANTE</label>
                <input type="text" class="form-control" id="ciE" list="ciLista" placeholder="Escribe el nombre y elige de la lista" autocomplete="off" />
                <datalist id="ciLista"></datalist>
                <div class="small text-secondary mb-3" id="ciEi">Cargando alumnos/as...</div>
                <div class="row g-2 mb-3">
                    <div class="col-6"><label class="ps-label mb-1">FECHA</label><input type="date" class="form-control" id="ciF" /></div>
                    <div class="col-6"><label class="ps-label mb-1">HORA</label><input type="time" class="form-control" id="ciH" /></div>
                </div>
                <label class="ps-label mb-1">MOTIVO</label>
                <textarea class="form-control" rows="3" id="ciM" maxlength="300" placeholder="Seguimiento de asistencia..."></textarea>
                <div class="small text-secondary mt-1">Esto lo leerán el alumno/a y su apoderado/a: no escribas detalles sensibles ni clínicos.</div>
                <div class="small mt-2" id="ciR" style="display:none;"></div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" id="ciOk">Enviar citación</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
  var $ = function (i) { return document.getElementById(i); };
  var iso = function (d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); };
  var MES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  var TIPOS = { 'Citación':'#0d6efd', 'Taller':'#7c3aed', 'Consejo':'#64748b', 'Coordinación':'#0f9d8a', 'Reunión':'#d98a00', 'Institucional':'#22a35a', 'Feriado':'#d64545' };

  // ---- Números clave: todo parte en cero y se llena con los datos reales del colegio ----
  var kpiCard = function (k) {
    return '<div class="col-6 col-lg-2"><div class="ps-card p-3 h-100 kpi-go" data-go="' + k[4] + '" role="button" title="Ver detalle"><div class="ps-label" style="font-size:.66rem">' + k[0].toUpperCase() +
      '</div><div class="ps-kpi mt-1"' + (k[3] ? ' style="color:' + k[3] + '"' : '') + '>' + k[1] + '</div><div class="small text-secondary">' + k[2] + '</div></div></div>';
  };
  var pintarKpis = function (d) {
    var K = [['Alumnos/as en seguimiento', d.alumnos, d.cursos + (d.cursos === 1 ? ' curso' : ' cursos'), '', 'Alumnos/as'],
             ['Alumnos/as en alerta', 0, 'sin alertas', '', 'alert'],
             ['Derivaciones sin gestionar', 0, 'sin pendientes', '', 'Derivaciones'],
             ['Citas esta semana', d.citasSemana, d.citasSinConfirmar + ' sin confirmar', '', 'cal'],
             ['Causas judiciales', 0, 'sin casos', '', 'Judicial'],
             ['Informes evacuados', 0, 'sin informes', '', 'Judicial']];
    $('kpis').innerHTML = K.map(kpiCard).join('');
    $('alTot').textContent = '0 alumnos/as';
    $('alAs').innerHTML = '<div class="small text-secondary px-2">Sin alumnos/as bajo 85% de asistencia.</div>';
    $('alDer').innerHTML = '<div class="small text-secondary px-2">Sin derivaciones pendientes.</div>';
    $('alCit').innerHTML = d.proximasCitas.length
      ? d.proximasCitas.map(function (c) { return '<div class="al-row"><b>' + c.f + (c.h ? ' · ' + c.h : '') + '</b><span>' + c.x + '</span></div>'; }).join('')
      : '<div class="small text-secondary px-2">Sin citas por confirmar.</div>';
  };
  pintarKpis({ alumnos: 0, cursos: 0, citasSemana: 0, citasSinConfirmar: 0, proximasCitas: [] });
  var cargarResumen = function () {
    fetch('/Psychosocial/Resumen', { credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); }).then(pintarKpis).catch(function () { });
  };
  cargarResumen();
  document.addEventListener('psx-alumnos', cargarResumen);
  document.addEventListener('psx-calendario', cargarResumen);

  $('kpis').onclick = function (e) {
    var k = e.target.closest('.kpi-go'); if (!k) return; var g = k.getAttribute('data-go');
    if (g === 'alert') $('alAs').scrollIntoView({ behavior: 'smooth', block: 'center' });
    else if (g === 'cal') { $('vHoy').click(); $('cBody').scrollIntoView({ behavior: 'smooth', block: 'center' }); }
    else {
      var t = Array.prototype.filter.call(document.querySelectorAll('.psx-tab'), function (b) { return b.textContent === g; })[0];
      if (t) { t.click(); $('psx').scrollIntoView({ behavior: 'smooth' }); }
    }
  };

  var fichaM = bootstrap.Modal.getOrCreateInstance($('modalFicha'));
  $('fNuevo').onclick = function () { setTimeout(function () { var b = $('psxNew'); if (b) b.click(); }, 300); };

  // ---- Calendario ----
  var EV = [];
  var Y = new Date().getFullYear(), M = new Date().getMonth(), vista = window.innerWidth < 768 ? 'hoy' : 'mes', cur = null;
  var notaM = bootstrap.Modal.getOrCreateInstance($('modalNota'));
  $('nT').innerHTML = Object.keys(TIPOS).map(function (t) { return '<option>' + t + '</option>'; }).join('');
  $('cLeg').innerHTML = Object.keys(TIPOS).map(function (t) { return '<span><i style="background:' + TIPOS[t] + '"></i>' + t + '</span>'; }).join('');

  var chip = function (e) {
    return '<div class="cal-ev' + (e.ok ? ' done' : '') + '" data-id="' + e.id + '" style="--c:' + TIPOS[e.t] + '"><input type="checkbox" ' + (e.ok ? 'checked' : '') +
      '><div class="t">' + (e.h ? '<b>' + e.h + '</b> ' : '') + e.x + '</div></div>';
  };
  var draw = function () {
    $('vMes').classList.toggle('on', vista === 'mes'); $('vHoy').classList.toggle('on', vista === 'hoy');
    if (vista === 'hoy') {
      var hoy = iso(new Date());
      var hoyEv = EV.filter(function (e) { return e.f === hoy; }), prox = EV.filter(function (e) { return e.f > hoy; }).sort(function (a, b) { return (a.f + a.h) < (b.f + b.h) ? -1 : 1; }).slice(0, 6);
      $('cTitulo').textContent = 'Hoy';
      $('cBody').innerHTML = '<div class="ps-label mb-1">HOY</div>' + (hoyEv.length ? hoyEv.map(chip).join('') : '<div class="small text-secondary mb-2">No hay actividades para hoy.</div>') +
        '<div class="ps-label mt-3 mb-1">PRÓXIMAS</div>' + prox.map(function (e) { return '<div class="small text-secondary mt-2">' + e.f.slice(8) + '/' + e.f.slice(5, 7) + '</div>' + chip(e); }).join('');
      return;
    }
    $('cTitulo').textContent = MES[M] + ' ' + Y;
    var first = new Date(Y, M, 1), n = new Date(Y, M + 1, 0).getDate(), lead = (first.getDay() === 0 || first.getDay() === 6) ? 0 : first.getDay() - 1, h = iso(new Date());
    var html = '<div class="cal-grid">' + ['LUNES','MARTES','MIÉRCOLES','JUEVES','VIERNES'].map(function (d) { return '<div class="cal-dow">' + d + '</div>'; }).join('');
    for (var i = 0; i < lead; i++) html += '<div class="cal-day off"></div>';
    for (var d = 1; d <= n; d++) {
      var dt = new Date(Y, M, d); if (dt.getDay() === 0 || dt.getDay() === 6) continue;
      var f = iso(dt), evs = EV.filter(function (e) { return e.f === f; }).sort(function (a, b) { return a.h < b.h ? -1 : 1; });
      var fer = evs.some(function (e) { return e.t === 'Feriado'; });
      html += '<div class="cal-day' + (f === h ? ' hoy' : '') + (fer ? ' fer' : '') + '" data-f="' + f + '"><div class="cal-n">' + d + '</div>' + evs.map(chip).join('') + '</div>';
    }
    $('cBody').innerHTML = html + '</div>';
  };
  var abrir = function (e, f) {
    cur = e || null; $('nTit').textContent = e ? 'Editar nota' : 'Nueva nota';
    $('nX').value = e ? e.x : ''; $('nF').value = e ? e.f : (f || iso(new Date())); $('nH').value = e ? e.h : '';
    $('nT').value = e ? e.t : 'Citación'; $('nR').value = e ? e.r : 'Psicóloga'; $('nOk').checked = e ? e.ok : false;
    $('nDel').style.display = e ? '' : 'none'; notaM.show();
  };
  var tok = function () { return document.querySelector('input[name="__RequestVerificationToken"]').value; };
  var post = function (url, datos) {
    var body = new URLSearchParams(datos); body.append('__RequestVerificationToken', tok());
    return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); });
  };
  var cargar = function () {
    var d, h;
    if (vista === 'hoy') { d = new Date(); h = new Date(); h.setDate(h.getDate() + 45); }
    else { d = new Date(Y, M, 1); h = new Date(Y, M + 1, 0); }
    return fetch('/Psychosocial/EventosCalendario?desde=' + iso(d) + '&hasta=' + iso(h), { credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function (lista) { EV = lista; draw(); document.dispatchEvent(new CustomEvent('psx-calendario')); })
      .catch(function () { /* sin conexión: se mantiene lo que se ve */ });
  };
  var error = function () { alert('No se pudo guardar. Revisa tu conexión e inténtalo de nuevo.'); cargar(); };

  $('cBody').onclick = function (ev) {
    var c = ev.target.closest('.cal-ev');
    if (c) {
      var e = EV.filter(function (x) { return x.id === +c.getAttribute('data-id'); })[0];
      if (ev.target.tagName === 'INPUT') {
        e.ok = ev.target.checked; draw();
        post('/Psychosocial/MarcarEvento', { id: e.id, realizada: e.ok }).catch(error);
      } else abrir(e);
      return;
    }
    var day = ev.target.closest('.cal-day'); if (day && day.getAttribute('data-f')) abrir(null, day.getAttribute('data-f'));
  };
  $('nSave').onclick = function () {
    if (!$('nX').value.trim()) return;
    post('/Psychosocial/GuardarEvento', { id: cur ? cur.id : 0, fecha: $('nF').value, hora: $('nH').value, tipo: $('nT').value,
      titulo: $('nX').value.trim(), responsable: $('nR').value, realizada: $('nOk').checked })
      .then(function () { notaM.hide(); cargar(); }).catch(error);
  };
  $('nDel').onclick = function () {
    if (!cur) return;
    post('/Psychosocial/EliminarEvento', { id: cur.id }).then(function () { notaM.hide(); cargar(); }).catch(error);
  };
  $('cNueva').onclick = function () { abrir(null); };
  $('cPrev').onclick = function () { M--; if (M < 0) { M = 11; Y--; } vista = 'mes'; cargar(); };
  $('cNext').onclick = function () { M++; if (M > 11) { M = 0; Y++; } vista = 'mes'; cargar(); };
  $('vMes').onclick = function () { vista = 'mes'; cargar(); };
  $('vHoy').onclick = function () { vista = 'hoy'; cargar(); };
  setInterval(function () { if (!document.hidden && !document.querySelector('.modal.show')) cargar(); }, 30000);
  draw(); cargar();
})();
// ---- Solicitar citación: se guarda de verdad y avisa por correo + AUKA ----
(function () {
  var $ = function (i) { return document.getElementById(i); };
  var lista = [];
  var etiqueta = function (a) { return a.n + ' · ' + a.c; };
  var tok = function () { return document.querySelector('input[name="__RequestVerificationToken"]').value; };
  var cargarAlumnos = function () {
    return fetch('/Psychosocial/Alumnos', { credentials: 'same-origin' }).then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function (l) {
        lista = l; var dl = $('ciLista'); dl.innerHTML = '';
        l.forEach(function (a) { var o = document.createElement('option'); o.value = etiqueta(a); dl.appendChild(o); });
        $('ciEi').textContent = l.length ? l.length + ' alumnos/as disponibles' : 'Aún no hay alumnos/as cargados/as.';
      }).catch(function () { $('ciEi').textContent = 'No se pudo cargar la lista de alumnos/as.'; });
  };
  var modal = $('modalCitacion');
  modal.addEventListener('show.bs.modal', function () {
    $('ciR').style.display = 'none'; $('ciOk').disabled = false;
    var hoy = new Date(); $('ciF').min = hoy.getFullYear() + '-' + String(hoy.getMonth() + 1).padStart(2, '0') + '-' + String(hoy.getDate()).padStart(2, '0');
    cargarAlumnos();
  });
  var msg = function (t, ok) { var r = $('ciR'); r.style.display = ''; r.className = 'small mt-2 ' + (ok ? 'text-success' : 'text-danger'); r.textContent = t; };
  $('ciOk').onclick = function () {
    var al = lista.filter(function (a) { return etiqueta(a) === $('ciE').value.trim(); })[0];
    if (!al) return msg('Elige un alumno/a de la lista.', false);
    if (!$('ciF').value) return msg('Elige la fecha.', false);
    if ($('ciM').value.trim().length < 3) return msg('Escribe el motivo.', false);
    var body = new URLSearchParams({ estudianteId: al.id, citadoA: $('ciA').value, fecha: $('ciF').value, hora: $('ciH').value, motivo: $('ciM').value.trim() });
    body.append('__RequestVerificationToken', tok());
    $('ciOk').disabled = true;
    fetch('/Psychosocial/CrearCitacion', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
      .then(function (r) { return r.json().then(function (j) { if (!r.ok) throw new Error(j.error || r.status); return j; }); })
      .then(function (j) {
        var t = 'Citación guardada. ';
        if (j.avisados === 0) t += 'No hay a quién avisar (el alumno/a o apoderado/a no tiene cuenta).';
        else {
          t += 'Se avisó en AUKA a ' + j.avisados + (j.avisados === 1 ? ' persona' : ' personas');
          if (j.porCorreo) t += ' y por correo a ' + j.porCorreo;
          if (j.simulados) t += ' (correo en modo prueba: ' + j.simulados + ')';
          if (j.fallidos) t += '. ' + j.fallidos + ' correo(s) fallaron y se reintentarán solos';
          t += '.';
        }
        msg(t, true);
        $('ciM').value = ''; $('ciE').value = '';
        document.dispatchEvent(new CustomEvent('psx-calendario'));
        $('ciOk').disabled = false;
        var c = document.getElementById('vHoy'); if (c) c.click();
      })
      .catch(function (e) { msg(e.message || 'No se pudo guardar. Inténtalo de nuevo.', false); $('ciOk').disabled = false; });
  };
})();
</script>
}

      '<div class="psx-find-row"><input class="psx-in" type="password" id="ckI" placeholder="Tu clave (segunda clave o la de ingreso)" autocomplete="current-password"><button class="psx-btn p" id="ckOk">Confirmar</button><button class="psx-btn" id="ckNo">Cancelar</button></div>' +

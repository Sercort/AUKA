@* Auka.Web/Views/Psychosocial/_PlanillaPsicosocial.cshtml
   Planilla Psicosocial 2026 -> dashboard + 7 pestañas. Solo visual, con DATOS FICTICIOS.
   Sin modelo ni dependencias: se incluye desde Index.cshtml con
   @await Html.PartialAsync("_PlanillaPsicosocial") *@
<style>
.psx{--ink:#14233a;--mut:#64748b;--line:#e5eaf1;--bg:#f6f8fb;--b:#0d6efd;margin-top:1.5rem;color:var(--ink)}
.psx *{box-sizing:border-box}
.psx-head{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem;margin-bottom:.75rem}
.psx-head h5{margin:0;font-weight:700}
.psx-tabs{display:flex;gap:.35rem;flex-wrap:wrap;margin-bottom:1rem}
.psx-tab{border:1px solid var(--line);background:#fff;border-radius:999px;padding:.4rem .9rem;font-size:.85rem;font-weight:600;color:var(--mut);cursor:pointer}
.psx-tab.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.psx-pane{display:none}.psx-pane.on{display:block}
.psx-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:1.1rem;margin-bottom:1rem;overflow-x:auto}
.psx-card h6{font-weight:700;margin:0 0 .75rem}
.psx-grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.psx-kpis{display:grid;gap:.75rem;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));margin-bottom:1rem}
.psx-kpi{background:#fff;border:1px solid var(--line);border-radius:14px;padding:.9rem}
.psx-kpi small{display:block;color:var(--mut);font-size:.7rem;text-transform:uppercase;letter-spacing:.04em}
.psx-kpi b{font-size:1.7rem;line-height:1.2}.psx-kpi span{display:block;font-size:.75rem;color:var(--mut)}
.psx-row{display:flex;align-items:center;gap:.6rem;font-size:.82rem;margin:.35rem 0}
.psx-row em{font-style:normal;width:84px;flex:none;color:var(--mut)}
.psx-bar{flex:1;background:var(--bg);border-radius:6px;height:12px;overflow:hidden}
.psx-bar i{display:block;height:100%;background:var(--b);border-radius:6px}
.psx-row b{width:30px;text-align:right}
.psx-t{width:100%;border-collapse:collapse;font-size:.82rem}
.psx-t th{text-align:left;color:var(--mut);font-size:.7rem;text-transform:uppercase;padding:.45rem .5rem;border-bottom:1px solid var(--line);white-space:nowrap}
.psx-t td{padding:.55rem .5rem;border-bottom:1px solid var(--bg);vertical-align:top}
.psx-c{display:inline-block;padding:.15rem .55rem;border-radius:999px;font-size:.7rem;font-weight:700;white-space:nowrap}
.psx-c.ok{background:#dcf5e6;color:#15803d}.psx-c.warn{background:#fdf1d3;color:#8a5a00}
.psx-c.bad{background:#fde2e2;color:#b42323}.psx-c.info{background:#e3edff;color:#1d4ed8}.psx-c.nil{background:var(--bg);color:var(--mut)}
.psx-dots{display:flex;gap:3px}.psx-dots i{width:10px;height:10px;border-radius:50%;background:var(--line)}
.psx-dots i.d2{background:#22a35a}.psx-dots i.d1{background:#f0a500}
.psx-btn{border:1px solid var(--line);background:#fff;border-radius:8px;padding:.35rem .8rem;font-size:.8rem;font-weight:600}
.psx-btn.p{background:var(--b);border-color:var(--b);color:#fff}.psx-btn:disabled{opacity:.55}
.psx-kan{display:grid;gap:.75rem;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
.psx-col{background:var(--bg);border-radius:12px;padding:.7rem}.psx-col h6{font-size:.8rem;color:var(--mut)}
.psx-note{background:#fff;border:1px solid var(--line);border-radius:10px;padding:.6rem;font-size:.8rem;margin-top:.5rem}
.psx-leg{font-size:.72rem;color:var(--mut);margin-top:.5rem}
.psx-in{width:100%;border:1px solid var(--line);border-radius:8px;padding:.4rem .6rem;font-size:.85rem;background:#fff}
.psx-find-row{display:flex;gap:.5rem;flex-wrap:wrap}.psx-find-row .psx-in{flex:1;min-width:200px}.psx-find-row select{max-width:190px}
.psx-res{margin-top:.5rem}
.psx-it{display:flex;align-items:center;gap:.6rem;padding:.5rem .6rem;border-radius:8px;cursor:pointer;font-size:.84rem}
.psx-it:hover{background:var(--bg)}.psx-it span{color:var(--mut);margin-left:auto;font-size:.78rem}
.psx-ov{display:none;position:fixed;top:0;right:0;bottom:0;left:0;background:rgba(20,35,58,.55);z-index:2000;align-items:center;justify-content:center;padding:1rem}
.psx-ov.on{display:flex}
.psx-mod{background:#fff;border-radius:16px;width:100%;max-width:720px;max-height:90vh;display:flex;flex-direction:column}
.psx-mh{display:flex;justify-content:space-between;align-items:center;padding:1rem 1.2rem;border-bottom:1px solid var(--line)}
.psx-x{border:0;background:none;font-size:1.5rem;line-height:1;color:var(--mut)}
.psx-steps{display:flex;gap:.4rem;padding:.7rem 1.2rem 0}
.psx-st{font-size:.75rem;font-weight:700;color:var(--mut);padding:.2rem .6rem;border-radius:999px;background:var(--bg)}.psx-st.on{background:var(--ink);color:#fff}
.psx-mb{padding:1rem 1.2rem;overflow-y:auto}
.psx-mf{display:flex;justify-content:space-between;padding:.8rem 1.2rem;border-top:1px solid var(--line)}
.psx-fg{display:grid;gap:.6rem;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
.psx-fc{border:1px solid var(--line);border-radius:12px;padding:.7rem;cursor:pointer;font-size:.8rem}
.psx-fc b{display:block;font-size:.88rem}.psx-fc span{color:var(--mut)}
.psx-fc:hover{border-color:var(--b)}.psx-fc.on{border-color:var(--b);background:#eef4ff}
.psx-fgrid{display:grid;gap:.7rem;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));margin-top:.7rem}
.psx-f span{display:block;font-size:.72rem;font-weight:700;color:var(--mut);text-transform:uppercase;margin-bottom:.2rem}
</style>

<section class="psx" id="psx">
  <div class="psx-head">
    <h5>Planilla Psicosocial 2026</h5>
    <div><button class="psx-btn" id="bImp">Importar planilla</button>
      <button class="psx-btn" id="bAdd">+ Agregar alumnos/as</button>
      <button class="psx-btn" id="bYear">Pasar de año</button>
      <span class="psx-c ok" id="psxMsg" style="display:none"></span>
      <button class="psx-btn p" id="psxNew">+ Nuevo registro</button></div>
  </div>
  <div class="psx-card">
    <h6>Buscar alumno/a</h6>
    <div class="psx-find-row"><select id="sCur" class="psx-in"></select>
      <input id="sTxt" class="psx-in" placeholder="Nombre, RUT o curso del módulo psicosocial..."></div>
    <div id="sRes" class="psx-res"></div>
  </div>
  <div class="psx-tabs" id="psxTabs"></div>

  <div class="psx-pane" data-p="Resumen">
    
    <div class="psx-grid">
      <div class="psx-card"><h6>Alumnos/as en seguimiento por curso</h6><div id="gCur"></div></div>
      <div class="psx-card"><h6>Informes judiciales de julio</h6><div id="gInf"></div>
        <h6 style="margin-top:1rem">Periodicidad de informes</h6><div id="gPer"></div></div>
      <div class="psx-card"><h6>Asistencia en monitoreo</h6><div id="gAs"></div>
        <p class="psx-leg">Menciones de asistencia en la calendarización; bajo 85% se marca como riesgo.</p></div>
    </div>
  </div>

  <div class="psx-pane" data-p="Alumnos/as">
    <div class="psx-card"><div class="psx-head"><h6>Alumnos/as matriculados</h6>
      <div style="display:flex;gap:.4rem;flex-wrap:wrap;align-items:center"><select id="rCur" class="psx-btn"></select>
        <input id="rTxt" class="psx-in" placeholder="Buscar nombre o RUT" style="max-width:220px"><span class="psx-c info" id="rN"></span><button class="psx-btn" id="rClaves">Claves provisorias</button></div></div>
      <div id="tRos"><p class="psx-leg">Cargando…</p></div>
      <p class="psx-leg">Se muestran hasta 100 a la vez; usa el curso o el buscador para acotar.</p></div>
  </div>

  <div class="psx-pane" data-p="Seguimiento">
    <div class="psx-card"><div class="psx-head"><h6>Calendarización de seguimiento</h6>
      <select id="fCur" class="psx-btn"></select></div>
      <div id="tSeg"></div>
      <p class="psx-leg"><span class="psx-dots" style="display:inline-flex"><i class="d2"></i></span> realizado &nbsp;
        <span class="psx-dots" style="display:inline-flex"><i class="d1"></i></span> pendiente &nbsp;
        <span class="psx-dots" style="display:inline-flex"><i></i></span> sin acción &nbsp; (Mar a Dic)</p></div>
  </div>

  <div class="psx-pane" data-p="Judicial">
    <div class="psx-grid" style="grid-template-columns:2fr 1fr">
      <div class="psx-card"><h6>Casos judicializados</h6><div id="tJud"></div></div>
      <div class="psx-card"><h6>Correlativo de informes</h6>
        <p style="margin:0">Próximo N°: <b id="corNext">FEMAR-1-2026</b></p>
        <button class="psx-btn p" style="margin:.6rem 0" id="bCor">Generar correlativo</button><div id="tCor"></div></div>
    </div>
  </div>

  <div class="psx-pane" data-p="Derivaciones">
    <div class="psx-card"><h6>Derivación a convivencia escolar</h6><div id="tCon"></div></div>
    <div class="psx-card"><h6>Derivación a profesores tutores</h6><div id="tTut"></div></div>
  </div>

  <div class="psx-pane" data-p="Terreno">
    <div class="psx-card"><h6>Visitas domiciliarias (V.D.)</h6><div id="tVD"></div></div>
  </div>

  <div class="psx-pane" data-p="Beneficios">
    <div class="psx-card"><div class="psx-head"><h6>Pro-retención: sets</h6>
      <div><button class="psx-btn" id="bSetE">Editar sets</button> <button class="psx-btn" id="bStock">Registrar ingreso</button> <button class="psx-btn" id="bGI">Guía de ingreso</button> <button class="psx-btn p" id="bGD">Guía de despacho</button></div></div>
      <div class="psx-fg" id="bSets"></div></div>
    <div class="psx-grid">
      <div class="psx-card"><h6>Entrega por alumno/a</h6><div id="tEnt"></div></div>
      <div class="psx-card"><h6>Inventario de ropa</h6><div id="tInv"></div>
        <p class="psx-leg">Stock bajo = igual o menor al mínimo. En este módulo no se maneja dinero.</p></div>
    </div>
  </div>

  <div class="psx-pane" data-p="Vacunación">
    <div class="psx-card"><div class="psx-head"><h6>Listado para vacunación (CESFAM)</h6>
      <div style="display:flex;gap:.4rem;flex-wrap:wrap;align-items:center"><select id="vCur" class="psx-btn"></select><span class="psx-c info" id="vN"></span>
        <button class="psx-btn" id="vCsv">Exportar Excel (CSV)</button> <button class="psx-btn p" id="vPrn">Imprimir</button></div></div>
      <div id="tVac"></div>
      <p class="psx-leg">Datos de menores: solo para personal autorizado.</p></div>
  </div>

  <div class="psx-pane" data-p="Egresos y plan">
    <div class="psx-card"><h6>Egresos psicosociales</h6><div id="tEgr"></div></div>
    <div class="psx-card"><h6>Plan de acción: estudiantes críticos</h6><div class="psx-kan" id="kan"></div></div>
  </div>
<div class="psx-ov" id="psxOv"><div class="psx-mod">
    <div class="psx-mh"><b>Nuevo registro</b><button class="psx-x" id="mX">&times;</button></div>
    <div class="psx-steps" id="mS"></div>
    <div class="psx-mb" id="mB"></div>
    <div class="psx-mf"><button class="psx-btn" id="mBack">Atrás</button><button class="psx-btn p" id="mNext">Siguiente</button></div>
  </div></div>
<div class="psx-ov" id="dgOv"><div class="psx-mod">
    <div class="psx-mh"><b id="dgT"></b><button class="psx-x" id="dgX">&times;</button></div>
    <div class="psx-mb" id="dgB"></div>
    <div class="psx-mf"><button class="psx-btn" id="dgC">Cancelar</button><button class="psx-btn p" id="dgOk">Guardar</button></div>
  </div></div>
</section>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var c = function (t, k) { return '<span class="psx-c ' + k + '">' + t + '</span>'; };
  var T = function (h, r) {
    return '<table class="psx-t"><thead><tr>' + h.map(function (x) { return '<th>' + x + '</th>'; }).join('') +
      '</tr></thead><tbody>' + (r.length ? r.map(function (a) { return '<tr>' + a.map(function (x) { return '<td>' + x + '</td>'; }).join('') + '</tr>'; }).join('') : '<tr><td colspan="' + h.length + '" style="color:var(--mut);text-align:center;padding:1rem">Sin registros todavía.</td></tr>') + '</tbody></table>';
  };
  var B = function (rows, max, col) {
    if (!rows.length || !max) return '<p class="psx-leg">Sin datos todavía.</p>';
    return rows.map(function (r) {
      return '<div class="psx-row"><em>' + r[0] + '</em><div class="psx-bar"><i style="width:' + Math.round(r[1] / max * 100) + '%;' +
        (r[2] || col ? 'background:' + (r[2] || col) : '') + '"></i></div><b>' + r[1] + '</b></div>';
    }).join('');
  };
  var dots = function (a) { return '<div class="psx-dots">' + a.map(function (s) { return '<i class="d' + s + '"></i>'; }).join('') + '</div>'; };
  var asis = function (n) { return c(n + '%', n < 85 ? 'bad' : 'ok'); };

  // Todo parte vacío: los cursos salen de los alumnos/as realmente cargados
  var NIV = ['1° Básico', '2° Básico', '3° Básico', '4° Básico', '5° Básico', '6° Básico', '7° Básico', '8° Básico', 'I° Medio', 'II° Medio', 'III° Medio', 'IV° Medio'];
  var cursos = [];
  var seg = [];
  $('gCur').innerHTML = B(cursos, 1);
  $('gInf').innerHTML = B([], 0);
  $('gPer').innerHTML = B([], 0);
  $('gAs').innerHTML = B([], 0);

  var sel = $('fCur');
  var opcCursos = function () { return '<option value="">Todos los cursos</option>' + cursos.map(function (x) { return '<option>' + x[0] + '</option>'; }).join(''); };
  sel.innerHTML = opcCursos();
  var drawSeg = function () {
    var f = sel.value;
    $('tSeg').innerHTML = T(['Alumno/a','Curso','Objetivo / acuerdo','Mar a Dic','Asistencia'],
      seg.filter(function (r) { return !f || r[1] === f; }).map(function (r) { return [r[0], r[1], r[2], dots(r[3]), asis(r[4])]; }));
  };
  sel.onchange = drawSeg; drawSeg();

  var JUD = [];
  var drawJud = function () { $('tJud').innerHTML = T(['Alumno/a','Curso','Causa','RIT','Informe jul','Informe dic','Periodicidad'], JUD); };
  drawJud();
  var COR = [], sigCor = 1;
  var drawCor = function () { $('tCor').innerHTML = T(['N°','Ord.','Fecha'], COR); $('corNext').textContent = 'FEMAR-' + sigCor + '-2026'; };
  drawCor();

  $('tCon').innerHTML = T(['Fecha','Curso','Apoderada','Intervención','Mediación','Situación'], []);
  $('tTut').innerHTML = T(['Curso','Estudiante','Objetivo / acuerdo','Estado'], []);
  $('tVD').innerHTML = T(['Fecha','Estudiante','Dirección','Jornada','Responsable','Pago'], []);
  $('tEgr').innerHTML = T(['Alumno/a','Curso','Motivo','Fecha'], []);
  $('kan').innerHTML = [['Por iniciar'],['En curso'],['Logrado']]
    .map(function (k) { return '<div class="psx-col"><h6>' + k[0] + '</h6><div class="psx-leg">Sin estudiantes.</div></div>'; }).join('');

  // ---- Nuevo registro: fichas de la planilla + buscador de alumnos/as (visual) ----
  var alu = [];
  var MES = ['Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  var F = [
    {k:'seg',n:'Seguimiento mensual',d:'Calendarización: acciones y asistencia del mes',al:1,f:[['Mes','s',MES],['Tipo de acción','s',['Carta de compromiso','Monitoreo','Entrevista presencial','Citación a apoderado','Observación en aula','Coordinación con programa externo']],['Asistencia (%)','n'],['Objetivo / acuerdo','a'],['Observaciones','a']]},
    {k:'jud',n:'Caso judicializado',d:'RIT, informes y resoluciones',al:1,f:[['Origen de la causa','s',['Interno','Externo']],['Año de apertura','n'],['RIT de la causa','t'],['Informe de julio','s',['Enviado','Pendiente','No procede']],['Informe de diciembre','s',['Pendiente','Enviado','Causa cerrada','No procede']],['Periodicidad','s',['Mensual','Trimestral','Semestral','Solo por oficio']],['Resumen de resoluciones','a']]},
    {k:'inf',n:'Informe evacuado',d:'Correlativo FEMAR automático',al:1,f:[['N° correlativo','t','FEMAR-1-2026'],['Fecha','d'],['Destinatario','t'],['Detalle','a']]},
    {k:'vd',n:'Visita domiciliaria',d:'Fecha, dirección, jornada y responsable',al:1,f:[['Fecha','d'],['Dirección','t'],['Jornada','s',['AM','PM']],['Responsable','t'],['Pago','s',['Pendiente','OK']],['Observaciones','a']]},
    {k:'conv',n:'Derivación a convivencia escolar',d:'Entrevista, intervención y mediación',al:1,f:[['Fecha','d'],['Entrevista con apoderada','s',['Registro en Lirmi','Procede','No procede']],['Intervención con alumno/a','s',['Procede','No procede']],['Mediación / acciones','a'],['Situación actual','s',['Monitoreo','Egreso']]]},
    {k:'tut',n:'Derivación a profesor tutor',d:'Objetivos y acuerdos con el tutor',al:1,f:[['Profesor tutor','t'],['Objetivos / acuerdos','a'],['Estado','s',['Pendiente','En curso','Logrado']]]},
    {k:'plan',n:'Plan de acción (crítica)',d:'Objetivos, estrategias y estado',al:1,f:[['Objetivos de intervención','a'],['Estrategias','a'],['Estado de objetivos','s',['Por iniciar','En curso','Logrado']]]},
    {k:'pro',n:'Beneficio pro-retención',d:'Entrega de sets y beneficios',al:1,f:[['Año','s',['2026','2025']],['Beneficio','s',['Set 1','Set 2','Tablet']],['Estado','s',['Pendiente','Entregado']]]},
    {k:'ropa',n:'Movimiento de inventario',d:'Entrada o entrega de ropa',al:0,f:[['Prenda','s',['Blazer','Camisa blanca','Chaqueta polar','Jumper','Polera piqué','Zapatos','Calcetas','Mochila']],['Talla','t'],['Cantidad','n'],['Tipo','s',['Entrada','Entrega a alumno/a']]]},
    {k:'ano',n:'Anotación de conducta',d:'Positiva o negativa; la ven profesores/as y apoderados/as',al:1,f:[['Tipo','s',['Positiva','Negativa']],['Detalle','a']]},
    {k:'egr',n:'Egreso psicosocial',d:'Motivo, fecha y citación final',al:1,f:[['Motivo','s',['Egreso','Egreso con compromisos','Retirada del colegio']],['Fecha','d'],['Citación a apoderada','d'],['Observaciones','a']]}
  ];
  var fld = function (f) {
    var t = f[1], h = '<label class="psx-f"><span>' + f[0] + '</span>';
    if (t === 's') h += '<select class="psx-in">' + f[2].map(function (o) { return '<option>' + o + '</option>'; }).join('') + '</select>';
    else if (t === 'a') h += '<textarea class="psx-in" rows="3"></textarea>';
    else h += '<input class="psx-in" type="' + (t === 'd' ? 'date' : t === 'n' ? 'number' : 'text') + '"' + (f[2] ? ' value="' + f[2] + '" readonly' : '') + '>';
    return h + '</label>';
  };
  var curOpts = opcCursos();
  var rows = function (q, cu) {
    q = (q || '').toLowerCase();
    return alu.filter(function (a) { return (!cu || a[1].indexOf(cu) === 0) && (!q || (a[0] + ' ' + a[1] + ' ' + a[2]).toLowerCase().indexOf(q) > -1); });
  };
  var list = function (l) {
    return l.length ? l.map(function (a) { return '<div class="psx-it" data-n="' + a[2] + '"><b>' + a[0] + '</b><span>' + a[1] + ' · ' + a[2] + '</span>' + (a[3] == null ? '' : asis(a[3])) + '</div>'; }).join('')
      : '<p class="psx-leg">Sin resultados</p>';
  };
  var byRut = function (n) { return alu.filter(function (a) { return a[2] === n; })[0]; };
  var wireSearch = function (selId, txtId, resId, onPick) {
    var s = $(selId), t = $(txtId), r = $(resId);
    s.innerHTML = curOpts;
    var go = function () {
      r.innerHTML = (!s.value && !t.value) ? '<p class="psx-leg">Elige un curso o escribe un nombre, RUT o curso.</p>' : list(rows(t.value, s.value).slice(0, 6));
    };
    s.onchange = go; t.oninput = go; go();
    r.onclick = function (e) { var it = e.target.closest('.psx-it'); if (it) onPick(byRut(it.getAttribute('data-n'))); };
  };

  var ov = $('psxOv'), mB = $('mB'), st = { s: 1, f: null, a: null, done: 0 };
  var draw = function () {
    $('mS').innerHTML = ['1 Ficha', '2 Alumno/a', '3 Datos'].map(function (x, i) { return '<span class="psx-st' + (st.s === i + 1 ? ' on' : '') + '">' + x + '</span>'; }).join('');
    var h = '';
    if (st.s === 1) {
      h = '<p class="psx-leg" style="margin:0 0 .6rem">Elige la ficha que quieres completar</p><div class="psx-fg">' +
        F.map(function (f) { return '<div class="psx-fc' + (st.f && st.f.k === f.k ? ' on' : '') + '" data-k="' + f.k + '"><b>' + f.n + '</b><span>' + f.d + '</span></div>'; }).join('') + '</div>';
    } else if (st.s === 2) {
      h = '<div class="psx-find-row"><select id="mCur" class="psx-in"></select><input id="mTxt" class="psx-in" placeholder="Buscar por nombre, RUT o curso"></div>' +

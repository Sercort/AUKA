          '<input class="psx-in" id="ccClave" type="password" autocomplete="current-password" placeholder="' + (j.segunda ? 'Tu segunda clave' : 'Tu clave de ingreso') + '">' +
          '<p class="psx-leg" style="margin:.3rem 0">Para confirmar el cambio escribe ' + (j.segunda ? 'tu segunda clave' : 'tu clave de ingreso') + '. Queda anotado en la bitácora. De kínder a 6° básico la cuenta la maneja su apoderado/a.</p>' +

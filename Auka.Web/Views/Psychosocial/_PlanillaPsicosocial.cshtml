          '<button class="psx-btn" data-apac="correo" data-apid="' + x.id + '" style="padding:.1rem .5rem;font-size:.75rem">Enviar acceso por correo</button>' +
          '<button class="psx-btn" data-apac="clave" data-apid="' + x.id + '" style="padding:.1rem .5rem;font-size:.75rem">Clave provisoria</button>' +
          '<button class="psx-btn" data-apac="quitar" data-apid="' + x.id + '" style="padding:.1rem .5rem;font-size:.75rem;color:#b42323">Quitar</button></div>' : '') +
        '<div id="apR' + x.id + '"></div></div>';
    }).join('');
  };
  var contactoHtml = function (k) {
    var cont = [k.d ? '📍 ' + esc(k.d) : '', k.t ? '📞 ' + esc(k.t) : '', k.m ? '✉️ ' + esc(k.m) : ''].filter(Boolean).join(' · ');
    return (cont ? '<p class="psx-leg" style="margin:0 0 .3rem">' + cont + '</p>' : '') +

        '<div class="psx-find-row"><input class="psx-in" id="faN" placeholder="Nombre completo"><input class="psx-in" id="faR" placeholder="RUT (opcional)" style="max-width:150px"></div>' +
        '<div class="psx-find-row" style="margin-top:.4rem"><input class="psx-in" id="faM" type="email" placeholder="Correo (ahí le llegan los avisos)"><input class="psx-in" id="faT" placeholder="Teléfono" style="max-width:150px"></div>' +
        '<div class="psx-find-row" style="margin-top:.4rem"><select class="psx-in" id="faP" style="max-width:170px"><option>Madre</option><option>Padre</option><option>Abuela</option><option>Abuelo</option><option>Tía</option><option>Tío</option><option>Hermana</option><option>Hermano</option><option>Tutor/a legal</option><option>Otro</option></select>' +
        '<label style="display:flex;gap:.35rem;align-items:center;font-size:.85rem"><input type="checkbox" id="faTit"> Apoderado/a titular</label></div>' +
        '<div style="display:flex;gap:.4rem;margin-top:.5rem"><button class="psx-btn p" id="faOk">Guardar</button><button class="psx-btn" id="faNo">Cancelar</button></div><div class="psx-leg" id="faE" style="color:#b42323;margin:.3rem 0 0"></div></div>';
      $('faN').focus();

  var post = function (url, datos) {
    var body = new URLSearchParams(datos); body.append('__RequestVerificationToken', tok());
    return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok) throw new Error(j.error || r.status); return j; }); });
  };
  var cargarBen = function () {
    return fetch('/Psychosocial/Beneficios', { credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function (d) { ANIO = String(d.anio); SETS = d.sets; INV = d.inv.map(function (a) { return [a.n, a.ta, a.s, a.m, a.id]; }); drawSets(); drawInv(); })
      .catch(function () { /* sin conexión: se mantiene lo que se ve */ });
  };
  var errBen = function () { alert('No se pudo guardar. Revisa tu conexión e inténtalo de nuevo.'); cargarBen(); };
  cargarBen();
  setInterval(function () {
    var ed = document.activeElement && document.activeElement.classList && document.activeElement.classList.contains('iv');
    if (!document.hidden && !$('dgOv').classList.contains('on') && !ed) cargarBen();
  }, 30000);

  // ---- Listado real de alumnos/as matriculados ----
  var ROS = null, ROSerr = '';
  var ordenCurso = function (c) { var i = NIV.indexOf(c.replace(/ [A-Za-z]$/, '')); return i < 0 ? 99 : i; };
  var llenarRos = function () {
    var cur = $('rCur').value, uniq = {};
    ROS.forEach(function (a) { uniq[a.c] = (uniq[a.c] || 0) + 1; });
    var nombres = Object.keys(uniq).sort(function (x, y) { return ordenCurso(x) - ordenCurso(y) || (x < y ? -1 : 1); });
    $('rCur').innerHTML = '<option value="">Todos los cursos</option>' + nombres.map(function (n) { return '<option value="' + n + '">' + n + ' (' + uniq[n] + ')</option>'; }).join('');
    $('rCur').value = cur; drawRos();
  };
  var drawRos = function () {
    if (ROS === 'error') { $('tRos').innerHTML = '<p class="psx-leg" style="color:#b42323">No se pudo cargar el listado (' + ROSerr + '). Abre la consola del navegador (F12) y revisa la pestaña Network.</p>'; return; }
    if (!ROS) return;
    if (!ROS.length) { $('rN').textContent = '0'; $('tRos').innerHTML = '<p class="psx-leg">Aún no hay alumnos/as cargados. Usa «Importar planilla» o «+ Agregar alumnos/as».</p>'; return; }
    var f = $('rCur').value, q = $('rTxt').value.trim().toLowerCase();
    var r = ROS.filter(function (a) { return (!f || a.c === f) && (!q || (a.n + ' ' + a.r).toLowerCase().indexOf(q) > -1); });
    $('rN').textContent = r.length + ' de ' + ROS.length + ' alumnos/as';
    $('tRos').innerHTML = T(['N°', 'Nombre', 'RUT', 'Curso', 'Nacimiento', 'Edad', 'Ficha'], r.slice(0, 100).map(function (a, i) {
      return [i + 1, '<a href="#" class="ros-a" data-id="' + a.id + '" style="font-weight:600;color:#0d6efd;text-decoration:none">' + esc(a.n) + '</a>', a.r, a.c, a.f ? a.f.split('-').reverse().join('-') : '—', a.f ? edad(a.f) + ' años' : '—',
        '<button class="psx-btn ros-a" data-id="' + a.id + '">Abrir ficha</button>'];
    }));
  };
  $('rCur').onchange = drawRos; $('rTxt').oninput = drawRos;

  // ---- Ficha confidencial del alumno/a (pide la segunda clave) ----
  var esc = function (t) { return String(t == null ? '' : t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
  var fichaId = 0;
  var abrirFicha = function (id) {
    fichaId = id;
    dlg('Ficha del alumno/a', '<div id="fiB"><p class="psx-leg">Cargando…</p></div>', function () {}, 'Cerrar');
    cargarFicha();
  };
  var cargarFicha = function () {
    fetch('/Psychosocial/Expediente/' + fichaId, { credentials: 'same-origin' })
      .then(function (r) { if (r.status === 403) throw 'bloqueada'; if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(dibujarFicha)
      .catch(function (e) { if (e === 'bloqueada') pedirClave(); else $('fiB').innerHTML = '<p class="psx-leg" style="color:#b42323">No se pudo abrir la ficha (' + esc(e.message || e) + ').</p>'; });
  };
  var pedirClave = function () {
    fetch('/Psychosocial/EstadoClaveFicha', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (st) {
      var nueva = !st.tieneClave;
      $('fiB').innerHTML = '<div class="psx-note"><b>' + (nueva ? 'Crea tu segunda clave' : 'Ingresa tu segunda clave') + '</b>' +
        '<p class="psx-leg" style="margin:.3rem 0">' + (nueva ? 'Protege las fichas confidenciales. Debe tener al menos 6 caracteres y ser distinta de tu clave de ingreso.' : 'Las fichas son confidenciales. Se vuelve a pedir cada 15 minutos.') + '</p>' +
        '<input class="psx-in" type="password" id="fiK" placeholder="Segunda clave">' + (nueva ? '<input class="psx-in" type="password" id="fiK2" placeholder="Repite la segunda clave" style="margin-top:.4rem">' : '') +
        '<button class="psx-btn p" id="fiGo" style="margin-top:.5rem">' + (nueva ? 'Crear y abrir' : 'Desbloquear') + '</button><p class="psx-leg" id="fiE" style="color:#b42323;margin:.3rem 0 0"></p></div>';
      $('fiK').focus();
      $('fiGo').onclick = function () {
        post(nueva ? '/Psychosocial/CrearClaveFicha' : '/Psychosocial/DesbloquearFichas', nueva ? { clave: $('fiK').value, confirmar: $('fiK2').value } : { clave: $('fiK').value })
          .then(cargarFicha).catch(function (e) { $('fiE').textContent = e.message; });
      };
    });
  };
  var cargarAnot = function (id) {
    fetch('/Psychosocial/Anotaciones?estudianteId=' + id, { credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function (l) {
        if (!$('anL')) return;
        $('anL').innerHTML = l.length ? l.map(function (a) {
          return '<div class="psx-note"><div class="psx-leg" style="margin:0">' + c(a.t === 1 ? 'Positiva' : 'Negativa', a.t === 1 ? 'ok' : 'bad') + ' ' + new Date(a.f).toLocaleDateString('es-CL') + (a.a ? ' · ' + esc(a.a) : '') + '</div><div style="margin-top:.25rem">' + esc(a.d) + '</div></div>';
        }).join('') : '<p class="psx-leg">Sin anotaciones todavía.</p>';
      }).catch(function () { if ($('anL')) $('anL').innerHTML = '<p class="psx-leg">No se pudieron cargar las anotaciones.</p>'; });
  };
  var falloFicha = function (e) { if (/segunda clave/i.test(e.message)) pedirClave(); else alert(e.message); };
  var dibujarFicha = function (f) {
    var lista = f.bit.map(function (x) {
      return '<div class="psx-note"><div class="psx-leg" style="margin:0">' + new Date(x.f).toLocaleString('es-CL') + ' · ' + esc(x.a) + (x.m ? ' · editada' : '') + '</div>' +
        '<div id="bt' + x.id + '" style="white-space:pre-wrap;margin:.25rem 0">' + esc(x.t) + '</div><button class="psx-btn" data-ed="' + x.id + '">Editar</button></div>';
    }).join('') || '<p class="psx-leg">Sin anotaciones todavía.</p>';
    $('fiB').innerHTML = '<div><b style="font-size:1.05rem">' + esc(f.n) + '</b><div class="psx-leg">' + esc(f.c) + ' · RUT ' + esc(f.r) +
      (f.f ? ' · Nacimiento ' + f.f.split('-').reverse().join('-') + ' (' + edad(f.f) + ' años)' : '') + '</div></div>' +
      '<h6 style="margin:.9rem 0 .4rem">Bitácora confidencial</h6><textarea class="psx-in" id="fiT" rows="3" placeholder="Nueva anotación…"></textarea>' +
      '<button class="psx-btn p" id="fiAdd" style="margin:.4rem 0">Agregar anotación</button><div id="fiL">' + lista + '</div>' +
      '<h6 style="margin:.9rem 0 .4rem">Anotaciones de conducta</h6><p class="psx-leg" style="margin:0 0 .4rem">Las ven profesores/as y apoderados/as, como cualquier anotación del libro de clases.</p>' +
      '<div class="psx-find-row"><select class="psx-in" id="anT" style="max-width:150px"><option value="1">Positiva</option><option value="2">Negativa</option></select><input class="psx-in" id="anD" placeholder="Detalle de la anotación" maxlength="500"></div>' +
      '<button class="psx-btn p" id="anAdd" style="margin:.4rem 0">Registrar anotación</button><div id="anL"></div>' +
      '<h6 style="margin:.9rem 0 .4rem">Cuenta del alumno/a</h6><p class="psx-leg">Usuario: ' + esc(f.email) + '. La clave de ingreso se guarda cifrada y no se puede ver; si se perdió, genera una nueva provisoria.</p>' +
      '<button class="psx-btn" id="fiRes">Generar nueva clave provisoria</button><div id="fiC"></div>';
    cargarAnot(f.id);
    $('anAdd').onclick = function () {
      post('/Psychosocial/CrearAnotacion', { estudianteId: f.id, tipo: $('anT').value, detalle: $('anD').value })
        .then(function () { $('anD').value = ''; cargarAnot(f.id); msg('Anotación registrada', 1); })
        .catch(function (e) { alert(e.message); });
    };
    $('fiAdd').onclick = function () {
      post('/Psychosocial/AgregarBitacora', { estudianteId: f.id, observaciones: $('fiT').value }).then(cargarFicha).catch(falloFicha);
    };
    $('fiL').onclick = function (e) {
      var ed = e.target.getAttribute('data-ed'), sv = e.target.getAttribute('data-sv');
      if (ed) {
        var cont = $('bt' + ed), txt = cont.textContent;
        cont.innerHTML = '<textarea class="psx-in" rows="3" id="be' + ed + '"></textarea>'; $('be' + ed).value = txt;
        e.target.textContent = 'Guardar'; e.target.removeAttribute('data-ed'); e.target.setAttribute('data-sv', ed);
      } else if (sv) {
        post('/Psychosocial/EditarBitacora', { id: sv, observaciones: $('be' + sv).value }).then(cargarFicha).catch(falloFicha);
      }
    };
    $('fiRes').onclick = function () {
      post('/Psychosocial/RestablecerClaveAlumno', { estudianteId: f.id }).then(function (j) {
        $('fiC').innerHTML = '<div class="psx-note">Usuario: <b>' + esc(j.email) + '</b><br>Clave provisoria: <b style="font-size:1.1rem">' + esc(j.clave) + '</b>' +
          '<p class="psx-leg" style="margin:.3rem 0 0">Anótala ahora: no se vuelve a mostrar. Deberá cambiarla al ingresar.</p></div>';
      }).catch(falloFicha);
    };
  };
  $('tRos').onclick = function (e) { var a = e.target.closest('.ros-a'); if (a) { e.preventDefault(); abrirFicha(+a.getAttribute('data-id')); } };

  var resultadoAlu = function (j, cont) {
    var h = '<div style="margin-top:.6rem"><span class="psx-c ok">' + j.creados + ' creados</span> <span class="psx-c info">' + j.actualizados + ' actualizados</span> ' + (j.apoderados ? '<span class="psx-c ok">' + j.apoderados + ' apoderados/as creados/as</span> ' : '') +
      (j.omitidos ? '<span class="psx-c nil">' + j.omitidos + ' omitidos</span> ' : '') + (j.cursosCreados ? '<span class="psx-c nil">' + j.cursosCreados + ' cursos nuevos</span> ' : '') +
      (j.totalErrores ? '<span class="psx-c bad">' + j.totalErrores + ' con error</span>' : '') + '</div>';
    if (j.errores && j.errores.length) h += '<ul class="psx-leg" style="margin:.4rem 0 0 1rem">' + j.errores.map(function (e) { return '<li>' + e + '</li>'; }).join('') + '</ul>';
    if (j.credenciales && j.credenciales.length) h += '<p class="psx-leg">Las cuentas nuevas tienen una clave provisoria que deben cambiar al entrar. <b>Descárgala ahora: no se vuelve a mostrar.</b></p><button class="psx-btn p" id="bCred">Descargar claves provisorias (CSV)</button>';
    $(cont).innerHTML = h;
    if ($('bCred')) $('bCred').onclick = function () {
      descargar('claves_provisorias.csv', '\ufeffRUT;Nombre;Correo;Clave provisoria\n' + j.credenciales.map(function (c) { return [c.rut, c.n, c.e, c.c].join(';'); }).join('\n'));
    };
    msg(j.creados + ' creados, ' + j.actualizados + ' actualizados' + (j.totalErrores ? ', ' + j.totalErrores + ' con error' : ''), 1);
    $('dgOk').textContent = 'Cerrar';
    dgOk = function () { var t = Array.prototype.filter.call(document.querySelectorAll('.psx-tab'), function (b) { return b.textContent === 'Alumnos/as'; })[0]; if (t) t.click(); };
    cargarAlu();
  };
  var enviarAlumnos = function (url, cuerpo, cont) {
    $('dgOk').disabled = true; $(cont).innerHTML = '<p class="psx-leg">Procesando…</p>';
    fetch(url, { method: 'POST', credentials: 'same-origin', body: cuerpo })
      .then(function (r) { return r.json().then(function (j) { if (!r.ok) throw new Error(j.error || r.status); return j; }); })
      .then(function (j) { resultadoAlu(j, cont); })
      .catch(function (e) { $(cont).innerHTML = '<p class="psx-leg" style="color:#b42323">No se pudo completar: ' + e.message + '</p>'; })
      .then(function () { $('dgOk').disabled = false; });
  };
  var cargarAlu = function () {
    return fetch('/Psychosocial/Alumnos', { credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function (l) {
        ROS = l; llenarRos();
        var cnt = {}; l.forEach(function (a) { cnt[a.c] = (cnt[a.c] || 0) + 1; });
        cursos = Object.keys(cnt).sort(function (x, y) { return ordenCurso(x) - ordenCurso(y) || (x < y ? -1 : 1); }).map(function (k) { return [k, cnt[k]]; });
        $('gCur').innerHTML = B(cursos, Math.max.apply(null, cursos.map(function (x) { return x[1]; })) || 1);
        alu = l.map(function (a) { return [a.n, a.c, a.r, null]; });
        VAC = l.map(function (a) { return [a.n, a.c, a.r, a.f]; });
        var v1 = sel.value, v2 = vSel.value, v3 = $('sCur').value;
        sel.innerHTML = opcCursos(); sel.value = v1; vSel.innerHTML = opcCursos(); vSel.value = v2; $('sCur').innerHTML = opcCursos(); $('sCur').value = v3;
        drawSeg(); drawVac(); if ($('sTxt').oninput) $('sTxt').oninput();
        document.dispatchEvent(new CustomEvent('psx-alumnos'));
      }).catch(function (e) { ROS = 'error'; ROSerr = e.message; drawRos(); });
  };
  cargarAlu();

  // ---- Claves provisorias nuevas para alumnos/as que aún no cambian la suya ----
  $('rClaves').onclick = function () {
    var f = $('rCur').value;
    if (!confirm('Se generarán claves provisorias nuevas para los alumnos/as' + (f ? ' de ' + f : '') + ' que aún no han cambiado la suya. Las anteriores dejan de servir. ¿Continuar?')) return;
    post('/Psychosocial/RegenerarClavesAlumnos', { curso: f }).then(function (j) {
      if (!j.total) { msg('Todos ya cambiaron su clave', 1); return; }
      descargar('claves_provisorias.csv', '\ufeffRUT;Nombre;Correo;Clave provisoria\n' + j.credenciales.map(function (c) { return [c.rut, c.n, c.e, c.c].join(';'); }).join('\n'));
      msg(j.total + ' claves nuevas generadas', 1);
    }).catch(function (e) {
      alert(String(e && e.message) === '403' ? 'Primero desbloquea tus fichas: abre la ficha de cualquier alumno/a e ingresa tu segunda clave.' : 'No se pudo completar (' + (e && e.message) + ').');
    });
  };

  var tabs = $('psxTabs'), panes = document.querySelectorAll('#psx .psx-pane');
  panes.forEach(function (p, i) {
    var b = document.createElement('button');
    b.className = 'psx-tab' + (i ? '' : ' on'); b.textContent = p.getAttribute('data-p');
    b.onclick = function () {
      tabs.querySelectorAll('.psx-tab').forEach(function (x) { x.classList.remove('on'); });
      panes.forEach(function (x) { x.classList.remove('on'); });
      b.classList.add('on'); p.classList.add('on');
    };
    tabs.appendChild(b); if (!i) p.classList.add('on');
  });
})();
</script>


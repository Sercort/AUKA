        '<div class="psx-note">' + c('Confidencial', 'nil') + ' Las fichas, bitácoras y protocolos los ve solo el equipo psicosocial. Si necesitas que intervengan, regístralo en una entrevista con «Derivación al equipo».</div>' +
        '<div style="display:flex;justify-content:space-between;align-items:center;margin:.8rem 0 .4rem"><h6 style="margin:0">Registros de orientación</h6><button class="psx-btn p" id="oriNew">+ Nuevo registro</button></div>' +
        fichaRegistros(mios), function () {}, 'Cerrar');
      $('oriNew').onclick = function () { dgClose(); openM(a); };
      if ($('oriCon')) familia($('oriCon'), id);

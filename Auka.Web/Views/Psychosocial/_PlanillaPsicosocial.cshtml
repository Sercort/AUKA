      tablaOrg('mal', 'tMal', ['Fecha de la denuncia', 'Tipo de situación', 'Rol del @V.persona', 'Etapa del protocolo', 'Aviso al apoderado/a']);
      tablaOrg('vul', 'tVul', ['Fecha de detección', 'Tipo de situación', 'Acción realizada', 'Fecha de la acción', 'Estado']);
      tablaOrg('dec', 'tDec', ['Fecha', 'Hora', 'Etapa', 'Aviso al apoderado/a']);
      tablaOrg('rein', 'tRein', ['Motivo de la ausencia', 'Fecha de inicio', 'Fecha de retorno', 'Estado']);
    }
    if (!ORG.col) {
      tablaOrg('jud', 'tJud', ['Tipo de caso', 'Fecha de denuncia', 'Canal', 'Estado de la investigación', 'Apoyo psicológico']);
      tablaOrg('conv', 'tCon', ['Fecha', 'Derivado a', 'Motivo', 'Situación actual']);
      tablaOrg('tut', 'tTut', ['Jefatura / área', 'Acuerdos (horario, carga, funciones)', 'Fecha de revisión', 'Estado']);
      tablaOrg('vd', 'tVD', ['Fecha', 'Lugar', 'Dirección', 'Responsable']);
      tablaOrg('egr', 'tEgr', ['Motivo', 'Fecha', 'Recomendaciones']);
      tablaOrg('rein', 'tRein', ['Fecha de inicio de licencia', 'Fecha de retorno', 'Tipo de licencia', 'Estado']);
      var kj = cuenta(jud, 'Estado de la investigación'), tj = cuenta(jud, 'Tipo de caso');
      $('gInf').innerHTML = kj.length ? B(kj, Math.max.apply(null, kj.map(function (x) { return x[1]; }))) : '<p class="psx-leg">Sin casos Ley Karin.</p>';
      $('gPer').innerHTML = tj.length ? B(tj, Math.max.apply(null, tj.map(function (x) { return x[1]; }))) : '<p class="psx-leg">—</p>';
    }
    // Judicial y correlativo
    if (ORG.col) $('tJud').innerHTML = T(['@V.Persona','Curso','Origen','RIT','Informe jul','Informe dic','Periodicidad'], jud.map(function (r) {
      return [esc(r.n), esc(r.c), esc(g(r, 'Origen de la causa')), g(r, 'RIT de la causa') ? esc(g(r, 'RIT de la causa')) : c('Sin RIT', 'bad'), estadoChip(g(r, 'Informe de julio')), estadoChip(g(r, 'Informe de diciembre')), esc(g(r, 'Periodicidad'))];
    }));
    var infs = de('inf');
    $('tCor').innerHTML = T(['N°','@V.Persona','Fecha'], infs.map(function (r) { return [esc(g(r, 'N° correlativo')), esc(r.n), fechaCL(g(r, 'Fecha')) !== '—' ? fechaCL(g(r, 'Fecha')) : new Date(r.f).toLocaleDateString('es-CL')]; }));
    fetch('/Psychosocial/SiguienteCorrelativo', { credentials: 'same-origin' }).then(function (x) { return x.json(); }).then(function (j) { $('corNext').textContent = j.n; }).catch(function () {});

    // Derivaciones, terreno y egresos
    if (ORG.col) $('tCon').innerHTML = T(['Fecha','@V.Persona','Curso','Entrevista apoderada','Intervención','Mediación / acciones','Situación'], de('conv').map(function (r) {
      return [fechaCL(g(r, 'Fecha')), esc(r.n), esc(r.c), esc(g(r, 'Entrevista con apoderada')), esc(g(r, 'Intervención con @V.persona')), esc(g(r, 'Mediación / acciones')), estadoChip(g(r, 'Situación actual'))];
    }));
    if (ORG.col) $('tTut').innerHTML = T(['Curso','Estudiante','Profesor tutor','Objetivo / acuerdo','Estado'], de('tut').map(function (r) {
      return [esc(r.c), esc(r.n), esc(g(r, 'Profesor tutor')), esc(g(r, 'Objetivos / acuerdos')), estadoChip(g(r, 'Estado'))];
    }));
    if (ORG.col) $('tVD').innerHTML = T(['Fecha','Estudiante','Dirección','Jornada','Responsable','Pago'], de('vd').map(function (r) {
      return [fechaCL(g(r, 'Fecha')), esc(r.n), esc(g(r, 'Dirección')), esc(g(r, 'Jornada')), esc(g(r, 'Responsable')), estadoChip(g(r, 'Pago'))];
    }));
    if (ORG.col) $('tEgr').innerHTML = T(['@V.Persona','Curso','Motivo','Fecha'], de('egr').map(function (r) { return [esc(r.n), esc(r.c), esc(g(r, 'Motivo')), fechaCL(g(r, 'Fecha'))]; }));

    // Plan de acción (kanban por estado; queda el plan más reciente de cada @V.persona)
    var ult = {}; de('plan').forEach(function (r) { if (!ult[r.eid]) ult[r.eid] = r; });
    var planes = Object.keys(ult).map(function (k) { return ult[k]; });
    $('kan').innerHTML = ['Por iniciar', 'En curso', 'Logrado'].map(function (col) {
      var l = planes.filter(function (r) { return (g(r, 'Estado de objetivos') || 'Por iniciar') === col; });
      return '<div class="psx-col"><h6>' + col + ' (' + l.length + ')</h6>' + (l.length ? l.map(function (r) {
        return '<div class="psx-note ros-a" data-id="' + r.eid + '" style="cursor:pointer"><b>' + esc(r.n) + '</b><div class="psx-leg" style="margin:0">' + esc(r.c) + '</div><div>' + esc(g(r, 'Objetivos de intervención')) + '</div></div>';
      }).join('') : '<div class="psx-leg">Sin estudiantes.</div>') + '</div>';
    }).join('');

    // Beneficios: entrega por @V.persona
    ENT = de('pro').map(function (r) { return [r.n, r.c, (g(r, 'Beneficio') + ' ' + g(r, 'Año')).trim(), g(r, 'Estado') === 'Entregado' ? 1 : 0, r.id]; });
    drawEnt();
  };
  $('kan').onclick = $('tRos').onclick;
  var cargarReg = function () {
    return fetch('/Psychosocial/Registros', { credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function (l) { REG = l; dibujarRegistros(); document.dispatchEvent(new CustomEvent('psx-registros', { detail: REG })); })
      .catch(function () { /* sin conexión: se mantiene lo que se ve */ });
  };

  var resultadoAlu = function (j, cont) {
    var h = '<div style="margin-top:.6rem"><span class="psx-c ok">' + j.creados + ' creados</span> <span class="psx-c info">' + j.actualizados + ' actualizados</span> ' + (j.apoderados ? '<span class="psx-c ok">' + j.apoderados + ' apoderados/as creados/as</span> ' : '') +
      (j.omitidos ? '<span class="psx-c nil">' + j.omitidos + ' omitidos</span> ' : '') + (j.cursosCreados ? '<span class="psx-c nil">' + j.cursosCreados + ' cursos nuevos</span> ' : '') +
      (j.totalErrores ? '<span class="psx-c bad">' + j.totalErrores + ' con error</span>' : '') + '</div>';
    if (j.errores && j.errores.length) h += '<ul class="psx-leg" style="margin:.4rem 0 0 1rem">' + j.errores.map(function (e) { return '<li>' + esc(e) + '</li>'; }).join('') + '</ul>';
    if (j.avisos && j.avisos.length) h += '<div class="psx-note" style="margin-top:.5rem">' + c('Avisos', 'warn') + '<ul class="psx-leg" style="margin:.3rem 0 0 1rem">' + j.avisos.map(function (e) { return '<li>' + esc(e) + '</li>'; }).join('') + '</ul></div>';
    if (j.invitados) h += '<p class="psx-leg">' + c(j.invitados + ' recibieron un correo para crear su contraseña', 'ok') + '</p>';
    if (j.credenciales && j.credenciales.length) h += '<p class="psx-leg">Las cuentas nuevas tienen una clave provisoria que deben cambiar al entrar. <b>Descárgala ahora: no se vuelve a mostrar.</b></p><button class="psx-btn p" id="bCred">Descargar claves provisorias (CSV)</button>';
    $(cont).innerHTML = h;
    if ($('bCred')) $('bCred').onclick = function () {
      descargar('claves_provisorias.csv', '\ufeffRUT;Nombre;Correo;Clave provisoria\n' + j.credenciales.map(function (c) { return [c.rut, c.n, c.e, c.c].join(';'); }).join('\n'));
    };
    msg(j.creados + ' creados, ' + j.actualizados + ' actualizados' + (j.totalErrores ? ', ' + j.totalErrores + ' con error' : ''), 1);
    $('dgOk').textContent = 'Cerrar';
    dgOk = function () { var t = Array.prototype.filter.call(document.querySelectorAll('.psx-tab'), function (b) { return b.textContent === '@V.Personas'; })[0]; if (t) t.click(); };
    cargarAlu();
  };
  var enviarAlumnos = function (url, cuerpo, cont) {
    $('dgOk').disabled = true; $(cont).innerHTML = '<p class="psx-leg">Procesando…</p>';
    fetch(url, { method: 'POST', credentials: 'same-origin', body: cuerpo })
      .then(function (r) { return r.json().then(function (j) { if (!r.ok) throw new Error(j.error || r.status); return j; }); })
      .then(function (j) { resultadoAlu(j, cont); })
      .catch(function (e) { $(cont).innerHTML = '<p class="psx-leg" style="color:#b42323">No se pudo completar: ' + e.message + '</p>'; })
      .then(function () { $('dgOk').disabled = false; });
  };
  var cargarAlu = function () {
    return fetch('/Psychosocial/Alumnos', { credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function (l) {
        ROS = l; llenarRos();
        var cnt = {}; l.forEach(function (a) { cnt[a.c] = (cnt[a.c] || 0) + 1; });
        cursos = Object.keys(cnt).sort(function (x, y) { return ordenCurso(x) - ordenCurso(y) || (x < y ? -1 : 1); }).map(function (k) { return [k, cnt[k]]; });
        alu = l.map(function (a) { return [a.n, a.c, a.r, null, a.id]; });
        VAC = l.map(function (a) { return [a.n, a.c, a.r, a.f]; });
        var v1 = sel.value, v2 = vSel.value;
        sel.innerHTML = opcCursos(); sel.value = v1; vSel.innerHTML = opcCursos(); vSel.value = v2;
        drawVac(); if ($('sCur').psxRefresh) $('sCur').psxRefresh();
        cargarReg();
        document.dispatchEvent(new CustomEvent('psx-alumnos'));
      }).catch(function (e) { ROS = 'error'; ROSerr = e.message; drawRos(); });
  };
  cargarAlu();

  // ---- Claves provisorias nuevas para @V.personas que aún no cambian la suya ----
  $('rClaves').onclick = function () {
    var f = $('rCur').value;
    if (!confirm('Se generarán claves provisorias nuevas para los @V.personas' + (f ? ' de ' + f : '') + ' que aún no han cambiado la suya. Las anteriores dejan de servir. ¿Continuar?')) return;
    post('/Psychosocial/RegenerarClavesAlumnos', { curso: f }).then(function (j) {
      if (!j.total) { msg('Todos ya cambiaron su clave', 1); return; }
      descargar('claves_provisorias.csv', '\ufeffRUT;Nombre;Correo;Clave provisoria\n' + j.credenciales.map(function (c) { return [c.rut, c.n, c.e, c.c].join(';'); }).join('\n'));
      msg(j.total + ' claves nuevas generadas', 1);
    }).catch(function (e) {
      alert(String(e && e.message) === '403' ? 'Primero desbloquea tus fichas: abre la ficha de cualquier @V.persona e ingresa tu segunda clave.' : 'No se pudo completar (' + (e && e.message) + ').');
    });
  };

  var tabs = $('psxTabs'), panes = document.querySelectorAll('#psx .psx-pane');
  if (!ORG.col) ['bYear', 'rCur', 'fCur'].forEach(function (id) { $(id).style.display = 'none'; });
  if (ORG.ori) ['bImp', 'bAdd', 'bYear'].forEach(function (id) { $(id).style.display = 'none'; });
  // Fichas separadas por área: la tarjeta de la otra área no se muestra
  var TABLA_FICHA = { seg: 'tSeg', dec: 'tDec', plan: 'kan', vd: 'tVD', fs: 'tFs', beca: 'tBeca', red: 'tRed', entf: 'tEntf' };
  ORG.ocultas.forEach(function (k) { var el = $(TABLA_FICHA[k]); var card = el && el.closest('.psx-card'); if (card) card.style.display = 'none'; });   // eso lo hace el equipo o el administrador
  panes = Array.prototype.filter.call(panes, function (p) {
    var k = p.getAttribute('data-k');
    if (k && ORG.pl.indexOf(k) < 0) return false;   // planilla no activa: queda oculta y sin pestaña
    if (ORG.ori && k !== 'ori' && p.getAttribute('data-p') !== '@V.Personas') return false;   // orientadora: listado + orientación
    return true;
  });
  panes.forEach(function (p, i) {
    var b = document.createElement('button');
    b.className = 'psx-tab' + (i ? '' : ' on'); b.textContent = p.getAttribute('data-p');
    b.onclick = function () {
      tabs.querySelectorAll('.psx-tab').forEach(function (x) { x.classList.remove('on'); });
      panes.forEach(function (x) { x.classList.remove('on'); });
      b.classList.add('on'); p.classList.add('on');
    };
    tabs.appendChild(b); if (!i) p.classList.add('on');
  });
})();
</script>


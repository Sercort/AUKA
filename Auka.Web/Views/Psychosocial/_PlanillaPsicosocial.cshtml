      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok) throw new Error(j.error || r.status); return j; }); });
  };
  var cargarBen = function () {
    return fetch('/Psychosocial/Beneficios', { credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function (d) { ANIO = String(d.anio); SETS = d.sets; INV = d.inv.map(function (a) { return [a.n, a.ta, a.s, a.m, a.id]; }); drawSets(); drawInv(); })
      .catch(function () { /* sin conexión: se mantiene lo que se ve */ });

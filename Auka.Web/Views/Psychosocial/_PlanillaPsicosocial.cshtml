  // ---- Contacto y familia (solo datos de contacto: lo ve también la orientadora) ----
  // Un alumno/a puede tener varios apoderados/as (mamá, papá, abuela...) y un apoderado/a varios pupilos.
  var apoderadosHtml = function (aps) {
    if (!aps || !aps.length) return '<p class="psx-leg" style="margin:0">Sin apoderado/a registrado. Agrégalo con «+ Agregar apoderado/a».</p>';

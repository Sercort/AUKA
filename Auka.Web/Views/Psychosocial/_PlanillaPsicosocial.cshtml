        '<div style="display:flex;flex-wrap:wrap;gap:.3rem .8rem;align-items:center">' +
        '<b>' + esc(x.n) + '</b>' + c(esc(x.p), x.tit ? 'ok' : 'nil') + (x.tit ? '<span class="psx-leg" style="margin:0">Apoderado/a titular</span>' : '') +
        (x.mail ? '<a href="mailto:' + esc(x.mail.split(',')[0]) + '" style="text-decoration:none">✉️ ' + esc(x.mail) + '</a>' : '<span class="psx-leg" style="margin:0">Sin correo</span>') +
        (x.tel ? '<a href="tel:' + esc(x.tel) + '" style="text-decoration:none">📞 ' + esc(x.tel) + '</a>' : '') + '</div>' +

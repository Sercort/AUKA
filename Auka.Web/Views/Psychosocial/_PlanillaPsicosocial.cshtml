          function () { msg('Cambio de año simulado'); }, 'Aplicar');
      };

      // ---- Vacunación: listado por curso, exportable ----
      var VAC = [['Camila Andrea Ramírez Soto', '5° Básico', '24.000.001-1', '2015-03-14'], ['Sofía Paz Molina Vera', '1° Básico', '24.000.002-2', '2019-07-02'],
        ['Valentina Isabel Pérez Rojas', 'II° Medio', '24.000.003-3', '2010-11-21'], ['Isidora Belén Lagos Mena', '8° Básico', '24.000.004-4', '2012-05-09'],
        ['Javiera Constanza Tapia Díaz', '5° Básico', '24.000.005-5', '2015-09-30'], ['Antonia Ignacia Bravo Cruz', '4° Básico', '24.000.006-6', '2016-01-18'],
        ['Renata Fernanda Castro Núñez', '7° Básico', '24.000.007-7', '2013-04-25'], ['Emilia Sofía Vidal Pinto', '2° Básico', '24.000.009-9', '2018-02-11']];
      var edad = function (n) {
        var p = n.split('-'), h = new Date(), a = h.getFullYear() - +p[0];
        if (h < new Date(h.getFullYear(), +p[1] - 1, +p[2])) a--;
        return a;
      };
      var vSel = $('vCur'); vSel.innerHTML = curOpts;
      var vRows = function () { var f = vSel.value; return VAC.filter(function (x) { return !f || x[1] === f; }); };
      var vFila = function (x, i) { return [i + 1, x[0], x[1], x[2], x[3].split('-').reverse().join('-'), edad(x[3]) + ' años']; };
      var VH = ['N°', 'Nombre completo', 'Curso', 'RUT', 'Fecha de nacimiento', 'Edad'];
      var drawVac = function () { var r = vRows(); $('tVac').innerHTML = T(VH, r.map(vFila)); $('vN').textContent = r.length + ' alumnas'; };
      vSel.onchange = drawVac; drawVac();
      $('vPrn').onclick = function () { guia('Listado para vacunación', 'Curso: ' + (vSel.value || 'Todos'), [VH].concat(vRows().map(vFila)), true); };
      $('vCsv').onclick = function () {
        descargar('vacunacion.csv', '\ufeff' + VH.join(';') + '\n' + vRows().map(function (x, i) { return vFila(x, i).join(';'); }).join('\n'));
      };

      var tabs = $('psxTabs'), panes = document.querySelectorAll('#psx .psx-pane');
      panes.forEach(function (p, i) {
        var b = document.createElement('button');
        b.className = 'psx-tab' + (i ? '' : ' on'); b.textContent = p.getAttribute('data-p');
        b.onclick = function () {
          tabs.querySelectorAll('.psx-tab').forEach(function (x) { x.classList.remove('on'); });
          panes.forEach(function (x) { x.classList.remove('on'); });
          b.classList.add('on'); p.classList.add('on');
        };
        tabs.appendChild(b); if (!i) p.classList.add('on');
      });
    })();
</script>

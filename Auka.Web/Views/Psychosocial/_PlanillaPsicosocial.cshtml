      dlg(a[0] || '@V.Persona', '<p class="psx-leg" style="margin:0 0 .5rem"><span id="oriCurT">' + (a[1] ? esc(a[1]) + ' · ' : '') + '</span>RUT ' + esc(a[2]) +

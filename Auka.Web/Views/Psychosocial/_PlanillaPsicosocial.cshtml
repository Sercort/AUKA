  // ---- Listado real de @V.personas matriculados ----
  var ROS = null, ROSerr = '';
  var ordenCurso = function (c) { var i = NIV.indexOf(c.replace(/ [A-Za-z]$/, '')); return i < 0 ? 99 : i; };
  var llenarRos = function () {
    var cur = $('rCur').value, uniq = {};
    ROS.forEach(function (a) { uniq[a.c] = (uniq[a.c] || 0) + 1; });
    var nombres = Object.keys(uniq).sort(function (x, y) { return ordenCurso(x) - ordenCurso(y) || (x < y ? -1 : 1); });
    $('rCur').innerHTML = '<option value="">Todos los cursos</option>' + nombres.map(function (n) { return '<option value="' + n + '">' + n + ' (' + uniq[n] + ')</option>'; }).join('');
    $('rCur').value = cur; drawRos();
  };
  var drawRos = function () {
    if (ROS === 'error') { $('tRos').innerHTML = '<p class="psx-leg" style="color:#b42323">No se pudo cargar el listado (' + ROSerr + '). Abre la consola del navegador (F12) y revisa la pestaña Network.</p>'; return; }
    if (!ROS) return;
    if (!ROS.length) { $('rN').textContent = '0'; $('tRos').innerHTML = '<p class="psx-leg">Aún no hay @V.personas cargados. Usa «Importar planilla» o «+ Agregar @V.personas».</p>'; return; }
    var f = $('rCur').value, q = $('rTxt').value.trim().toLowerCase();
    var r = ROS.filter(function (a) { return (!f || a.c === f) && (!q || (a.n + ' ' + a.r).toLowerCase().indexOf(q) > -1); });
    $('rN').textContent = r.length + ' de ' + ROS.length + ' @V.personas';
    $('tRos').innerHTML = T(['N°', 'Nombre', 'RUT', 'Curso', 'Nacimiento', 'Edad', 'Ficha'], r.slice(0, 100).map(function (a, i) {
      return [i + 1, '<a href="#" class="ros-a" data-id="' + a.id + '" style="font-weight:600;color:#0d6efd;text-decoration:none">' + esc(a.n) + '</a>', a.r, a.c, a.f ? a.f.split('-').reverse().join('-') : '—', a.f ? edad(a.f) + ' años' : '—',
        '<button class="psx-btn ros-a" data-id="' + a.id + '">Abrir ficha</button>'];
    }));
  };
  $('rCur').onchange = drawRos; $('rTxt').oninput = drawRos;

  // ---- Ficha confidencial del @V.persona (pide la segunda clave) ----
  var esc = function (t) { return String(t == null ? '' : t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
  var fichaId = 0;

  // ---- Corregir el curso (equipo y orientadora). Siempre pide la clave: la segunda clave, o la de ingreso si no tiene ----
  var cambiarCurso = function (caja, id, actual, listo) {

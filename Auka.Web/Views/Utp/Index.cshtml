@* Auka.Web/Views/Utp/Index.cshtml — panel de la UTP: lo académico del colegio en una mirada.
   Cada sección es una tarjeta chica con su número y mini gráfico; al tocarla se abre con el detalle
   y la que estaba abierta se cierra sola (Views/Shared/_Acordeon.cshtml). *@
@model Auka.Web.Controllers.UtpController.PanelUtpVm
@using Auka.Web.Services
@using Auka.Web.Controllers
@{
    ViewData["Title"] = "Panel UTP";
    string N(decimal? n) => n is decimal v ? Csv.Nota1(v) : "—";
    string P(decimal? p) => p is decimal v ? v.ToString("0.#") + "%" : "—";
    int AnchoNota(decimal? n) => n is decimal v ? (int)Math.Clamp((v - 1m) / 6m * 100m, 4m, 100m) : 0;
    int AnchoPct(decimal? p) => p is decimal v ? (int)Math.Clamp(v, 3m, 100m) : 0;
    var pctRojas = Model.TotalNotas > 0 ? Math.Round(Model.NotasRojas * 100m / Model.TotalNotas, 1) : 0m;
    var cl = System.Globalization.CultureInfo.GetCultureInfo("es-CL");
    var esHoyAs = Model.DiaAsistencia == AsistenciaController.Hoy;
    var diaAs = esHoyAs ? "hoy" : Model.DiaAsistencia.ToString("dddd d", cl);
    var alertasConv = Model.Convivencia.Count(c => c.Nivel == Alertas.Nivel.Alerta);
    var pendientes = Model.HorariosPorAprobar + Model.HorariosConComentario + Model.SolicitudesCambio + Model.InteresadosClubes + Model.CursosSinJefe;
    // Evaluaciones por día (próximos 7)
    var hoy = DateTime.UtcNow.Date;
    var evalDias = Enumerable.Range(0, 7).Select(i => hoy.AddDays(i)).Where(d => d.DayOfWeek is not (DayOfWeek.Saturday or DayOfWeek.Sunday))
        .Select(d => (d.ToString("ddd d", cl), Model.Semana.Count(e => e.Fecha.Date == d), "linear-gradient(180deg,#5b8def,#2459b0)")).ToList();
    // Listas no pasadas agrupadas por curso (para no mostrar 100 filas)
    var noPorCurso = Model.NoPasadas.GroupBy(f => f.Curso).OrderByDescending(g => g.Count()).ThenBy(g => Niveles.Orden(g.Key)).ToList();
    string NivelDe(string c) { var i = c.LastIndexOf(' '); return i > 0 && c.Length - i <= 2 ? c[..i] : c; }
    var porNivel = Model.Cursos.GroupBy(c => NivelDe(c.Curso)).OrderBy(g => Niveles.Orden(g.Key))
        .Select(g => (g.Key.Replace("Básico", "B").Replace("Medio", "M").Replace(" ", ""), g.Sum(x => x.Alumnos), Niveles.Orden(g.Key) >= 10 ? "linear-gradient(180deg,#9b8cff,#6c5ce7)" : "linear-gradient(180deg,#5fd3df,#1fb5c5)")).ToList();
    var riesgoPorCurso = Model.Riesgo.GroupBy(r => r.Curso).Select(g => (g.Key, g.Count(), "linear-gradient(180deg,#ef8f6c,#d64545)")).OrderByDescending(x => x.Item2).Take(8).ToList();
}

<div class="au-head compacto" style="background:linear-gradient(120deg,#2459b0,#1fb5c5)">
    <div class="ico">📈</div>
    <div class="txt">
        <h2>¡@Saludo.Ahora(), @Model.Nombre! 👋</h2>
        <p>Toca una tarjeta para ver su detalle. Al abrir otra, la anterior se cierra.</p>
    </div>
    <div class="acc">
        <a asp-controller="Notas" asp-action="Index">📊 Libro de notas</a>
        <a asp-controller="Evaluaciones" asp-action="Index">📝 Evaluaciones</a>
        <a asp-controller="Horarios" asp-action="Index" class="blanco">🗓️ Horarios</a>
    </div>
</div>

@if (Model.EsUtp && pendientes > 0)
{
    <div class="d-flex gap-2 flex-wrap align-items-center mb-3">
        <b class="small" style="color:var(--a-navy)">📌 Pendientes:</b>
        @if (Model.HorariosPorAprobar > 0) { <a class="au-chip teal" href="/Horarios/Profesores">✅ @Model.HorariosPorAprobar horarios por aprobar</a> }
        @if (Model.HorariosConComentario > 0) { <a class="au-chip coral" href="/Horarios/Profesores">✋ @Model.HorariosConComentario comentarios de horario</a> }
        @if (Model.SolicitudesCambio > 0) { <a class="au-chip sol" href="/Horarios/Profesores">🔁 @Model.SolicitudesCambio cambios por responder</a> }
        @if (Model.InteresadosClubes > 0) { <a class="au-chip violeta" href="/Talleres/Interesados">🙋 @Model.InteresadosClubes interesados en clubes</a> }
        @if (Model.CursosSinJefe > 0) { <a class="au-chip" href="/Cursos">👩‍🏫 @Model.CursosSinJefe cursos sin profesor/a jefe</a> }
    </div>
}

<div class="acd" data-acd="utp">

    @* ================= Asistencia no pasada ================= *@
    @if (Model.EsUtp)
    {
        <section class="acd-it" data-id="nopasada" style="--c:@(Model.AsistenciaNoPasada > 0 ? "#d64545" : "#16915c")" data-abrir="@(Model.AsistenciaNoPasada > 0 ? "1" : null)">
            <button type="button" class="acd-h">
                <span class="acd-ic">⛔</span>
                <span class="acd-t"><b>Listas no pasadas</b><small style="text-transform:capitalize">@diaAs · @noPorCurso.Count cursos</small></span>
                <span class="acd-n">@Model.AsistenciaNoPasada</span>
                <span class="acd-fl">▾</span>
            </button>
            <div class="acd-b"><div><div class="acd-in">
                @if (Model.NoPasadas.Count == 0)
                {
                    <p class="acd-vacio">✅ Todas las clases que ya terminaron (hace más de @AsistenciaController.HorasCierre horas) tienen su asistencia.</p>
                }
                else
                {
                    <div class="acd-sub">Se cerraron solas @AsistenciaController.HorasCierre h después de la clase · como UTP puedes pasarlas <a href="/Asistencia?fecha=@Model.DiaAsistencia.ToString("yyyy-MM-dd")">Ver el día completo →</a></div>
                    <div class="acd-cols">
                        <div>
                            <div class="acd-sub">Por curso</div>
                            @Graficos.Columnas(noPorCurso.Take(10).Select(g => (g.Key, g.Count(), "linear-gradient(180deg,#ef8f6c,#d64545)")).ToList(), 90)
                        </div>
                        <div class="acd-lista">
                            @foreach (var g in noPorCurso)
                            {
                                <details class="mb-1">
                                    <summary class="fw-bold small" style="cursor:pointer;color:var(--a-navy)">@g.Key <span class="au-chip coral ms-1">@g.Count()</span></summary>
                                    @foreach (var f in g)
                                    {
                                        <div class="acd-fila">
                                            <b style="width:46px">@f.Inicio.ToString("hh\\:mm")</b>
                                            <div class="x">@f.Asignatura<br /><small>@f.Profesor</small></div>
                                            <a class="btn btn-success btn-sm px-2" href="/Asistencia/Lista?cursoId=@f.CursoId&bloqueId=@f.BloqueId&fecha=@Model.DiaAsistencia.ToString("yyyy-MM-dd")">✅ Pasar</a>
                                        </div>
                                    }
                                </details>
                            }
                        </div>
                    </div>
                }
            </div></div></div>
        </section>
    }

    @* ================= Asistencia ================= *@
    <section class="acd-it" data-id="asistencia" style="--c:@Graficos.ColorAsistencia(Model.PorcentajeAsistencia)">
        <button type="button" class="acd-h">
            @Graficos.Dona(Model.PorcentajeAsistencia, Graficos.ColorAsistencia(Model.PorcentajeAsistencia), null, 58)
            <span class="acd-t"><b>Asistencia del año</b><small>@(Model.PorcentajeAsistencia == null ? "aún no se pasan listas" : "mínimo exigido 85%")</small></span>
            @Graficos.Spark(Model.AsistenciaDias.Select(d => d.Pct).ToList(), Graficos.ColorAsistencia(Model.PorcentajeAsistencia))
            <span class="acd-fl">▾</span>
        </button>
        <div class="acd-b"><div><div class="acd-in">
            <div class="acd-cols">
                <div>
                    <div class="acd-sub">Últimos días con listas <a href="/Asistencia">Asistencia →</a></div>
                    @Graficos.Linea(Model.AsistenciaDias.Select(d => d.Pct).ToList(), Model.AsistenciaDias.Select(d => d.Dia.ToString("d MMM", cl)).ToList(), 50, 100, "#1fb5c5", 85, "%")
                    <div class="gx-leyenda"><span><i style="background:#1fb5c5"></i>% de asistencia</span><span><i style="background:#d64545"></i>mínimo 85%</span></div>
                </div>
                <div>
                    <div class="acd-sub">Por curso (más baja arriba)</div>
                    <div class="acd-lista">
                        @foreach (var c in Model.AsistenciaCursos)
                        {
                            <div class="acd-bar"><a href="/Asistencia/Curso/@c.Id">@c.Curso</a><div class="t"><span style="width:@AnchoPct(c.Pct)%;background:@Graficos.ColorAsistencia(c.Pct)"></span></div><b style="color:@Graficos.ColorAsistencia(c.Pct)">@P(c.Pct)</b></div>
                        }
                        @if (Model.AsistenciaCursos.Count == 0) { <p class="acd-vacio">Aún no hay listas pasadas este año.</p> }
                    </div>
                </div>
            </div>
        </div></div></div>
    </section>

    @* ================= Rendimiento ================= *@
    <section class="acd-it" data-id="rendimiento" style="--c:@Graficos.ColorNota(Model.PromedioColegio)" data-abrir="@(Model.AsistenciaNoPasada == 0 ? "1" : null)">
        <button type="button" class="acd-h">
            <span class="acd-ic">📊</span>
            <span class="acd-t"><b>Rendimiento</b><small>@Model.TotalNotas.ToString("N0", cl) notas · @pctRojas.ToString("0.#", cl)% rojas</small></span>
            @Graficos.Spark(Model.TendenciaNotas.Select(t => t.Promedio).ToList(), Graficos.ColorNota(Model.PromedioColegio))
            <span class="acd-n">@N(Model.PromedioColegio)</span>
            <span class="acd-fl">▾</span>
        </button>
        <div class="acd-b"><div><div class="acd-in">
            <div class="acd-cols">
                <div>
                    <div class="acd-sub">Promedio mes a mes</div>
                    @Graficos.Linea(Model.TendenciaNotas.Select(t => t.Promedio).ToList(), Model.TendenciaNotas.Select(t => t.Mes).ToList(), 1, 7, "#2459b0", 4)
                    <div class="gx-leyenda"><span><i style="background:#2459b0"></i>promedio del colegio</span><span><i style="background:#d64545"></i>nota 4,0</span></div>
                </div>
                <div>
                    <div class="acd-sub">¿Cómo se reparten las notas?</div>
                    @Graficos.Columnas(Graficos.Distribucion(Model.NotasAnio), 100)
                </div>
            </div>
            <div class="acd-cols mt-3">
                <div>
                    <div class="acd-sub">Por curso (más bajo arriba) <a asp-controller="Notas" asp-action="Index">Libros →</a></div>
                    <div class="acd-lista">
                        @foreach (var c in Model.Cursos)
                        {
                            <div class="acd-bar"><a href="/Notas/Libro?cursoId=@c.Id">@c.Curso</a><div class="t"><span style="width:@AnchoNota(c.Promedio)%;background:@Graficos.ColorNota(c.Promedio)"></span></div><b style="color:@Graficos.ColorNota(c.Promedio)">@N(c.Promedio)</b></div>
                        }
                    </div>
                </div>
                <div>
                    <div class="acd-sub">Por asignatura</div>
                    <div class="acd-lista">
                        @foreach (var r in Model.Ramos)
                        {
                            <div class="acd-bar"><span title="@r.Ramo">@Ramos.Estilo(r.Ramo).Icono @r.Ramo</span><div class="t"><span style="width:@AnchoNota(r.Promedio)%;background:@Graficos.ColorNota(r.Promedio)"></span></div><b style="color:@Graficos.ColorNota(r.Promedio)">@N(r.Promedio)</b></div>
                        }
                        @if (Model.Ramos.Count == 0) { <p class="acd-vacio">Aún no hay notas.</p> }
                    </div>
                </div>
            </div>
        </div></div></div>
    </section>

    @* ================= Riesgo ================= *@
    <section class="acd-it" data-id="riesgo" style="--c:@(Model.TotalRiesgo > 0 ? "#d64545" : "#16915c")">
        <button type="button" class="acd-h">
            <span class="acd-ic">⚠️</span>
            <span class="acd-t"><b>En riesgo de repetir</b><small>promedio bajo 4,0 o 3+ ramos en rojo</small></span>
            <span class="acd-n">@Model.TotalRiesgo</span>
            <span class="acd-fl">▾</span>
        </button>
        <div class="acd-b"><div><div class="acd-in">
            @if (Model.Riesgo.Count == 0)
            {
                <p class="acd-vacio">🎉 No hay alumnos/as en riesgo.</p>
            }
            else
            {
                <div class="acd-cols">
                    <div>
                        <div class="acd-sub">Cursos con más casos</div>
                        @Graficos.Columnas(riesgoPorCurso, 90)
                    </div>
                    <div>
                        <div class="acd-sub">Los @Model.Riesgo.Count más urgentes</div>
                        <div class="acd-lista">
                            @foreach (var a in Model.Riesgo)
                            {
                                <div class="acd-fila">
                                    <span class="au-chip coral" style="min-width:46px;justify-content:center">@N(a.Promedio)</span>
                                    <div class="x"><a href="/Cursos/Ficha/@a.EstudianteId" class="fw-bold text-decoration-none">@a.Nombre</a><br /><small>@a.Curso · @a.RamosRojos en rojo@(a.Negativas > 0 ? " · " + a.Negativas + " anot. negativas" : "")</small></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div></div></div>
    </section>

    @* ================= Evaluaciones ================= *@
    <section class="acd-it" data-id="evaluaciones" style="--c:#2459b0">
        <button type="button" class="acd-h">
            <span class="acd-ic">📝</span>
            <span class="acd-t"><b>Evaluaciones</b><small>próximos 7 días</small></span>
            <span class="acd-n">@Model.Semana.Count</span>
            <span class="acd-fl">▾</span>
        </button>
        <div class="acd-b"><div><div class="acd-in">
            <div class="acd-cols">
                <div>
                    <div class="acd-sub">Cuántas hay cada día <a asp-controller="Evaluaciones" asp-action="Index">Calendario →</a></div>
                    @Graficos.Columnas(evalDias, 90)
                </div>
                <div class="acd-lista">
                    @foreach (var e in Model.Semana)
                    {
                        <div class="acd-fila">
                            <span class="au-chip verde" style="min-width:64px;justify-content:center;text-transform:capitalize">@e.Fecha.ToString("ddd d", cl)</span>
                            <div class="x"><a href="/Evaluaciones?cursoId=@e.CursoId" class="fw-bold text-decoration-none">@e.Curso</a> · @e.Ramo<br /><small>@(e.Tipo ?? "Evaluación") · @e.Titulo</small></div>
                        </div>
                    }
                    @if (Model.Semana.Count == 0) { <p class="acd-vacio">No hay evaluaciones esta semana.</p> }
                </div>
            </div>
        </div></div></div>
    </section>

    @* ================= Profesores sin notas ================= *@
    <section class="acd-it" data-id="atrasados" style="--c:@(Model.Atrasados.Count > 0 ? "#e09a00" : "#16915c")">
        <button type="button" class="acd-h">
            <span class="acd-ic">⏰</span>
            <span class="acd-t"><b>Profes sin notas</b><small>más de 30 días sin registrar</small></span>
            <span class="acd-n">@Model.Atrasados.Count</span>
            <span class="acd-fl">▾</span>
        </button>
        <div class="acd-b"><div><div class="acd-in">
            <div class="acd-lista">
                @foreach (var p in Model.Atrasados)
                {
                    <div class="acd-fila">
                        <span class="au-chip sol" style="min-width:64px;justify-content:center">@(p.UltimaNota == null ? "Nunca" : p.Dias + " días")</span>
                        <div class="x"><a href="/Horarios/Profesor/@p.Id" class="fw-bold text-decoration-none">@p.Nombre</a><br /><small>@p.Ramos</small></div>
                    </div>
                }
                @if (Model.Atrasados.Count == 0) { <p class="acd-vacio">✅ Todos registraron notas en los últimos 30 días.</p> }
            </div>
        </div></div></div>
    </section>

    @* ================= Convivencia ================= *@
    <section class="acd-it" data-id="convivencia" style="--c:@(alertasConv > 0 ? "#d64545" : "#16915c")">
        <button type="button" class="acd-h">
            <span class="acd-ic">📋</span>
            <span class="acd-t"><b>Convivencia</b><small>anotaciones de los últimos 30 días</small></span>
            <span class="acd-n">@(alertasConv)<small style="font-size:.6rem;font-weight:800;color:var(--a-mut)"> alertas</small></span>
            <span class="acd-fl">▾</span>
        </button>
        <div class="acd-b"><div><div class="acd-in">
            @if (Model.Convivencia.Count == 0)
            {
                <p class="acd-vacio">Sin cursos en alerta. 👏</p>
            }
            else
            {
                <div class="acd-cols">
                    <div>
                        <div class="acd-sub">Negativas vs positivas <a asp-controller="Anotaciones" asp-action="Index">Libro →</a></div>
                        @foreach (var c in Model.Convivencia)
                        {
                            var tot = Math.Max(1, c.Negativas + c.Positivas);
                            <div class="acd-bar">
                                <span>@c.Curso</span>
                                <div class="t" style="display:flex"><span style="width:@(c.Negativas * 100 / tot)%;background:#d64545;border-radius:999px 0 0 999px"></span><span style="width:@(c.Positivas * 100 / tot)%;background:#16915c;border-radius:0 999px 999px 0"></span></div>
                                <b class="small">@c.Negativas/@c.Positivas</b>
                            </div>
                        }
                        <div class="gx-leyenda"><span><i style="background:#d64545"></i>negativas</span><span><i style="background:#16915c"></i>positivas</span></div>
                    </div>
                    <div class="acd-lista">
                        @foreach (var c in Model.Convivencia)
                        {
                            var chip = c.Nivel == Alertas.Nivel.Alerta ? "coral" : c.Nivel == Alertas.Nivel.Atencion ? "sol" : "verde";
                            var txt = c.Nivel == Alertas.Nivel.Alerta ? "🔴 Alerta" : c.Nivel == Alertas.Nivel.Atencion ? "🟠 Atención" : "🌟 Destacado";
                            <div class="acd-fila">
                                <span class="au-chip @chip" style="min-width:96px;justify-content:center">@txt</span>
                                <div class="x"><b>@c.Curso</b><br /><small>@c.Motivo</small></div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div></div></div>
    </section>

    @* ================= Matrícula ================= *@
    <section class="acd-it" data-id="matricula" style="--c:#6c5ce7">
        <button type="button" class="acd-h">
            <span class="acd-ic">👥</span>
            <span class="acd-t"><b>Matrícula</b><small>@Model.Cursos.Count cursos@(Model.CursosSinJefe > 0 ? " · " + Model.CursosSinJefe + " sin profe jefe" : "")</small></span>
            <span class="acd-n">@Model.Alumnos.ToString("N0", cl)</span>
            <span class="acd-fl">▾</span>
        </button>
        <div class="acd-b"><div><div class="acd-in">
            <div class="acd-sub">Alumnos/as por nivel <a href="/Cursos">Cursos →</a></div>
            @Graficos.Columnas(porNivel, 110)
            <div class="gx-leyenda"><span><i style="background:#1fb5c5"></i>básica</span><span><i style="background:#6c5ce7"></i>media</span></div>
        </div></div></div>
    </section>
</div>

@* Vista rápida: se ve mientras no hay ninguna tarjeta abierta *@
<div class="acd-resumen">
    <div class="au-card">
        <h4>📈 Promedio mes a mes <small>colegio</small></h4>
        @Graficos.Linea(Model.TendenciaNotas.Select(t => t.Promedio).ToList(), Model.TendenciaNotas.Select(t => t.Mes).ToList(), 1, 7, "#2459b0", 4)
    </div>
    <div class="au-card">
        <h4>✅ Asistencia por día <small>últimos días con listas</small></h4>
        @Graficos.Linea(Model.AsistenciaDias.Select(d => d.Pct).ToList(), Model.AsistenciaDias.Select(d => d.Dia.ToString("d MMM", cl)).ToList(), 50, 100, "#1fb5c5", 85, "%")
    </div>
    <div class="au-card">
        <h4>🎯 Cómo se reparten las notas <small>@Model.TotalNotas.ToString("N0", cl) notas</small></h4>
        @Graficos.Columnas(Graficos.Distribucion(Model.NotasAnio), 96)
    </div>
</div>

<partial name="_Acordeon" />

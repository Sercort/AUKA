@model IEnumerable<EduNexus.Application.Entities.Curso>

@{
    ViewData["Title"] = "Gestión de Horarios";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">⏰ Horario de Clases por Curso</h2>
            <p class="text-muted mb-0">Selecciona un curso para configurar o consultar su matriz horaria semanal.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            Volver al Panel
        </a>
    </div>

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">No hay cursos registrados para gestionar horarios.</p>
            </div>
        }
        else
        {
            @foreach (var curso in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center py-3">
                            <h5 class="mb-0 fw-bold">@curso.Nombre "@curso.Letra"</h5>
                            <span class="badge bg-light text-dark fw-bold">@curso.AnioAcademico</span>
                        </div>
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <p class="text-muted mb-2">
                                    👨‍🏫 <strong>Profesor Jefe:</strong>
                                    @(curso.ProfesorJefe != null ? $"{curso.ProfesorJefe.Nombre} {curso.ProfesorJefe.Apellido}" : "Sin asignar")
                                </p>
                            </div>
                            <div class="text-end mt-3">
                                <a asp-controller="Horarios" asp-action="Curso" asp-route-id="@curso.Id" class="btn btn-outline-secondary rounded-pill btn-sm px-3 fw-bold">
                                    Configurar Horario ➔
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
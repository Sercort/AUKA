@model IEnumerable<EduNexus.Application.Entities.HorarioClase>

@{
    var curso = ViewBag.Curso as EduNexus.Application.Entities.Curso;
    ViewData["Title"] = $"Horario - {curso?.Nombre} {curso?.Letra}";
    var esAdmin = User.IsInRole("UTP") || User.IsInRole("Director") || User.IsInRole("SuperAdmin");
    var dias = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday };
    var nombresDias = new[] { "Lunes", "Martes", "Miércoles", "Jueves", "Viernes" };
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">📅 Horario de Clases: @curso?.Nombre "@curso?.Letra"</h2>
            <p class="text-muted mb-0">Entrada: 08:00 hrs | Viernes salida corta a las 13:00 hrs.</p>
        </div>
        <div class="d-flex gap-2">
            @if (esAdmin && Model != null && Model.Any())
            {
                <form asp-action="LimpiarHorarioCurso" method="post" id="formLimpiarTodo">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="cursoId" value="@curso?.Id" />
                    <button type="button" onclick="confirmarLimpiarTodo()" class="btn btn-outline-danger rounded-pill px-3 fw-bold">
                        🗑️ Vaciar Horario Completo
                    </button>
                </form>
            }
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Volver a Selección</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            ✅ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered text-center align-middle mb-0">
                    <thead class="table-primary">
                        <tr>
                            <th style="width: 150px;">Bloque / Hora</th>
                            @for (int i = 0; i < nombresDias.Length; i++)
                            {
                                <th>@nombresDias[i]</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <!-- BLOQUE 1 -->
                        @Html.Raw(RenderFilaBloque(1, "08:00 - 08:45", dias, esAdmin, false, curso?.Id ?? 0))
                        <!-- BLOQUE 2 -->
                        @Html.Raw(RenderFilaBloque(2, "08:50 - 09:35", dias, esAdmin, false, curso?.Id ?? 0))

                        <!-- RECREO Y DESAYUNO -->
                        <tr class="table-warning text-dark fw-bold">
                            <td class="py-2">☕ RECREO</td>
                            <td colspan="5" class="py-2">09:35 - 09:50 (Desayuno / Recreo)</td>
                        </tr>

                        <!-- BLOQUE 3 -->
                        @Html.Raw(RenderFilaBloque(3, "09:50 - 10:35", dias, esAdmin, false, curso?.Id ?? 0))
                        <!-- BLOQUE 4 -->
                        @Html.Raw(RenderFilaBloque(4, "10:40 - 11:25", dias, esAdmin, false, curso?.Id ?? 0))

                        <!-- RECREO -->
                        <tr class="table-warning text-dark fw-bold">
                            <td class="py-2">🔔 RECREO</td>
                            <td colspan="5" class="py-2">11:25 - 11:35</td>
                        </tr>

                        <!-- BLOQUE 5 -->
                        @Html.Raw(RenderFilaBloque(5, "11:35 - 12:20", dias, esAdmin, false, curso?.Id ?? 0))
                        <!-- BLOQUE 6 -->
                        @Html.Raw(RenderFilaBloque(6, "12:20 - 13:00", dias, esAdmin, false, curso?.Id ?? 0))

                        <!-- HORA DE ALMUERZO -->
                        <tr class="table-info text-dark fw-bold">
                            <td class="py-2">🍕 ALMUERZO</td>
                            <td colspan="4" class="py-2">13:00 - 14:00 (Almuerzo Institucional)</td>
                            <td class="table-secondary text-muted">🔒 Salida Viernes 13:00</td>
                        </tr>

                        <!-- BLOQUE 7 (TARDE) -->
                        @Html.Raw(RenderFilaBloque(7, "14:00 - 14:50", dias, esAdmin, true, curso?.Id ?? 0))
                        <!-- BLOQUE 8 (TARDE) -->
                        @Html.Raw(RenderFilaBloque(8, "14:55 - 16:00", dias, esAdmin, true, curso?.Id ?? 0))
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Asignar / Reasignar Asignatura y Profesor -->
<div class="modal fade" id="modalAsignarBloque" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalTitulo">📌 Asignar Clase</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="GuardarBloque" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="cursoId" value="@curso?.Id" />
                    <input type="hidden" id="inputNumeroBloque" name="numeroBloque" value="" />
                    <input type="hidden" id="inputDiaSemana" name="diaSemana" value="" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">1. Seleccionar Asignatura</label>
                        <select id="selectAsignatura" name="asignaturaId" class="form-select" onchange="cargarProfesoresDisponibles()" required>
                            <option value="" disabled selected>-- Seleccione Asignatura --</option>
                            @if (ViewBag.Asignaturas != null)
                            {
                                foreach (var asig in (IEnumerable<EduNexus.Application.Entities.Asignatura>)ViewBag.Asignaturas)
                                {
                                    <option value="@asig.Id">@asig.Nombre</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">2. Profesor Disponible</label>
                        <select id="selectProfesor" name="docenteId" class="form-select" required>
                            <option value="">-- Seleccione Profesor --</option>
                            @if (ViewBag.Profesores != null)
                            {
                                foreach (var prof in (IEnumerable<EduNexus.Application.Entities.Usuario>)ViewBag.Profesores)
                                {
                                    <option value="@prof.Id">👨‍🏫 @prof.Nombre @prof.Apellido @(!string.IsNullOrEmpty(prof.Asignaturas) ? $"({prof.Asignaturas})" : "")</option>
                                }
                            }
                        </select>
                        <small class="text-muted d-block mt-1">Solo se muestran profesores configurados en el sistema.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">3. Sala / Taller (Opcional)</label>
                        <input type="text" name="sala" class="form-control" placeholder="Ej: Sala 12, Laboratorio, Cancha" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Guardar Bloque</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Formulario Oculto para Eliminar Bloque Individual -->
<form id="formEliminarBloque" asp-action="EliminarBloque" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="elemCursoId" name="cursoId" />
    <input type="hidden" id="elemNumeroBloque" name="numeroBloque" />
    <input type="hidden" id="elemDiaSemana" name="diaSemana" />
</form>

@functions {
    public string RenderFilaBloque(int numBloque, string horario, DayOfWeek[] dias, bool esAdmin, bool esTarde, int cursoId)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append($"<tr><td class='table-light fw-bold'>Bloque {numBloque}<br/><small class='text-muted'>{horario}</small></td>");

        for (int i = 0; i < dias.Length; i++)
        {
            var diaActual = dias[i];
            string diaTexto = diaActual.ToString();

            if (esTarde && diaActual == DayOfWeek.Friday)
            {
                sb.Append("<td class='table-secondary text-muted fw-bold align-middle'>🔒 Salida</td>");
            }
            else
            {
                sb.Append("<td>");
                if (esAdmin)
                {
                    sb.Append($"<button class='btn btn-outline-primary btn-sm rounded-pill px-3' onclick='abrirModalAsignacion({numBloque}, \"{diaTexto}\")'>➕ Asignar</button>");
                }
                else
                {
                    sb.Append("<span class='text-muted small'>Libre</span>");
                }
                sb.Append("</td>");
            }
        }
        sb.Append("</tr>");
        return sb.ToString();
    }
}

<script>
    let numBloqueActual = 0;
    let diaSemanaActual = '';

    function abrirModalAsignacion(numBloque, dia) {
        numBloqueActual = numBloque;
        diaSemanaActual = dia;

        document.getElementById('inputNumeroBloque').value = numBloque;
        document.getElementById('inputDiaSemana').value = dia;
        document.getElementById('modalTitulo').innerText = `📌 Asignar Bloque ${numBloque} (${dia})`;

        var myModal = new bootstrap.Modal(document.getElementById('modalAsignarBloque'));
        myModal.show();
    }

    function cargarProfesoresDisponibles() {
        const asignaturaId = document.getElementById('selectAsignatura').value;
        const selectProfesor = document.getElementById('selectProfesor');

        if (!asignaturaId) return;

        fetch(`/Horarios/ObtenerProfesoresDisponibles?asignaturaId=${asignaturaId}&numeroBloque=${numBloqueActual}&diaSemana=${diaSemanaActual}`)
            .then(response => {
                if (!response.ok) throw new Error("No API endpoint");
                return response.json();
            })
            .then(data => {
                if (data && data.length > 0) {
                    selectProfesor.innerHTML = '<option value="" disabled selected>-- Seleccione Profesor --</option>';
                    data.forEach(profesor => {
                        const option = document.createElement('option');
                        option.value = profesor.id;
                        option.textContent = `👨‍🏫 ${profesor.nombreCompleto}`;
                        selectProfesor.appendChild(option);
                    });
                }
            })
            .catch(error => {
                console.log("Utilizando lista general de docentes.");
            });
    }

    function confirmarEliminarBloque(cursoId, numeroBloque, diaSemana, asignatura) {
        const respuesta = confirm(`¿Estás seguro de remover la clase de "${asignatura}" en este bloque?`);
        if (respuesta) {
            document.getElementById('elemCursoId').value = cursoId;
            document.getElementById('elemNumeroBloque').value = numeroBloque;
            document.getElementById('elemDiaSemana').value = diaSemana;
            document.getElementById('formEliminarBloque').submit();
        }
    }

    function confirmarLimpiarTodo() {
        const primera = confirm("⚠️ ATENCIÓN: ¿Estás seguro de que deseas ELIMINAR TODO EL HORARIO de este curso?");
        if (primera) {
            const segunda = confirm("🚨 CONFIRMACIÓN FINAL: Se borrarán todas las clases asignadas a este curso. ¿Realmente estás seguro?");
            if (segunda) {
                document.getElementById('formLimpiarTodo').submit();
            }
        }
    }
</script>
@model EduNexus.Application.Entities.Usuario

@{
    ViewData["Title"] = "Agregar Personal";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="mb-0 fw-bold">👨‍🏫 Registrar Nuevo Funcionario</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post">

                        <div class="mb-3">
                            <label class="form-label fw-semibold">RUT</label>
                            <input asp-for="Rut" class="form-control" placeholder="12345678-9" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Nombre" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Apellido</label>
                            <input asp-for="Apellido" class="form-control" placeholder="Apellido" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Correo Electrónico</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="correo@edunexus.cl" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Contraseña Inicial</label>
                            <input asp-for="PasswordHash" class="form-control" value="Clave123*" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Rol / Cargo Institucional</label>
                            <select asp-for="Rol" class="form-select" required>
                                <option value="">-- Seleccionar Rol --</option>
                                <option value="Director">Director</option>
                                <option value="UTP">UTP</option>
                                <option value="Docente">Docente / Profesor</option>
                                <option value="Inspector">Inspector</option>
                                <option value="Psicopedagogo">Psicopedagogo (PIE)</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Guardar Funcionario</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
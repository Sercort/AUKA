@{
    ViewData["Title"] = "Proceso de Matrícula";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">📝 Proceso de Matrícula e Inscripción</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Matricular" method="post">
                        @Html.AntiForgeryToken()

                        <!-- TIPO DE MATRÍCULA -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tipo de Matrícula</label>
                            <select name="tipoMatricula" class="form-select" required>
                                <option value="0">Alumno Nuevo (Asignación Automática de Letra)</option>
                                <option value="1">Renovación (Alumno Antiguo - Mantiene Curso)</option>
                                <option value="2">Traslado de otro Colegio</option>
                            </select>
                        </div>

                        <hr />

                        <!-- SECCIÓN 1: DATOS DEL ESTUDIANTE -->
                        <h5 class="fw-bold text-primary mb-3">👤 Datos del Estudiante</h5>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">RUT del Estudiante</label>
                            <input type="text" name="rut" class="form-control" placeholder="12345678-9" required />
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Nombre</label>
                                <input type="text" name="nombre" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Apellido</label>
                                <input type="text" name="apellido" class="form-control" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Correo Electrónico</label>
                            <input type="email" name="email" class="form-control" placeholder="estudiante@edunexus.cl" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Nivel / Especialidad al que Postula</label>
                            <select name="nivel" class="form-select rounded-3" asp-items="ViewBag.Niveles" required>
                                <option value="" disabled selected>-- Seleccione Nivel o Especialidad --</option>
                            </select>
                            <small class="text-muted d-block mt-1">Si es alumno nuevo, el sistema le asignará una letra (A, B, C...) de forma equitativa dentro de la especialidad elegida.</small>
                        </div>

                        <hr />

                        <!-- SECCIÓN 2: DATOS DEL APODERADO Y CONTACTO FAMILIAR -->
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h5 class="fw-bold text-primary mb-0">👨‍👩‍👧 Datos del Apoderado Responsable</h5>
                        </div>
                        <p class="text-muted small mb-3">Si el apoderado ya tiene otros hijos matriculados en el colegio, ingresa su RUT para enlazar automáticamente la cuenta familiar.</p>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">RUT Apoderado</label>
                            <input type="text" name="rutApoderado" class="form-control" placeholder="12345678-K" required />
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Nombre Apoderado</label>
                                <input type="text" name="nombreApoderado" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Apellido Apoderado</label>
                                <input type="text" name="apellidoApoderado" class="form-control" required />
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Correo Apoderado</label>
                                <input type="email" name="emailApoderado" class="form-control" placeholder="apoderado@gmail.com" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Teléfono de Contacto / Celular</label>
                                <input type="tel" name="telefonoContacto" class="form-control" placeholder="+56 9 1234 5678" required />
                            </div>
                        </div>

                        <!-- BOTONES DE ACCIÓN -->
                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Finalizar Matrícula</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registro Institucional - EduNexus</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            body {
                background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 30px 15px;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .card-registro {
                background: #ffffff;
                border-radius: 15px;
                box-shadow: 0 10px 25px rgba(0,0,0,0.2);
                padding: 40px;
                width: 100%;
                max-width: 550px;
            }

            .btn-primary-custom {
                background-color: #2a5298;
                border: none;
                padding: 12px;
                font-weight: 600;
            }

                .btn-primary-custom:hover {
                    background-color: #1e3c72;
                }
    </style>
</head>
<body>

    <div class="card-registro">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-primary" style="color: #1e3c72 !important;">EduNexus</h2>
            <p class="text-muted small">Registro de Nuevo Establecimiento Educacional</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 mb-3" role="alert">
                <small>⚠️ @ViewBag.Error</small>
            </div>
        }

        <form method="post" asp-controller="Account" asp-action="Registrar">
            @Html.AntiForgeryToken()

            <h6 class="fw-bold text-secondary mb-3">🏫 Datos de la Institución</h6>

            <div class="form-floating mb-3">
                <input type="text" class="form-control" id="nombreColegio" name="nombreColegio" placeholder="Nombre Colegio" required />
                <label for="nombreColegio">Nombre del Establecimiento</label>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-6 form-floating">
                    <input type="text" class="form-control" id="rbd" name="rbd" placeholder="RBD" required />
                    <label for="rbd">RBD / Cód. Oficial</label>
                </div>
                <div class="col-md-6 form-floating">
                    <input type="tel" class="form-control" id="telefonoColegio" name="telefonoColegio" placeholder="Teléfono" />
                    <label for="telefonoColegio">Teléfono Contacto</label>
                </div>
            </div>

            <div class="form-floating mb-4">
                <input type="text" class="form-control" id="direccion" name="direccion" placeholder="Dirección" />
                <label for="direccion">Dirección Institucional</label>
            </div>

            <hr class="my-4 text-muted" />

            <h6 class="fw-bold text-secondary mb-3">👤 Cuenta del Administrador / Director</h6>

            <div class="row g-2 mb-3">
                <div class="col-md-6 form-floating">
                    <input type="text" class="form-control" id="nombreAdmin" name="nombreAdmin" placeholder="Nombre" required />
                    <label for="nombreAdmin">Nombre</label>
                </div>
                <div class="col-md-6 form-floating">
                    <input type="text" class="form-control" id="apellidoAdmin" name="apellidoAdmin" placeholder="Apellido" required />
                    <label for="apellidoAdmin">Apellido</label>
                </div>
            </div>

            <div class="form-floating mb-3">
                <input type="text" class="form-control" id="rutAdmin" name="rutAdmin" placeholder="12.345.678-9" required />
                <label for="rutAdmin">RUT Administrador</label>
            </div>

            <div class="form-floating mb-3">
                <input type="email" class="form-control" id="emailAdmin" name="emailAdmin" placeholder="correo@colegio.cl" required />
                <label for="emailAdmin">Correo Electrónico Institucional</label>
            </div>

            <div class="row g-2 mb-4">
                <div class="col-md-6 form-floating">
                    <input type="password" class="form-control" id="password" name="password" placeholder="Contraseña" required />
                    <label for="password">Contraseña</label>
                </div>
                <div class="col-md-6 form-floating">
                    <input type="password" class="form-control" id="confirmarPassword" name="confirmarPassword" placeholder="Confirmar Contraseña" required />
                    <label for="confirmarPassword">Confirmar Contraseña</label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 text-white rounded-pill mb-3">
                Registrar Establecimiento e Iniciar
            </button>

            <div class="text-center">
                <a asp-controller="Account" asp-action="Login" class="text-decoration-none small text-muted">
                    ← Volver al Iniciar Sesión
                </a>
            </div>
        </form>
    </div>

</body>
</html>
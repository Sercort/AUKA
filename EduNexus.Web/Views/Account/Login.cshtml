@{
    Layout = null; // Pantalla limpia sin barra superior
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - EduNexus</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            body {
                background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                padding: 20px 0;
            }

            .card-login {
                background: #ffffff;
                border-radius: 15px;
                box-shadow: 0 10px 25px rgba(0,0,0,0.2);
                padding: 40px;
                width: 100%;
                max-width: 420px;
            }

            .btn-primary-custom {
                background-color: #2a5298;
                border: none;
                padding: 12px;
                font-weight: 600;
            }

                .btn-primary-custom:hover {
                    background-color: #1e3c72;
                }
    </style>
</head>
<body>

    <div class="card-login text-center">
        <h2 class="fw-bold text-primary mb-2" style="color: #1e3c72 !important;">EduNexus</h2>
        <p class="text-muted mb-4">Plataforma de Gestión Escolar Integral</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success py-2 mb-3" role="alert">
                <small>@TempData["SuccessMessage"]</small>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-warning py-2 mb-3" role="alert">
                <small>⚠️ @TempData["Error"]</small>
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 mb-3" role="alert">
                <small>@ViewBag.Error</small>
            </div>
        }

        <form method="post" asp-action="Login">
            <div class="form-floating mb-3 text-start">
                <input type="email" class="form-control" id="email" name="email" placeholder="nombre@ejemplo.cl" required />
                <label for="email">Correo Electrónico</label>
            </div>

            <div class="form-floating mb-2 text-start">
                <input type="password" class="form-control" id="password" name="password" placeholder="Contraseña" required />
                <label for="password">Contraseña</label>
            </div>

            <div class="text-end mb-3">
                <a asp-action="OlvidoPassword" asp-controller="Account" class="text-decoration-none small text-muted">¿Olvidaste tu contraseña?</a>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 text-white rounded-pill mb-3">
                Ingresar a la Plataforma
            </button>
        </form>

        <!-- SEPARADOR -->
        <div class="position-relative my-3">
            <hr class="text-muted" />
            <span class="position-absolute top-50 start-50 translate-middle bg-white px-2 text-muted small">o</span>
        </div>

        <!-- BOTÓN GOOGLE SSO -->
        <a asp-action="GoogleLogin" asp-controller="Account" class="btn btn-outline-dark w-100 rounded-pill fw-semibold d-flex align-items-center justify-content-center gap-2 py-2 mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.55 10.78l7.98-6.19z" />
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
            </svg>
            Continuar con Google
        </a>

        <!-- SECCIÓN REGISTRO DE NUEVO COLEGIO -->
        <div class="border-top pt-3 mt-3">
            <p class="small text-muted mb-1">¿Tu establecimiento aún no usa EduNexus?</p>
            <a asp-controller="Account" asp-action="Registrar" class="fw-bold text-primary text-decoration-none small">
                🏫 Registrar un nuevo Colegio / Institución
            </a>
        </div>

        <!-- CUENTAS DEMO -->
        <div class="mt-3 text-muted small pt-2 border-top">
            <p class="mb-0 fw-semibold">Cuentas Demo para Probar:</p>
            <code>admin@edunexus.cl</code> | <code>director@edunexus.cl</code>
            <br />
            <small>Claves: <code>Admin123*</code> / <code>Director123*</code></small>
        </div>
    </div>
</body>
</html>